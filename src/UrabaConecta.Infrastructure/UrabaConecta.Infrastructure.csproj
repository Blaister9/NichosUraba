<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UrabaConecta.Application\UrabaConecta.Application.csproj" />
    <ProjectReference Include="..\UrabaConecta.Domain\UrabaConecta.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- ImageSharp 2.x conserva la licencia Apache-2.0; 3.x cambia a la Six Labors Split License. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <!-- AWSSDK.Core se fija explicitamente para evitar la version vulnerable GHSA-9cvc-h2w8-phrp. -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.100.9" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
