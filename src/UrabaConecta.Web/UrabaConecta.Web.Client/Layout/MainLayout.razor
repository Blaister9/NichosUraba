@inherits LayoutComponentBase

<header class="site-header">
    <a class="brand" href="/"><span>U</span> UrabáConecta</a>
    @* El logotipo ya lleva al directorio: repetirlo como enlace sólo restaba espacio en móvil.
       Y como no existe registro público, quien entra con sesión siempre viene a trabajar: su barra
       arranca por "Panel" y no comparte sitio con el seguimiento de un cliente. *@
    <nav aria-label="Navegación principal">
        <AuthorizeView>
            <Authorized><a href="/panel">Panel</a></Authorized>
            <NotAuthorized><a href="/seguimiento/citas">Mi reserva</a></NotAuthorized>
        </AuthorizeView>
        <AuthorizeView Roles="PlatformAdmin,PartnerOperator">
            <Authorized><a href="/admin/negocios">Negocios Fundadores</a></Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="PlatformAdmin">
            <Authorized><a href="/admin/accesos">Accesos</a><a href="/admin/salud">Salud</a></Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized><a href="/Account/Manage" target="_self">Cuenta</a></Authorized>
            <NotAuthorized><a href="/Account/Login" target="_self">Ingresar</a></NotAuthorized>
        </AuthorizeView>
    </nav>
</header>
<main class="page-shell">@Body</main>
<footer>
    <p><strong>UrabáConecta</strong> · Apartadó · Carepa · Chigorodó · Turbo</p>
    <p>Demostración con negocios y datos ficticios.</p>
    <nav aria-label="Información legal">
        <a href="/legal/politica-de-datos">Política de datos</a>
        <a href="/legal/aviso-de-privacidad">Aviso de privacidad</a>
        <a href="/legal/terminos">Términos y condiciones</a>
        <a href="/legal/retencion">Retención y eliminación</a>
        <a href="/legal/reclamos">Consultas y reclamos</a>
    </nav>
</footer>
<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado. <a href="." class="reload">Recargar</a><span class="dismiss">×</span>
</div>
