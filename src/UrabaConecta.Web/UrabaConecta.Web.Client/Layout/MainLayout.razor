@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

@* Dos navegaciones para un mismo producto, no una comprimida en la otra.

   En escritorio manda la barra superior. En móvil la barra superior se queda sólo con la marca y la
   identidad, y el recorrido se mueve abajo, al alcance del pulgar: Inicio, Explorar, Categorías y lo
   propio de cada quien. Antes había que conocer las direcciones o volver con el botón atrás, que es
   justamente lo que hace que algo se sienta una página suelta y no una aplicación. *@
<header class="site-header @(Ruta() == "/" ? "is-home" : null)">
    <a class="brand" href="/"><span aria-hidden="true">U</span> UrabáConecta</a>
    @* data-enhance-nav="false" en los destinos del armazón, igual que en los enlaces a negocios.
       La navegación mejorada compite con el arranque del circuito: si alguien toca un destino en los
       primeros milisegundos, el documento nuevo se pinta y después el circuito —que quedó enganchado
       al conjunto de componentes de la pantalla anterior— lo repinta encima, así que se acaba en la
       pantalla de la que se venía. Antes lo tapaba el buscador de la Home, que ya salía de la
       navegación mejorada; ahora salen los destinos, que es donde corresponde. *@
    <nav class="nav-escritorio" aria-label="Navegación principal">
        @foreach (var item in Publicas)
        {
            <a href="@item.Href" class="@(EsActiva(item.Href) ? "activo" : null)" data-enhance-nav="false"
               aria-current="@(EsActiva(item.Href) ? "page" : null)">@item.Label</a>
        }
    </nav>
    <a class="header-search" href="/explorar" data-enhance-nav="false" aria-label="Buscar negocios"><Icon Name="explorar" Size="22" /></a>
    <nav class="nav-identidad" aria-label="Tu cuenta">
        <AuthorizeView>
            <Authorized>
                <a class="solo-escritorio" href="/panel">Panel</a>
                <a href="/Account/Manage" target="_self" class="boton-identidad">
                    <Icon Name="cuenta" Size="22" /><span class="solo-escritorio">Cuenta</span>
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="solo-escritorio" href="/para-negocios">Para negocios</a>
                <a href="/Account/Login" target="_self" class="boton-identidad">
                    <Icon Name="cuenta" Size="22" /><span class="solo-escritorio">Ingresar</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main class="page-shell">@Body</main>

<footer class="@(Ruta() == "/" ? "footer-home" : null)">
    <p><strong>UrabáConecta</strong> · Apartadó · Carepa · Chigorodó · Turbo</p>
    @* El aviso se escribe siempre y lo muestra el CSS sólo en los ambientes de demostración: la
       marca del ambiente la pone el servidor en <body>, así que la línea no puede quedarse pegada
       en Production, donde los negocios y las citas son reales. *@
    <p class="aviso-demostracion">Demostración con negocios y datos ficticios.</p>
    <nav aria-label="Información legal">
        <a href="/legal/politica-de-datos">Política de datos</a>
        <a href="/legal/aviso-de-privacidad">Aviso de privacidad</a>
        <a href="/legal/terminos">Términos y condiciones</a>
        <a href="/legal/retencion">Retención y eliminación</a>
        <a href="/legal/reclamos">Consultas y reclamos</a>
    </nav>
</footer>

@* La barra inferior sólo existe en móvil. Se marca con aria-current para que un lector de pantalla
   anuncie dónde está quien navega, no sólo qué puede tocar. *@
<nav class="nav-inferior" aria-label="Navegación">
    @foreach (var item in Moviles)
    {
        <a href="@item.Href" class="@(EsActivaMovil(item) ? "activo" : null)" data-enhance-nav="false"
           aria-current="@(EsActivaMovil(item) ? "page" : null)">
            <Icon Name="@item.Icono" Size="22" /><span>@item.Label</span>
        </a>
    }
    <AuthorizeView>
        <Authorized>
            <a href="/panel" class="@(EsActiva("/panel") ? "activo" : null)"
               aria-current="@(EsActiva("/panel") ? "page" : null)">
                <Icon Name="actividad" Size="22" /><span>Mi actividad</span>
            </a>
        </Authorized>
        <NotAuthorized>
            <a href="/seguimiento" class="@(EsActiva("/seguimiento") ? "activo" : null)"
               aria-current="@(EsActiva("/seguimiento") ? "page" : null)">
                <Icon Name="actividad" Size="22" /><span>Mi actividad</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado. <a href="." class="reload">Recargar</a><span class="dismiss">×</span>
</div>

@code {
    /// <param name="Tambien">
    /// Rutas que pertenecen a este destino aunque no cuelguen de su dirección. La ficha de un
    /// negocio vive en /negocios pero se llega a ella explorando: dejar la barra apagada allí haría
    /// perder el hilo justo en la pantalla donde se decide reservar.
    /// </param>
    private sealed record Destino(string Href, string Label, string Icono, string[]? Tambien = null);

    private static readonly Destino[] Publicas =
    [
        new("/", "Ahora", "inicio"),
        new("/explorar", "Buscar", "explorar", ["/negocios", "/categorias", "/municipios"]),
    ];

    private static readonly Destino[] Moviles =
    [
        new("/", "Ahora", "inicio"),
        new("/explorar", "Buscar", "explorar", ["/negocios", "/categorias", "/municipios"]),
    ];

    protected override void OnInitialized() => Nav.LocationChanged += AlNavegar;

    private void AlNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => StateHasChanged();

    /// <summary>
    /// La raíz sólo se marca en la raíz exacta; el resto cubre además sus subrutas y las rutas que
    /// se le hayan adscrito. Sin la comparación exacta para "/", Inicio quedaba encendido en todas
    /// las pantallas y la barra dejaba de informar nada.
    /// </summary>
    private bool EsActiva(string href)
    {
        var actual = Ruta();
        if (href == "/") return actual == "/";
        if (Cubre(href, actual)) return true;
        return Publicas.FirstOrDefault(x => x.Href == href)?.Tambien?.Any(p => Cubre(p, actual)) == true;
    }

    private bool EsActivaMovil(Destino item)
    {
        var actual = Ruta();
        if (item.Href == "/") return actual == "/";
        return Cubre(item.Href, actual) || item.Tambien?.Any(p => Cubre(p, actual)) == true;
    }

    private string Ruta()
        => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].TrimEnd('/');

    private static bool Cubre(string prefijo, string actual)
        => actual == prefijo || actual.StartsWith(prefijo + "/", StringComparison.OrdinalIgnoreCase);

    public void Dispose() => Nav.LocationChanged -= AlNavegar;
}
