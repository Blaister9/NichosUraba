@implements IAsyncDisposable
@inject IJSRuntime JS

@* Invitación propia a instalar. Es una pieza en el flujo, no una ventana emergente. Cuando el
   navegador ofrece su diálogo, el botón lo abre; cuando sólo hay un camino manual conocido, se
   muestra una instrucción corta sin prometer una instalación automática.

   El botón nativo no lleva un manejador de Blazor: quien atiende ese clic es pwa.js, dentro del evento
   del DOM, porque Chrome exige que el diálogo se pida dentro del gesto de la persona y un viaje
   al circuito de Blazor puede llegar tarde. *@
@if (Visible)
{
    <aside class="install-invite @(Destacada ? "is-destacada" : null)" data-testid="install-invite"
           data-modo="@estado!.Mode" data-plataforma="@estado.Platform" aria-live="polite">
        <span class="install-invite-icono" aria-hidden="true"><Icon Name="instalar" Size="22" /></span>
        <div class="install-invite-copy">
            <strong>@Titulo</strong>
            <p>@Descripcion</p>

            @if (ContextoPlataforma is { } contexto)
            {
                <small class="install-invite-plataforma">@contexto</small>
            }

            <div class="install-invite-acciones">
                @if (estado.Mode == "pending")
                {
                    <span class="install-pending" role="status" data-testid="install-pending">
                        Terminando la instalación…
                    </span>
                }
                else if (estado.Mode == "native")
                {
                    <button type="button" class="primary" data-uraba-instalar="true"
                            data-testid="install-native">Instalar</button>
                }
                else
                {
                    <button type="button" class="@(Destacada ? "primary" : "secondary")"
                            aria-expanded="@pasosVisibles" aria-controls="@idPasos"
                            @onclick="() => pasosVisibles = !pasosVisibles" data-testid="install-manual">
                        @(pasosVisibles ? "Ocultar los pasos" : "Cómo instalarla")
                    </button>
                }
                @* Mientras el navegador termina, "Ahora no" estorba: la persona ya aceptó. Se
                   esconde durante ese momento y no más: pwa.js espera appinstalled una ventana
                   acotada y, si no llega, suelta el pendiente por su cuenta. El modo vuelve
                   entonces a "manual" y esta salida reaparece sin recargar nada. *@
                @if (Descartable && estado.Mode != "pending")
                {
                    <button type="button" class="inline-button" data-uraba-descartar-instalacion="true"
                            @onclick="Descartar"
                            data-testid="install-dismiss">Ahora no</button>
                }
            </div>

            @if (pasosVisibles && estado.Steps.Count > 0)
            {
                <ol class="install-pasos" id="@idPasos" data-testid="install-steps">
                    @foreach (var paso in estado.Steps) { <li>@paso</li> }
                </ol>
            }
        </div>
    </aside>
}

@code {
    [Parameter] public string Titulo { get; set; } = "Lleva UrabáConecta contigo";

    [Parameter] public string Descripcion { get; set; } =
        "Instálala y entra más rápido a tus citas, pedidos y negocios.";

    /// <summary>Presencia de propietario: la instalación es su herramienta de trabajo, no un extra.</summary>
    [Parameter] public bool Destacada { get; set; }

    /// <summary>Para el cliente sí; para quien opera un negocio la invitación se queda.</summary>
    [Parameter] public bool Descartable { get; set; } = true;

    private readonly string clave = Guid.NewGuid().ToString("N");
    private string idPasos => $"pasos-instalar-{clave}";
    private DotNetObjectReference<InstallPrompt>? referencia;
    private AppInstallState? estado;
    private bool pasosVisibles;

    /// <summary>Si se llegó a registrar la escucha. Manda al darse de baja; ver DisposeAsync.</summary>
    private bool observando;

    /// <summary>
    /// Nunca durante el prerender —ahí no se sabe nada del navegador— ni cuando ya está instalada,
    /// ni cuando este navegador no puede instalar: una invitación que no lleva a ninguna parte es
    /// peor que no invitar.
    /// </summary>
    private bool Visible => estado is { CanOffer: true, Ready: true }
                            && !(Descartable && estado.Dismissed);

    private string? ContextoPlataforma => estado?.Platform switch
    {
        "ios" => "En iOS se añade desde Compartir.",
        "desktop" when estado.Mode == "manual" => "También puedes instalarla desde el menú del navegador.",
        _ => null
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        referencia = DotNetObjectReference.Create(this);
        try
        {
            estado = await JS.InvokeAsync<AppInstallState>("urabaApp.install.watch", clave, referencia);
            pasosVisibles = estado is { Mode: "manual", Platform: "ios" };
            observando = true;
            StateHasChanged();
        }
        catch (JSException) { }
    }

    /// <summary>
    /// El navegador puede ceder su diálogo mucho después de que esta pantalla se pintara, y también
    /// puede instalarse desde el menú sin tocar nuestro botón. Las dos cosas llegan por aquí.
    /// </summary>
    [JSInvokable]
    public Task EstadoDeInstalacionCambio(AppInstallState nuevo)
    {
        // Si el diálogo no pudo abrirse pero el dispositivo tiene un camino manual conocido, se
        // muestra esa única alternativa sin requerir otro toque.
        if (nuevo is { Mode: "manual", Platform: "ios", Dismissed: false }) pasosVisibles = true;
        else if (estado is { Mode: "native" } && nuevo.Mode == "manual") pasosVisibles = true;
        else if (!nuevo.CanOffer) pasosVisibles = false;
        estado = nuevo;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task Descartar()
    {
        pasosVisibles = false;
        try { await JS.InvokeVoidAsync("urabaApp.install.dismiss"); }
        catch (JSException) { }
        // La invitación sólo desaparece después de intentar persistir la decisión. Así una
        // navegación inmediata no puede adelantarse al localStorage y volver a mostrarla.
        estado = estado is null ? null : estado with { Dismissed = true };
    }

    /// <summary>
    /// Sólo se da de baja quien llegó a inscribirse. En un render estático —el prerender de la
    /// página, o esta misma pantalla pedida sin circuito— OnAfterRenderAsync no corre, pero el
    /// componente sí se desecha: pedir JavaScript ahí lanza dentro del propio Dispose y rompe la
    /// respuesta HTTP a medio escribir, con la página ya empezada a enviar.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (observando)
        {
            try { await JS.InvokeVoidAsync("urabaApp.install.unwatch", clave); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            catch (OperationCanceledException) { }
        }
        referencia?.Dispose();
    }
}
