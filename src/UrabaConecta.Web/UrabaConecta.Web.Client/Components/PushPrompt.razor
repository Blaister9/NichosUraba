@inject IJSRuntime JS

@* Los avisos se piden cuando hay un motivo —un turno tomado, una reserva, un pedido, un negocio
   seguido— y nunca al cargar la página. El orden importa: primero se dice qué vamos a avisar, y
   sólo si la persona toca el botón aparece el diálogo del navegador. Un permiso pedido antes de
   explicar nada se rechaza una vez y queda rechazado para siempre.

   Rechazarlo no rompe nada: la operación siguió su curso antes de llegar aquí y las pantallas de
   seguimiento se actualizan solas. Por eso el estado bloqueado se cuenta una vez, sin botón que
   vuelva a insistir. *@
@if (available)
{
    <aside class="push-prompt @(Compact ? "is-compact" : null)" data-testid="push-prompt">
        <div class="push-prompt-icon" aria-hidden="true">●</div>
        <div class="push-prompt-copy">
            <strong>@Title</strong>
            <p>@(active ? ActiveDescription : Description)</p>
            @if (permission == "denied")
            {
                <p class="meta" data-testid="push-blocked">
                    Los avisos están bloqueados en este navegador. @DeniedNote
                </p>
            }
            else
            {
                <button type="button" class="@(active ? "inline-button" : "secondary")"
                        disabled="@busy" @onclick="Toggle" data-testid="push-toggle">
                    @(busy ? "Guardando…" : active ? "Desactivar avisos" : ButtonLabel)
                </button>
            }
            @if (error is not null) { <p class="error" role="alert">@error</p> }
        </div>
    </aside>
}

@code {
    [Parameter, EditorRequired] public string RegistrationPath { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Mantente al día";
    [Parameter] public string Description { get; set; } = "Recibe una alerta útil aunque no tengas UrabáConecta abierto.";
    [Parameter] public string ActiveDescription { get; set; } = "Los avisos están activos en este dispositivo.";
    [Parameter] public string ButtonLabel { get; set; } = "Activar avisos en este dispositivo";

    /// <summary>
    /// Qué sigue funcionando sin avisos. Se dice en el propio contexto porque la respuesta cambia:
    /// un turno se sigue viendo en pantalla, un pedido se sigue recogiendo igual.
    /// </summary>
    [Parameter] public string DeniedNote { get; set; } =
        "Puedes permitirlos desde los ajustes del navegador; mientras tanto nada deja de funcionar.";

    [Parameter] public bool Compact { get; set; }
    private bool available, active, busy;
    private string permission = "default";
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var state = await JS.InvokeAsync<PushState>("urabaPush.availability", RegistrationPath);
            available = state.Supported && state.Configured;
            permission = state.Permission;
            active = state.Active;
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task Toggle()
    {
        busy = true; error = null;
        try
        {
            var state = active
                ? await JS.InvokeAsync<PushState>("urabaPush.unsubscribe", RegistrationPath)
                : await JS.InvokeAsync<PushState>("urabaPush.subscribe", RegistrationPath);
            active = state.Active; permission = state.Permission;
        }
        catch (JSException ex) { error = ex.Message.Contains("avisos", StringComparison.OrdinalIgnoreCase)
            ? ex.Message : "No pudimos cambiar los avisos. Intenta nuevamente."; }
        finally { busy = false; }
    }

    private sealed class PushState
    {
        public bool Supported { get; set; }
        public bool Configured { get; set; }
        public bool Active { get; set; }
        public string Permission { get; set; } = "default";
    }
}
