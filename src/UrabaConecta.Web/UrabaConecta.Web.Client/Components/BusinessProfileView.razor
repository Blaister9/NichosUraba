@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IUrabaConectaApi Api

@* Ficha pública reutilizable: la usan el directorio y la vista previa administrativa.

   Es la superficie que un negocio va a enseñar como suya, así que se lee como su mini-web: portada,
   identidad, una acción dominante y después el detalle. Quien llega por un enlace directo tiene que
   pensar "ésta es la página de este negocio", no "estoy dentro de un sistema". *@

@* La portada va envuelta, igual que la fotografía del feed: el velo tiene que medir lo que mide la
   imagen, no lo que mide la sección entera. Sin la envoltura, el degradado se calculaba sobre todo
   el bloque —foto, nombre, descripción y botones— y acababa oscureciendo lo que ya estaba oscuro
   mientras el nombre caía sobre la parte clara de la foto, ilegible. *@
<section class="ficha-hero" data-tono="@CategoryLook.Tone(Profile.Category.Slug)">
    <div class="profile-media">
        @if (Cover is not null)
        {
            <img class="profile-cover" src="@Cover.Url" alt="@(Cover.AltText ?? $"Portada de {Profile.Name}")"
                 width="@Cover.Width" height="@Cover.Height" fetchpriority="high" />
        }
        else
        {
            @* Un negocio sin portada conserva la forma de la ficha en vez de empezar con el título
               pegado al encabezado: la mini-web sigue pareciendo una mini-web. *@
            <div class="profile-cover cover-vacia" aria-hidden="true">
                <Icon Name="@CategoryLook.Icon(Profile.Category.Slug)" Size="64" />
            </div>
        }
        <span class="profile-shade" aria-hidden="true"></span>
    </div>
    <div class="profile-head">
        <div class="profile-identity">
            @if (Logo is not null)
            {
                <img class="profile-logo" src="@Logo.Url" alt="@(Logo.AltText ?? $"Logo de {Profile.Name}")"
                     width="@Logo.Width" height="@Logo.Height" />
            }
            <div>
                <p class="ficha-meta">
                    <span class="tag">@Profile.Category.Name</span>
                    @if (Profile.OpenStatus is { Length: > 0 })
                    {
                        <span class="@(EstaAbierto ? "abierto" : "cerrado")">@EstadoTexto</span>
                    }
                </p>
                <h1>@Profile.Name</h1>
                <p class="meta">@Fulfillment.PublicPlace</p>
            </div>
        </div>

        @if (Presentacion is { Length: > 0 } presentacion) { <p class="lead">@presentacion</p> }

        @if (!Profile.IsPreview)
        {
            <div class="ficha-acciones">
                <a class="button-link cta-principal" href="@AccionUrl">@AccionTexto</a>
                @if (!string.IsNullOrWhiteSpace(Profile.WhatsAppUrl))
                {
                    <a class="button-link secondary" href="@Profile.WhatsAppUrl"
                       rel="noopener noreferrer nofollow">Escribir por WhatsApp</a>
                }
                @if (!string.IsNullOrWhiteSpace(Profile.PublicPhone))
                {
                    <a class="button-link secondary" href="tel:@Profile.PublicPhone">Llamar</a>
                }
                @if (!string.IsNullOrWhiteSpace(Profile.LocationUrl))
                {
                    <a class="button-link secondary" href="@Profile.LocationUrl"
                       rel="noopener noreferrer nofollow">Cómo llegar</a>
                }
                <button type="button" class="secondary" @onclick="Compartir">
                    <Icon Name="compartir" Size="16" /> Compartir
                </button>
            </div>
            @if (avisoCompartir is { Length: > 0 })
            {
                <p class="success" role="status">@avisoCompartir</p>
            }
        }
        @if (!string.IsNullOrWhiteSpace(Profile.ReferencePoint))
        {
            <p class="ficha-direccion">@Profile.ReferencePoint</p>
        }
    </div>
</section>

@if (!Profile.IsPreview)
{
    <section class="follow-business" aria-label="Promociones de este negocio">
        <PushPrompt RegistrationPath="@($"/api/v1/public/businesses/{Profile.Slug}/followers/push-subscriptions")"
            Title="¿Quieres volver por aquí?"
            Description="Sigue este negocio para recibir únicamente sus promociones."
            ActiveDescription="Sigues este negocio en este dispositivo."
            ButtonLabel="Seguir negocio" Compact="true" />
    </section>
}

@if (!string.IsNullOrWhiteSpace(Profile.CustomerInstructions))
{
    <section class="notice"><h2>@CustomerInstructionsHeading</h2><p>@Profile.CustomerInstructions</p></section>
}

@* Servicios y productos comparten anatomía: foto, nombre, detalle, precio y una acción. Quien ya
   entendió una lista no debería tener que aprender la otra. *@
@if (Profile.Services.Count > 0)
{
    <section class="bloque" data-tono="@CategoryLook.Tone(Profile.Category.Slug)">
        <h2>Servicios</h2>
        <div class="catalogo">
            @foreach (var service in Profile.Services)
            {
                <article class="catalogo-item">
                    @if (service.ImageUrl is { Length: > 0 } foto)
                    {
                        <img class="catalogo-foto" src="@foto" width="184" height="184" loading="lazy"
                             alt="@(service.ImageAltText ?? $"{service.Name} en {Profile.Name}")" />
                    }
                    else
                    {
                        <span class="catalogo-foto sin-foto"><Icon Name="@CategoryLook.Icon(Profile.Category.Slug)" Size="28" /></span>
                    }
                    <div class="catalogo-cuerpo">
                        <h3>@service.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(service.Description)) { <p>@service.Description</p> }
                        <p class="catalogo-datos">
                            <span class="duracion"><Icon Name="reloj" Size="16" /> @Duracion(service.DurationMinutes)</span>
                            @if (service.RequiresDeposit) { <span>Requiere adelanto</span> }
                        </p>
                    </div>
                    <div class="catalogo-accion">
                        <span class="precio">@service.ReferencePrice.ToString("C0", Colombia)</span>
                        @if (!Profile.IsPreview && !Profile.HasVirtualQueue && !Profile.HasPickupOrdering)
                        {
                            <a class="button-link secondary" href="/negocios/@Profile.Slug/citas?serviceId=@service.Id">Reservar</a>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Profile.HasVirtualQueue)
{
    <section class="queue-promo live-queue"><div>
        <p class="eyebrow">Fila / turno virtual</p>
        <h2>Atención por orden de llegada</h2>
        <p>Toma tu turno desde el celular y llega cuando falte poco. No necesitas crear una cuenta.</p>
        @if (!Profile.IsPreview) { <a class="button-link btn-grande" href="/negocios/@Profile.Slug/turnos">Tomar turno</a> }
        </div>
        @if (queueStatus is not null)
        {
            <dl class="queue-promo-metrics" aria-label="Estado actual de la fila">
                <div><dt>Fila</dt><dd class="fila-estado" data-estado="@queueStatus.SessionStatus.ToLowerInvariant()">@QueueState</dd></div>
                <div><dt>Esperando</dt><dd>@queueStatus.WaitingCount</dd></div>
                <div><dt>Tiempo estimado</dt><dd>@queueStatus.ApproximateWaitMinutes min</dd></div>
            </dl>
        }
    </section>
}

@if (Profile.HasPickupOrdering)
{
    <section class="bloque" data-tono="@CategoryLook.Tone(Profile.Category.Slug)">
        <div class="seccion-head">
            <div>
                <h2>@Fulfillment.SectionTitle</h2>
                <p>@Fulfillment.SectionDescription</p>
            </div>
            @if (!Profile.IsPreview && Productos.Count > 0) { <a href="/negocios/@Profile.Slug/pedidos">Ver todo</a> }
        </div>
        @if (Productos.Count > 0)
        {
            <div class="catalogo">
                @foreach (var producto in Productos)
                {
                    <article class="catalogo-item">
                        @if (producto.ImageUrl is { Length: > 0 } foto)
                        {
                            <img class="catalogo-foto" src="@foto" width="184" height="184" loading="lazy"
                                 alt="@(producto.ImageAltText ?? $"{producto.Name} en {Profile.Name}")" />
                        }
                        else
                        {
                            <span class="catalogo-foto sin-foto"><Icon Name="bolsa" Size="28" /></span>
                        }
                        <div class="catalogo-cuerpo">
                            <h3>@producto.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(producto.Description)) { <p>@producto.Description</p> }
                        </div>
                        <div class="catalogo-accion">
                            <span class="precio">@producto.ReferencePrice.ToString("C0", Colombia)</span>
                            @if (!Profile.IsPreview)
                            {
                                @if (producto.IsAvailable)
                                {
                                    <a class="button-link secondary" href="/negocios/@Profile.Slug/pedidos#producto-@producto.Id">Agregar</a>
                                }
                                else
                                {
                                    <span class="stock-status">No disponible</span>
                                    <PushPrompt RegistrationPath="@($"/api/v1/public/businesses/{Profile.Slug}/products/{producto.Id}/push-subscriptions")"
                                        Title="¿Lo estabas buscando?" Description="Te avisamos cuando vuelva."
                                        ActiveDescription="Tu aviso está activo." ButtonLabel="Avísame cuando vuelva" Compact="true" />
                                }
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else if (!Profile.IsPreview)
        {
            <a class="button-link" href="/negocios/@Profile.Slug/pedidos">Ver menú</a>
        }
    </section>
}

@if (Gallery.Count > 0)
{
    <section class="bloque"><h2>Fotografías</h2><div class="galeria">
        @foreach (var image in Gallery)
        {
            <img class="gallery-photo" src="@image.Url" alt="@(image.AltText ?? $"Fotografía de {Profile.Name}")"
                 width="@image.Width" height="@image.Height" loading="lazy" />
        }
    </div></section>
}

<section class="hours"><h2>Horario</h2>
    @if (Profile.Hours.Count == 0) { <p>Este establecimiento aún no publicó su horario.</p> }
    else
    {
        @* Un día puede tener varios tramos: se agrupan bajo una sola etiqueta para que una
           jornada partida se lea como tal y no como dos días repetidos. *@
        @foreach (var day in Semana)
        {
            var tramos = Profile.Hours.Where(x => x.Day == day)
                .OrderBy(x => x.OpensAt, StringComparer.Ordinal).ToList();
            <p data-testid="hour-line"><span>@Day(day)</span>
                @if (tramos.Count == 0) { <strong>Cerrado</strong> }
                else
                {
                    <strong>@string.Join(" · ", tramos.Select(x => $"{Hora(x.OpensAt)}–{Hora(x.ClosesAt)}"))</strong>
                }
            </p>
        }
    }
</section>

<section class="contact-block"><h2>Contacto</h2>
    <ul class="contacto-lista">
        @if (Fulfillment.ShowStreetAddress)
        { <li><dfn>Dirección</dfn><span>@Fulfillment.PublicPlace</span></li> }
        else
        { <li><dfn>Municipio</dfn><span>@Profile.Municipality.Name</span></li> }
        @if (!string.IsNullOrWhiteSpace(Profile.PublicPhone))
        { <li><dfn>Teléfono</dfn><a href="tel:@Profile.PublicPhone">@Profile.PublicPhone</a></li> }
        @if (!string.IsNullOrWhiteSpace(Profile.PublicEmail))
        { <li><dfn>Correo</dfn><a href="mailto:@Profile.PublicEmail">@Profile.PublicEmail</a></li> }
        @if (!string.IsNullOrWhiteSpace(Profile.WhatsAppUrl))
        { <li><dfn>WhatsApp</dfn><a href="@Profile.WhatsAppUrl" rel="noopener noreferrer nofollow">Escribir por WhatsApp</a></li> }
        @if (!string.IsNullOrWhiteSpace(Profile.InstagramUrl))
        { <li><dfn>Instagram</dfn><a href="@Profile.InstagramUrl" rel="noopener noreferrer nofollow">Ver perfil</a></li> }
        @if (!string.IsNullOrWhiteSpace(Profile.FacebookUrl))
        { <li><dfn>Facebook</dfn><a href="@Profile.FacebookUrl" rel="noopener noreferrer nofollow">Ver página</a></li> }
        @if (!string.IsNullOrWhiteSpace(Profile.LocationUrl))
        { <li><dfn>Ubicación</dfn><a href="@Profile.LocationUrl" rel="noopener noreferrer nofollow">Cómo llegar</a></li> }
    </ul>
</section>

@* En móvil la acción dominante acompaña al visitante hasta el final de la ficha: si tiene que
   volver a subir para reservar, no vuelve. *@
@if (!Profile.IsPreview)
{
    <div class="ficha-sticky">
        <a class="button-link" href="@AccionUrl">@AccionTexto</a>
    </div>
}

@code {
    [Parameter, EditorRequired] public BusinessProfileDto Profile { get; set; } = default!;

    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");

    private IJSObjectReference? modulo;
    private string? avisoCompartir;
    private QueuePublicStatusDto? queueStatus;

    protected override async Task OnParametersSetAsync()
    {
        queueStatus = null;
        if (!Profile.IsPreview && Profile.HasVirtualQueue)
        {
            try { queueStatus = await Api.GetPublicQueueAsync(Profile.Slug); }
            catch (ApiException) { /* La ficha sigue útil y el botón abre el estado detallado. */ }
        }
    }

    /// <summary>
    /// El módulo se carga al primer uso y no al montar: la mayoría de las visitas no comparten, y
    /// descargarlo siempre sería pagar por todas el gesto de unas pocas.
    /// </summary>
    private async Task Compartir()
    {
        try
        {
            modulo ??= await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/BusinessProfileView.razor.js");
            var resultado = await modulo.InvokeAsync<string>("compartir",
                Profile.Name, Presentacion, Nav.Uri);
            avisoCompartir = resultado switch
            {
                "copiado" => "Copiamos el enlace. Ya puedes pegarlo donde quieras.",
                "sin-soporte" => "Copia la dirección desde la barra del navegador.",
                _ => null
            };
        }
        catch (JSException)
        {
            // Compartir es accesorio: si el navegador lo impide, la ficha sigue sirviendo entera.
            avisoCompartir = "Copia la dirección desde la barra del navegador.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Al navegar el circuito puede haberse cerrado ya; soltar el módulo entonces lanza, y eso
        // no debe convertirse en un error visible cuando la persona simplemente cambió de página.
        if (modulo is null) return;
        try { await modulo.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private IReadOnlyList<BusinessImageDto> Images => Profile.Images ?? [];
    private BusinessImageDto? Logo => Images.FirstOrDefault(x => x.Kind == "Logo");
    private BusinessImageDto? Cover => Images.FirstOrDefault(x => x.Kind == "Cover");
    private IReadOnlyList<BusinessImageDto> Gallery
        => Images.Where(x => x.Kind == "Gallery").OrderBy(x => x.DisplayOrder).ToList();
    private IReadOnlyList<ProductDto> Productos => Profile.Products ?? [];

    /// <summary>
    /// "90 minutos" se lee peor que "1 h 30 min" en una tarjeta estrecha, y por encima de dos horas
    /// el número en minutos deja de significar nada a simple vista.
    /// </summary>
    private static string Duracion(int minutos) => minutos < 60
        ? $"{minutos} min"
        : minutos % 60 == 0 ? $"{minutos / 60} h" : $"{minutos / 60} h {minutos % 60} min";

    /// <summary>
    /// Muchos negocios escriben el municipio dentro de la dirección. Añadirlo otra vez dejaba
    /// "Calle 100 # 00-00, Apartadó, Apartadó" en la ficha.
    /// </summary>
    private PublicOrderFulfillmentCopy Fulfillment => PublicOrderFulfillmentSemantics.For(
        Profile.OrderFulfillmentMode, Profile.LocationMode, Profile.Address, Profile.Municipality.Name);

    private string CustomerInstructionsHeading => Profile.HasPickupOrdering
        ? Fulfillment.CustomerInstructionsHeading : "Antes de venir";

    /// <summary>El estado ya viene resuelto por el servidor; aquí sólo se decide cómo se pinta.</summary>
    private bool EstaAbierto => Profile.OpenStatus?.StartsWith("Abierto", StringComparison.OrdinalIgnoreCase) == true;

    /// <summary>
    /// "Abierto" y "Cerrado" a secas se leen mejor con el "ahora". El estado largo —"Cerrado
    /// temporalmente · abre a las 8:00 a. m."— ya dice cuándo, y añadírselo lo dejaba en
    /// "…abre a las 8:00 a. m. ahora".
    /// </summary>
    private string EstadoTexto => Profile.OpenStatus is "Abierto" or "Cerrado"
        ? $"{Profile.OpenStatus} ahora" : Profile.OpenStatus ?? "";

    /// <summary>
    /// Muchos negocios repiten la descripción corta en la larga. Mostrar las dos deja la ficha
    /// diciendo lo mismo dos veces, que es exactamente lo que no queremos que vea un cliente.
    /// </summary>
    private string Presentacion
    {
        get
        {
            var corta = Profile.ShortDescription?.Trim() ?? "";
            var larga = Profile.Description?.Trim() ?? "";
            if (corta.Length == 0) return larga;
            if (larga.Length == 0 || larga.Equals(corta, StringComparison.OrdinalIgnoreCase)) return corta;
            return larga.Length > corta.Length ? larga : corta;
        }
    }

    /// <summary>
    /// La acción dominante del negocio, con la misma precedencia que usa el directorio para que la
    /// tarjeta y la ficha nunca prometan cosas distintas.
    /// </summary>
    private string AccionUrl => Profile.HasPickupOrdering ? $"/negocios/{Profile.Slug}/pedidos"
        : Profile.HasVirtualQueue ? $"/negocios/{Profile.Slug}/turnos"
        : Profile.Services.Count > 0 ? $"/negocios/{Profile.Slug}/citas"
        : $"tel:{Profile.PublicPhone}";

    private string AccionTexto => Profile.HasPickupOrdering ? Fulfillment.PrimaryAction
        : Profile.HasVirtualQueue ? "Tomar turno"
        : Profile.Services.Count > 0 ? "Reservar cita"
        : "Llamar al negocio";

    private string QueueState => queueStatus?.SessionStatus switch
    {
        "Open" => "Abierta ahora",
        "Paused" => "Pausada",
        _ => "Cerrada"
    };

    private static string Day(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Lunes", DayOfWeek.Tuesday => "Martes", DayOfWeek.Wednesday => "Miércoles",
        DayOfWeek.Thursday => "Jueves", DayOfWeek.Friday => "Viernes", DayOfWeek.Saturday => "Sábado",
        _ => "Domingo"
    };

    /// <summary>La semana empieza en lunes, como se lee un horario colgado en la puerta.</summary>
    private static readonly DayOfWeek[] Semana =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    /// <summary>"14:00" se muestra como "2:00 p. m.", que es como se dice la hora aquí.</summary>
    private static string Hora(string value)
        => TimeOnly.TryParse(value, out var hora) ? hora.ToString("h:mm tt", Colombia) : value;
}
