@page "/admin/negocios/{BusinessId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PlatformAdmin,PartnerOperator")]
@using Microsoft.AspNetCore.Components.Forms
@inject IUrabaConectaApi Api
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Preparación del negocio | UrabáConecta</PageTitle>
@if (business is null) { <p class="notice">Cargando…</p> }
else
{
    @* La socia llega aquí desde su panel a continuar un negocio; necesita la vuelta explícita. *@
    <a class="back-link" href="/panel" data-enhance-nav="false">← Mis negocios</a>
    <p class="eyebrow">Preparación del negocio</p>
    <div class="title-actions"><h1 data-testid="ficha-nombre">@business.Name</h1>
        <span class="status @BusinessStatusText.CssModifier(business.Status)"
              data-testid="ficha-estado">@StatusLabel(business.Status)</span></div>
    @if (business.Status == "Suspended")
    {
        <div class="notice"><strong>Negocio suspendido.</strong> No aparece en el directorio ni recibe operaciones públicas nuevas. El historial permanece disponible.</div>
    }
    @if (business.Status == "Archived")
    {
        <div class="notice"><strong>Negocio archivado.</strong> Solo lectura administrativa.</div>
    }
    @if (business.ReviewNotes is { Length: > 0 } notes)
    {
        <div class="notice"><strong>Observaciones de la revisión:</strong> @notes</div>
    }
    @if (!interactiveReady) { <p class="notice" role="status">Activando controles del negocio…</p> }
    @if (busy) { <p class="notice" role="status" data-testid="ficha-guardando">Guardando…</p> }
    <fieldset disabled="@(!interactiveReady || busy)">

    <section class="panel-card">
        <h2>Avance de la configuración</h2>
        <progress value="@business.CompletionPercentage" max="100"
                  aria-label="Avance de la configuración"></progress>
        <p><strong>@business.CompletionPercentage %</strong> completo</p>
        @foreach (var item in business.Readiness.Where(x => x.IsApplicable))
        {
            <p class="checklist-item">
                <span aria-hidden="true">@(item.IsComplete ? "✓" : "○")</span> @item.Label
                @if (!item.IsComplete && item.MissingHint is { Length: > 0 } hint) { <em> — @hint</em> }
            </p>
        }
        <p class="@(business.IsReady ? "success" : "notice")">
            <strong>@(business.IsReady ? "Listo para enviar a revisión" : "Faltan requisitos")</strong>
        </p>
    </section>

    <div class="two-columns">
        <section class="panel-card"><h2>Perfil comercial</h2>
            <label>Nombre<input @bind="profile.Name" /></label>
            <label>Identificador público<input @bind="profile.Slug" /></label>
            @if (catalog is not null)
            {
                <label>Municipio<select @bind="profile.MunicipalityId">@foreach (var x in catalog.Municipalities) { <option value="@x.Id">@x.Name</option> }</select></label>
                <label>Categoría<select @bind="profile.CategoryId">@foreach (var x in catalog.Categories) { <option value="@x.Id">@x.Name</option> }</select></label>
            }
            <label>Descripción breve (máx. 160)<input @bind="profile.ShortDescription" maxlength="160" /></label>
            <label>Descripción completa<textarea @bind="profile.Description"></textarea></label>
            <label>Instrucciones para clientes<textarea @bind="profile.CustomerInstructions"></textarea></label>
            <button class="secondary" @onclick="SaveProfile" disabled="@readOnly">Guardar perfil</button>
        </section>

        <section class="panel-card"><h2>Contacto y ubicación</h2>
            <label>Tipo de ubicación<select @bind="profile.LocationMode">
                <option value="PublicPhysical">Física pública</option>
                <option value="PrivatePhysical">Física privada u oculta</option>
                <option value="Virtual">Virtual</option>
            </select></label>
            <label>Modalidad de pedidos<select @bind="profile.OrderFulfillmentMode">
                <option value="PickupAtPublicLocation">Recogida en ubicación pública</option>
                <option value="Coordinated">Entrega o recogida coordinada</option>
                <option value="ExternalDelivery">Entrega externa</option>
            </select></label>
            <label>Dirección<input @bind="profile.Address" /></label>
            <label>Punto de referencia<input @bind="profile.ReferencePoint" /></label>
            <label>Teléfono público<input @bind="profile.PublicPhone" /></label>
            <label>Enlace de WhatsApp<input @bind="profile.WhatsAppUrl" placeholder="https://wa.me/57…" /></label>
            <label>Correo público<input @bind="profile.PublicEmail" type="email" /></label>
            <label>Instagram<input @bind="profile.InstagramUrl" placeholder="https://instagram.com/…" /></label>
            <label>Facebook<input @bind="profile.FacebookUrl" placeholder="https://facebook.com/…" /></label>
            <label>Enlace de ubicación<input @bind="profile.LocationUrl" /></label>
            <button class="secondary" @onclick="SaveProfile" disabled="@readOnly">Guardar contacto</button>
        </section>

        @* Las tres operaciones son las únicas decisiones. Servicios/personal y productos son
           dependencias estrictas de citas y pedidos respectivamente. *@
        <section class="panel-card" data-testid="capacidades"><h2>Funciones</h2>
            <label class="check"><input type="checkbox" @bind="appointments" data-testid="cap-citas" /> Citas</label>
            <label class="check"><input type="checkbox" @bind="queues" data-testid="cap-turnos" /> Turnos virtuales</label>
            <label class="check"><input type="checkbox" @bind="orders" data-testid="cap-pedidos" /> Pedidos</label>

            <p class="meta">Citas habilita Servicios y Personal. Pedidos habilita Productos.</p>
            <button class="secondary" @onclick="SaveModules" disabled="@readOnly">Guardar funciones</button>
            <p>Desactivar una función conserva su configuración y datos históricos.</p>
        </section>

        @if (isPlatformAdmin && appointments)
        {
            <section class="panel-card" data-testid="onboarding-operativo"><h2>Configuración operativa</h2>
                <p>Administra el catálogo y quién presta cada servicio sin salir de la ficha.</p>
                <p>
                    <a class="button-link" href="/panel/@BusinessId/configuracion/servicios">Servicios</a>
                    <a class="button-link" href="/panel/@BusinessId/configuracion/personal">Personal</a>
                </p>
            </section>
        }

        <section class="panel-card"><h2>Identidad visual</h2>
            <p>JPEG, PNG o WebP. Máximo 5 MB. Se reescala a 1600 px y se eliminan los metadatos EXIF.</p>
            <label>Tipo de imagen
                <select @bind="uploadKind">
                    <option value="Logo">Logo (uno)</option>
                    <option value="Cover">Portada (una)</option>
                    <option value="Gallery">Galería (hasta 8)</option>
                </select>
            </label>
            <label>Texto alternativo<input @bind="uploadAltText" maxlength="160" /></label>
            <InputFile OnChange="Upload" accept="image/jpeg,image/png,image/webp" disabled="@readOnly" />
            @if (uploading) { <p class="notice">Procesando la imagen…</p> }
            <div class="card-grid">
                @foreach (var image in images)
                {
                    <figure class="business-card">
                        <img src="@image.Url" alt="@(image.AltText ?? business.Name)"
                             width="@image.Width" height="@image.Height" loading="lazy" />
                        <figcaption>@KindLabel(image.Kind) · @image.Width×@image.Height</figcaption>
                        <button class="danger" disabled="@readOnly"
                                @onclick="() => RemoveImage(image)">Eliminar</button>
                    </figure>
                }
            </div>
        </section>
    </div>

    <PlatformBusinessSchedule BusinessId="BusinessId" ReadOnly="readOnly" />

    <section class="panel-card"><h2>Personas con acceso</h2>
        <p><strong>Propietario:</strong> @(business.OwnerName ?? "Sin asignar") @business.OwnerEmail</p>
        <label>Correo de la persona<input @bind="inviteEmail" type="email" /></label>
        <label>Nombre visible<input @bind="inviteName" /></label>
        <label>Tipo de acceso
            <select @bind="inviteGrant">
                <option value="BusinessOwner">Propietario</option>
                <option value="BusinessStaff">Personal del negocio</option>
            </select>
        </label>
        <button class="secondary" @onclick="Invite" disabled="@readOnly">Generar enlace de invitación</button>
        @if (issuedLink is { Length: > 0 })
        {
            <div class="success">
                <p><strong>Copie este enlace y entrégueselo directamente a la persona.</strong>
                   Se puede usar una sola vez y vence en la fecha indicada.</p>
                <input readonly value="@issuedLink" aria-label="Enlace de invitación" />
            </div>
        }
        @if (invitations.Count > 0)
        {
            <table class="data-table">
                <thead><tr><th>Correo</th><th>Acceso</th><th>Estado</th><th>Vence</th><th></th></tr></thead>
                <tbody>
                @foreach (var invitation in invitations)
                {
                    <tr>
                        <td>@invitation.Email</td><td>@invitation.Grant</td>
                        <td>@InvitationStatusLabel(invitation.Status)</td>
                        <td>@invitation.ExpiresAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (invitation.Status == "Pending" || invitation.Status == "Expired")
                            {
                                <button class="secondary" @onclick="() => Resend(invitation)">Reenviar</button>
                            }
                            @if (invitation.Status == "Pending")
                            {
                                <button class="danger" @onclick="() => Revoke(invitation)">Revocar</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="panel-card"><h2>Revisión y publicación</h2>
        <a class="button-link" href="/admin/negocios/@BusinessId/vista-previa"
           data-testid="ver-vista-previa">Ver vista previa pública</a>
        @if (business.Status is "Draft" or "PendingConfiguration" or "PendingReview")
        {
            <button class="primary" disabled="@(!business.IsReady || busy)" @onclick="SubmitForReview"
                    data-testid="enviar-revision">@(busy ? "Enviando…" : "Enviar a revisión")</button>
        }
        @if (isPlatformAdmin)
        {
            @if (business.Status == "PendingReview")
            {
                <button class="primary" @onclick="Publish">Aprobar y publicar</button>
                <label>Observaciones para la socia<input @bind="reviewNotes" /></label>
                <button class="danger" @onclick="Reject">Devolver con observaciones</button>
            }
            @if (business.Status is "Suspended") { <button class="primary" @onclick="Publish">Reactivar</button> }
            @if (business.Status == "Active")
            {
                <label>Motivo de suspensión<input @bind="reason" /></label>
                <button class="danger" @onclick="Suspend">Suspender</button>
            }
            @if (business.Status != "Archived") { <button class="secondary" @onclick="Archive">Archivar</button> }
        }
        @if (message is not null) { <p class="notice" role="alert">@message</p> }
    </section>

    @if (history.Count > 0)
    {
        <section class="panel-card"><h2>Historial de estados</h2>
            <table class="data-table">
                <thead><tr><th>Fecha</th><th>De</th><th>A</th><th>Responsable</th><th>Nota</th></tr></thead>
                <tbody>
                @foreach (var change in history)
                {
                    <tr>
                        <td>@change.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@StatusLabel(change.FromStatus)</td><td>@StatusLabel(change.ToStatus)</td>
                        <td>@(change.ActorEmail ?? "—")</td><td>@(change.Notes ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }
    </fieldset>
}

@code {
    [Parameter] public Guid BusinessId { get; set; }
    private PlatformBusinessDto? business;
    private PlatformBusinessListDto? catalog;
    private SaveBusinessProfileRequest profile = new();
    private IReadOnlyList<BusinessImageDto> images = [];
    private IReadOnlyList<InvitationDto> invitations = [];
    private IReadOnlyList<BusinessStatusChangeDto> history = [];
    private bool appointments, queues, orders, uploading, isPlatformAdmin, readOnly, interactiveReady, busy;
    private string uploadKind = "Logo", inviteGrant = "BusinessOwner";
    private string? uploadAltText, inviteEmail, inviteName, issuedLink, reason, reviewNotes, message;

    protected override async Task OnParametersSetAsync()
    {
        isPlatformAdmin = (await AuthenticationState.GetAuthenticationStateAsync()).User.IsInRole("PlatformAdmin");
        await Reload();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    private async Task Reload()
    {
        catalog ??= await Api.GetPlatformBusinessesAsync();
        business = await Api.GetPlatformBusinessAsync(BusinessId);
        readOnly = business.Status is "Archived" or "Suspended";
        appointments = business.Modules.Contains("Appointments");
        queues = business.Modules.Contains("VirtualQueues");
        orders = business.Modules.Contains("PickupOrders");
        images = business.Images ?? [];
        profile = new()
        {
            Name = business.Name, Slug = business.Slug, MunicipalityId = business.MunicipalityId,
            CategoryId = business.CategoryId, ShortDescription = business.ShortDescription,
            Description = business.Description, Address = business.Address,
            ReferencePoint = business.ReferencePoint, PublicPhone = business.PublicPhone,
            WhatsAppUrl = business.WhatsAppUrl, PublicEmail = business.PublicEmail,
            InstagramUrl = business.InstagramUrl, FacebookUrl = business.FacebookUrl,
            LocationUrl = business.LocationUrl, CustomerInstructions = business.CustomerInstructions,
            LocationMode = business.LocationMode, OrderFulfillmentMode = business.OrderFulfillmentMode,
            Version = business.Version
        };
        try { invitations = await Api.GetInvitationsAsync(BusinessId); } catch (ApiException) { invitations = []; }
        try { history = await Api.GetBusinessStatusHistoryAsync(BusinessId); } catch (ApiException) { history = []; }
    }

    /// <summary>
    /// Envoltura común de las acciones de la ficha. El indicador <c>busy</c> deshabilita el
    /// formulario entero mientras hay una petición en vuelo: sin él, un segundo clic sobre
    /// "Enviar a revisión" mandaba la solicitud dos veces.
    /// </summary>
    private async Task Run(Func<Task> action, string success)
    {
        if (busy) return;
        busy = true;
        try { await action(); message = success; await Reload(); }
        catch (ApiException ex) { message = Friendly(ex); }
        finally { busy = false; }
    }

    private static string Friendly(ApiException ex) => ex.Code switch
    {
        "CONCURRENCY_CONFLICT" => "Esta información cambió mientras la estabas editando. " +
                                  "Actualizamos los datos para que puedas intentarlo nuevamente.",
        "SLUG_EXISTS" => "Esa dirección web ya está en uso. Prueba con otra.",
        "INVALID_CATALOG" => "Selecciona un municipio y una categoría válidos.",
        _ when ex.StatusCode is 401 or 403 => "No tienes permiso para realizar esta acción.",
        _ when ex.StatusCode >= 500 => "No pudimos completar la operación. Intenta nuevamente.",
        _ => ex.Message
    };

    private Task SaveProfile() => Run(async () =>
        await Api.SavePlatformBusinessProfileAsync(BusinessId, profile), "Perfil actualizado.");

    private Task SaveModules() => Run(async () =>
        await Api.UpdatePlatformModulesAsync(BusinessId, new()
        {
            Appointments = appointments, VirtualQueues = queues, PickupOrders = orders,
            Version = business!.Version
        }), "Funciones actualizadas.");

    private async Task Upload(InputFileChangeEventArgs args)
    {
        uploading = true; message = null;
        try
        {
            var file = args.File;
            await using var stream = file.OpenReadStream(ImagePolicyMaximumBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await Api.UploadBusinessImageAsync(BusinessId, uploadKind, file.Name,
                file.ContentType, buffer.ToArray(), uploadAltText);
            uploadAltText = null;
            message = "Imagen cargada.";
            await Reload();
        }
        catch (ApiException ex) { message = ex.Message; }
        catch (IOException) { message = "El archivo supera el máximo de 5 MB."; }
        finally { uploading = false; }
    }

    private Task RemoveImage(BusinessImageDto image) => Run(async () =>
        await Api.RemoveBusinessImageAsync(BusinessId, image.Id, image.Version), "Imagen eliminada.");

    private async Task Invite()
    {
        try
        {
            var issued = await Api.CreateInvitationAsync(new()
            {
                Email = inviteEmail ?? "", DisplayName = inviteName ?? "",
                Grant = inviteGrant, BusinessId = BusinessId
            });
            issuedLink = AbsolutePath(issued.AcceptPath);
            message = $"Enlace generado. Vence el {issued.ExpiresAtUtc.ToLocalTime():dd/MM/yyyy HH:mm}.";
            inviteEmail = inviteName = null;
            await Reload();
        }
        catch (ApiException ex) { message = ex.Message; }
    }

    private async Task Resend(InvitationDto invitation)
    {
        try
        {
            var issued = await Api.ResendInvitationAsync(invitation.Id);
            issuedLink = AbsolutePath(issued.AcceptPath);
            message = "Se generó un enlace nuevo; el anterior quedó anulado.";
            await Reload();
        }
        catch (ApiException ex) { message = ex.Message; }
    }

    private Task Revoke(InvitationDto invitation) => Run(async () =>
        await Api.RevokeInvitationAsync(invitation.Id), "Invitación revocada.");

    private Task SubmitForReview() => Run(async () =>
        await Api.SubmitBusinessForReviewAsync(BusinessId, new() { Version = business!.Version }),
        "Enviado a revisión.");

    private Task Reject() => Run(async () =>
        await Api.RejectBusinessReviewAsync(BusinessId,
            new() { Version = business!.Version, Notes = reviewNotes ?? "" }),
        "Devuelto a la socia con observaciones.");

    private Task Publish() => State("activate", "Negocio publicado.");
    private Task Suspend() => State("suspend", "Negocio suspendido.");
    private Task Archive() => State("archive", "Negocio archivado.");

    private Task State(string action, string success) => Run(async () =>
        await Api.ChangePlatformBusinessStateAsync(BusinessId, action,
            new() { Version = business!.Version, Reason = reason }), success);

    private const long ImagePolicyMaximumBytes = 5 * 1024 * 1024;

    private static string AbsolutePath(string path) => path;

    // El vocabulario de estados vive en un solo sitio: dos traducciones distintas del mismo
    // estado se leen como dos estados distintos.
    private static string StatusLabel(string status) => BusinessStatusText.Label(status);

    private static string KindLabel(string kind) => kind switch
    {
        "Logo" => "Logo", "Cover" => "Portada", _ => "Galería"
    };

    private static string InvitationStatusLabel(string status) => status switch
    {
        "Pending" => "Vigente", "Accepted" => "Aceptada",
        "Revoked" => "Revocada", _ => "Vencida"
    };
}
