@page "/panel"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IUrabaConectaApi Api
@inject AuthenticationStateProvider AuthenticationState
@inject PersistentComponentState PanelState

<PageTitle>Panel | UrabáConecta</PageTitle>
<div class="title-actions panel-header">
    <div>
        <p class="eyebrow">Panel</p>
        <h1>Mis negocios</h1>
    </div>
    @* La socia entra aquí a trabajar. Su acción principal no puede estar escondida detrás de
       "Administración" en la barra superior: vive en su propia pantalla, siempre visible. *@
    @if (isOperator && managed is { Count: > 0 })
    {
        <a class="button-link primary" href="/admin/negocios/nuevo" data-testid="crear-negocio"
           data-enhance-nav="false">Crear negocio</a>
    }
</div>

@* Aquí la instalación no es un adorno: quien atiende el negocio necesita que la aplicación esté en
   la pantalla de inicio y que los avisos entren solos, o se entera de la cita cuando ya pasó. Por
   eso va arriba, destacada y sin "ahora no" que la esconda durante quince días. *@
<InstallPrompt Destacada="true" Descartable="false"
               Titulo="Instalar UrabáConecta"
               Descripcion="Ábrela desde el icono y recibe las citas, turnos y pedidos al instante, aunque no la tengas abierta." />

@if (loading)
{
    <p class="notice" role="status" data-testid="panel-cargando">Cargando tus negocios…</p>
}
else
{
    @if (error is not null) { <p class="error" role="alert" data-testid="panel-error">@error</p> }

    @* ---------------- Negocios que la socia dio de alta ---------------- *@
    @if (isOperator)
    {
        @if (managed is { Count: > 0 })
        {
            <section aria-labelledby="titulo-administrados">
                <h2 id="titulo-administrados">Negocios que administras</h2>
                <p class="meta">Los diste de alta tú. Aquí ves qué le falta a cada uno para publicarse.</p>
                <div class="card-grid" data-testid="negocios-administrados">
                    @foreach (var business in managed)
                    {
                        <article class="business-card" data-testid="negocio-administrado"
                                 data-slug="@business.Slug">
                            <span class="status @BusinessStatusText.CssModifier(business.Status)"
                                  data-testid="negocio-estado">@BusinessStatusText.Label(business.Status)</span>
                            <h3>@business.Name</h3>
                            <p class="meta">@BusinessStatusText.Description(business.Status)</p>

                            @* El porcentaje y la lista de faltantes los calcula el servidor con las
                               mismas reglas que deciden si se puede publicar. Aquí sólo se muestran. *@
                            <progress value="@business.CompletionPercentage" max="100"
                                      aria-label="Avance de la configuración de @business.Name"></progress>
                            <p><strong data-testid="negocio-avance">@business.CompletionPercentage %</strong> configurado</p>

                            @if (business.ReviewNotes is { Length: > 0 } notas)
                            {
                                <p class="warning-text" data-testid="negocio-observaciones">
                                    <strong>La administración pidió ajustes:</strong> @notas
                                </p>
                            }
                            else if (Pending(business) is { Count: > 0 } faltantes)
                            {
                                <p><strong>Falta:</strong></p>
                                <ul class="pending-list" data-testid="negocio-faltantes">
                                    @foreach (var item in faltantes) { <li>@item</li> }
                                </ul>
                                @if (MissingCount(business) - faltantes.Count is > 0 and var restantes)
                                {
                                    <p class="meta">y @restantes @(restantes == 1 ? "requisito más" : "requisitos más").</p>
                                }
                            }
                            else if (business.IsReady && BusinessStatusText.IsInPreparation(business.Status))
                            {
                                <p class="success">Listo para enviar a revisión.</p>
                            }

                            <div class="actions" data-enhance-nav="false">
                                <a class="button-link primary" data-testid="negocio-cta"
                                   href="/admin/negocios/@business.Id">@ActionLabel(business)</a>
                                @if (business.Status == BusinessStatusText.Active)
                                {
                                    <a class="secondary button-link" href="/negocios/@business.Slug"
                                       data-testid="negocio-ver-publico">Ver ficha pública</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        else
        {
            @* Antes esta pantalla decía "Su cuenta no tiene establecimientos asignados" y ahí
               terminaba: la socia no tenía forma de descubrir que su trabajo empieza creando
               un negocio. *@
            <div class="empty" data-testid="panel-vacio-socia">
                <h2>Aún no tienes negocios</h2>
                <p>Crea tu primer negocio para comenzar a configurarlo y prepararlo para publicación.</p>
                <p class="meta">Podrás guardarlo como borrador y continuar cuando quieras.</p>
                <a class="button-link primary" href="/admin/negocios/nuevo" data-testid="crear-negocio"
                   data-enhance-nav="false">Crear negocio</a>
            </div>
        }
    }

    @* ---------------- Negocios donde la persona opera ---------------- *@
    @if (memberships is { Count: > 0 })
    {
        <section aria-labelledby="titulo-operacion" class="@(isOperator ? "divider" : "")"
                 data-testid="owner-dashboard">
            @if (isOperator)
            {
                <h2 id="titulo-operacion">Negocios donde trabajas</h2>
            }
            else
            {
                <h2 id="titulo-operacion" class="visually-hidden">Negocios donde trabajas</h2>
            }

            @if (dashboard == DashboardState.Loading)
            {
                @* Nada de ceros mientras se espera: un "0 citas" que después salta a 7 hace dudar de
                   las dos cifras. *@
                <p class="notice" role="status" data-testid="dashboard-loading">Cargando resumen…</p>
            }
            else if (dashboard == DashboardState.Error)
            {
                <div class="notice" role="alert" data-testid="dashboard-error">
                    <p>No pudimos cargar el resumen de tus negocios.</p>
                    <button type="button" class="secondary" data-testid="dashboard-retry"
                            @onclick="LoadDashboardAsync">Intentar de nuevo</button>
                </div>
            }

            <div class="card-grid">
                @foreach (var business in memberships)
                {
                    @* Cada operación exige el módulo habilitado en ESTE negocio y además el permiso
                       de la persona. Antes bastaba el permiso, y una propietaria veía las tres
                       operaciones aunque su negocio sólo tuviera una activa. *@
                    <BusinessOperationSummary Business="business" Summary="SummaryOf(business.Id)"
                                              UnreadCount="UnreadOf(business.Id)" />
                }
            </div>
        </section>
    }
    else if (!isOperator)
    {
        <div class="empty" data-testid="panel-vacio-miembro">
            <h2>Todavía no tienes acceso a ningún negocio</h2>
            <p>Cuando alguien te vincule a un negocio, aparecerá aquí.</p>
            <p class="meta">Si esperabas ver uno, escribe a quien te envió la invitación.</p>
        </div>
    }
}

<AppStatusCard Operativa="true" Titulo="Esta aplicación en tu dispositivo" />

@code {
    private IReadOnlyList<MyBusinessDto>? memberships;
    private IReadOnlyList<PlatformBusinessDto>? managed;
    private bool isOperator, loading = true;
    private string? error;

    /// <summary>
    /// El resumen operativo se pide UNA vez para todos los negocios, no uno por negocio: ese fue el
    /// trabajo del pipeline y la pantalla no puede deshacerlo pidiendo por separado.
    /// </summary>
    private IReadOnlyDictionary<Guid, OwnerDashboardSummaryDto> summaries =
        new Dictionary<Guid, OwnerDashboardSummaryDto>();
    private DashboardState dashboard = DashboardState.Loading;

    private enum DashboardState { Loading, Loaded, Error }

    /// <summary>
    /// El resumen que el prerender deja escrito en la página para que el circuito no lo vuelva a
    /// pedir. Es exactamente el mismo DTO que ya se está pintando: no viaja nada que la persona no
    /// tenga delante, ni identificadores de sesión, ni datos de clientes.
    /// </summary>
    private const string DashboardStateKey = "panel.resumen-operativo";
    private const string UnreadStateKey = "panel.avisos-sin-leer";
    private PersistingComponentStateSubscription persistence;

    private OwnerDashboardSummaryDto? SummaryOf(Guid businessId)
        => summaries.GetValueOrDefault(businessId);

    /// <summary>
    /// Avisos sin leer por negocio. Se piden en una sola lectura para todos, igual que el resumen:
    /// un contador que cuesta una consulta por tarjeta se vuelve caro en la pantalla que más se abre.
    /// </summary>
    private IReadOnlyDictionary<Guid, int> unread = new Dictionary<Guid, int>();

    private int UnreadOf(Guid businessId) => unread.GetValueOrDefault(businessId);

    /// <summary>Cuántos requisitos pendientes se enumeran antes de resumir el resto.</summary>
    private const int MaximumPendingShown = 3;

    protected override async Task OnInitializedAsync()
    {
        // Se registra antes de cargar nada: el guardado ocurre al terminar el prerender, así que la
        // suscripción tiene que existir aunque la carga falle.
        persistence = PanelState.RegisterOnPersisting(PersistDashboard);
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        isOperator = user.IsInRole("PartnerOperator") || user.IsInRole("PlatformAdmin");
        try
        {
            memberships = await Api.GetMyBusinessesAsync();
            // Sólo quien administra la plataforma puede pedir este listado; para el resto
            // devolvería 403 y no aporta nada a su pantalla.
            if (isOperator) managed = (await Api.GetPlatformBusinessesAsync()).Items;
        }
        catch (ApiException ex)
        {
            error = ex.StatusCode is 401 or 403
                ? "Tu sesión no tiene permiso para ver estos negocios. Vuelve a ingresar."
                : "No pudimos cargar tus negocios. Actualiza la página para intentarlo de nuevo.";
        }
        finally { loading = false; }

        if (memberships is not { Count: > 0 }) { dashboard = DashboardState.Loaded; return; }

        // InteractiveServer inicializa el componente dos veces: una al prerenderizar el HTML y otra
        // al abrir el circuito. Sin esto, el resumen se resolvía entero las dos veces y la mitad del
        // trabajo del pipeline se iba en repetir lo que la página ya tenía delante.
        if (PanelState.TryTakeFromJson<OwnerDashboardSummaryDto[]>(DashboardStateKey, out var prerenderizado)
            && prerenderizado is not null)
        {
            summaries = prerenderizado.ToDictionary(x => x.BusinessId);
            // El contador viaja con el resumen. Sin esto, el circuito reemplazaba la pintura del
            // prerender por una sin contador y el punto de avisos sin leer desaparecía solo.
            if (PanelState.TryTakeFromJson<NotificationCountDto[]>(UnreadStateKey, out var contadores)
                && contadores is not null)
                unread = contadores.ToDictionary(x => x.BusinessId, x => x.UnreadCount);
            dashboard = DashboardState.Loaded;
            return;
        }

        await LoadDashboardAsync();
    }

    /// <summary>
    /// Guarda el resumen del prerender para que el circuito lo reciba hecho. Sólo viaja un resultado
    /// bueno: persistir un fallo dejaría al circuito heredando el error sin haberlo intentado nunca,
    /// y una caída pasajera del prerender se volvería permanente hasta recargar.
    /// </summary>
    private Task PersistDashboard()
    {
        if (dashboard == DashboardState.Loaded)
        {
            PanelState.PersistAsJson(DashboardStateKey, summaries.Values.ToArray());
            PanelState.PersistAsJson(UnreadStateKey, unread
                .Select(x => new NotificationCountDto(x.Key, "", x.Value)).ToArray());
        }
        return Task.CompletedTask;
    }

    public void Dispose() => persistence.Dispose();

    /// <summary>
    /// Una sola llamada para todos los negocios. Si falla, la página sigue siendo utilizable: se
    /// conservan los negocios y sus accesos, y sólo faltan las cifras del día.
    /// </summary>
    private async Task LoadDashboardAsync()
    {
        dashboard = DashboardState.Loading;
        StateHasChanged();
        try
        {
            summaries = (await Api.GetOwnerDashboardAsync()).ToDictionary(x => x.BusinessId);
            unread = (await Api.GetUnreadNotificationCountsAsync())
                .ToDictionary(x => x.BusinessId, x => x.UnreadCount);
            dashboard = DashboardState.Loaded;
        }
        // Se atrapa cualquier excepción a propósito: una que escape de aquí termina el circuito de
        // Blazor y deja la pantalla congelada sin explicación. El resumen es informativo; perderlo
        // no puede costar la sesión de trabajo.
        catch (Exception)
        {
            summaries = new Dictionary<Guid, OwnerDashboardSummaryDto>();
            unread = new Dictionary<Guid, int>();
            dashboard = DashboardState.Error;
        }
    }

    private static IReadOnlyList<string> Pending(PlatformBusinessDto business)
        => business.MissingLabels?.Take(MaximumPendingShown).ToList() ?? [];

    private static int MissingCount(PlatformBusinessDto business)
        => business.MissingLabels?.Count ?? 0;

    /// <summary>La acción cambia según lo que le toca hacer a la socia en ese estado.</summary>
    private static string ActionLabel(PlatformBusinessDto business)
    {
        if (business.ReviewNotes is { Length: > 0 } && BusinessStatusText.IsInPreparation(business.Status))
            return "Corregir pendientes";
        return business.Status switch
        {
            BusinessStatusText.PendingReview => "Ver solicitud",
            BusinessStatusText.Active => "Administrar",
            BusinessStatusText.Suspended or BusinessStatusText.Archived => "Ver detalle",
            _ => "Continuar configuración"
        };
    }

}
