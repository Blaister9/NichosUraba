@page "/panel"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IUrabaConectaApi Api

<PageTitle>Panel | UrabáConecta</PageTitle>
<p class="eyebrow">Área privada</p><h1>Mis establecimientos</h1>
@if (businesses is null) { <p class="notice">Cargando…</p> }
else if (businesses.Count == 0) { <div class="empty">Su cuenta no tiene establecimientos asignados.</div> }
else
{
    <div class="card-grid">
        @foreach (var business in businesses)
        {
            <article class="business-card"><span class="tag">@business.MembershipRole</span><h2>@business.Name</h2>
                @if (business.BusinessStatus == "Suspended")
                { <p class="notice"><strong>Establecimiento suspendido.</strong> Puede consultar el historial, pero no iniciar operaciones nuevas.</p> }
                @* Cada operación exige el módulo habilitado en ESTE negocio y además el permiso
                   de la persona. Antes bastaba el permiso, y una propietaria veía las tres
                   operaciones aunque su establecimiento sólo tuviera una activa.

                   data-enhance-nav="false": al salir de este componente interactivo, la navegación
                   mejorada cambiaba la dirección pero dejaba en pantalla "Mis establecimientos".
                   Quien pulsaba "Operar pedidos" seguía viendo la misma página y parecía que la
                   operación no funcionaba. Con la navegación normal la página destino se carga
                   completa. *@
                <div class="actions" data-enhance-nav="false">
                @if (business.ShowAppointments)
                {
                    <a class="button-link" href="/panel/@business.Id/citas">Administrar citas</a>
                }
                @if (business.CanManageConfiguration)
                {
                    <a class="secondary button-link" href="/panel/@business.Id/configuracion">Configuración del negocio</a>
                }
                @if (business.CanManageMembers)
                {
                    <a class="secondary button-link" href="/panel/@business.Id/equipo">Equipo y permisos</a>
                }
                @if (business.ShowQueues)
                {
                    <a class="button-link" href="/panel/@business.Id/turnos">Operar turnos</a>
                }
                @if (business.ShowOrders)
                {
                    <a class="button-link" href="/panel/@business.Id/pedidos">Operar pedidos</a>
                }</div>
            </article>
        }
    </div>
}
@code {
    private IReadOnlyList<MyBusinessDto>? businesses;
    protected override async Task OnInitializedAsync() => businesses = await Api.GetMyBusinessesAsync();
}
