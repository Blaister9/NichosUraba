@page "/seguimiento/turnos/{Code}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IUrabaConectaApi Api
@inject NavigationManager Navigation

<PageTitle>Seguimiento de turno | UrabáConecta</PageTitle>
@if (ticket is null && error is null) { <p class="notice">Consultando tu turno…</p> }
else if (error is not null) { <div class="error" role="alert">@error</div> }
else if (ticket is not null)
{
    @* Esta pantalla se mira de reojo mientras se hace otra cosa, así que tiene que contestar de un
       vistazo y desde lejos: cuánto falta, y si ya toca moverse. El titular cambia con la posición
       —"Faltan 3", "Eres el siguiente", "¡Es tu turno!"— porque un número solo no dice qué hacer. *@
    @* La etapa es lo que la pantalla es ahora —espera, siguiente, llamado, atención, cerrado— y de
       ella cuelgan la superficie, el peso del titular y con cuánta fuerza se anuncia el cambio. Un
       estado y una hoja de estilos que lo lee, no cinco animaciones parecidas. Quién enciende cada
       cosa está en live-state.js; qué se ve, en app.css. *@
    <section class="fila-tablero mi-turno narrow" data-live-state="turno" data-live-etapa="@Etapa"
             data-estado-turno="@ticket.Status.ToLowerInvariant()">
        <p class="eyebrow">@ticket.BusinessName · @ticket.QueueName</p>
        <span class="ticket-etiqueta">Tu turno</span>
        <strong class="ticket-number">@ticket.Number</strong>

        @* Titular y explicación son una sola noticia y se anuncian juntos. "Es tu turno" interrumpe
           lo que el lector de pantalla esté diciendo porque hay que moverse ya; todo lo demás
           espera su turno para no convertir una espera de veinte minutos en veinte anuncios. *@
        <div class="mi-turno-estado" aria-live="@Vivacidad" aria-atomic="true">
            <h1 data-live-text>@Titular</h1>
            <p class="lead" data-live-text>@Subtitulo</p>
        </div>

        <div class="mi-turno-posicion" aria-hidden="@(ticket.Status != "Waiting")">
        @if (ticket.Status == "Waiting")
        {
            @* La barra sólo aparece cuando hay contra qué medir: en el primer vistazo no había
               referencia y se llenaba entera con cualquier posición. *@
            @if (Referencia > 0)
            {
                <div class="fila-avance" role="img"
                     aria-label="@($"Faltan {ticket.PeopleAhead} de {Referencia} turnos")">
                    <span style="width:@(Math.Clamp(100 - ticket.PeopleAhead * 100 / Referencia, 4, 100))%"></span>
                </div>
            }
            @* La única cifra del producto que es tuya: cuánta gente te separa de la silla. Por eso
               es la única que lleva acento —el "−1" que aparece y se va— y la que dice en qué
               dirección se movió. La espera aproximada acompaña, y viaja igual pero sin acento. *@
            <p class="fila-cifras-linea">
                <span><strong data-live-value data-live-delta>@ticket.PeopleAhead</strong> @(ticket.PeopleAhead == 1 ? "turno delante" : "turnos delante")</span>
                <span><strong data-live-value>~@ticket.ApproximateWaitMinutes</strong> min</span>
            </p>
        }
        </div>

        <p class="meta">El tiempo es aproximado y puede cambiar. Esta pantalla se actualiza sola.</p>

        <PushPrompt RegistrationPath="@($"/api/v1/public/queue/tickets/{Uri.EscapeDataString(Code)}/push-subscriptions")"
                    Title="No esperes mirando la pantalla"
                    Description="Te avisamos cuando tu turno esté cerca y cuando te llamen."
                    ButtonLabel="Avisarme cuando falte poco"
                    DeniedNote="Tu turno avanza igual y esta pantalla se actualiza sola." />

        @* La invitación llega después de tomar el turno, no al entrar: aquí ya hay algo que
           conservar, y la persona vuelve a esta pantalla varias veces mientras espera. *@
        <InstallPrompt />

        @* La salida de la fila deja de existir en cuanto te llaman, y ese es justo el momento en el
           que la pantalla no puede dar un tirón: el hueco se reserva y lo que se retira es el
           botón, no el sitio donde estaba. *@
        <div class="fila-accion">
            @if (ticket.CanCancel)
            {
                <button class="danger" @onclick="Cancel" disabled="@(!interactiveReady || busy)">
                    @(busy ? "Cancelando…" : "Cancelar mi turno")
                </button>
                @if (!interactiveReady) { <p class="notice" role="status">Preparando la cancelación…</p> }
            }
        </div>
    </section>
}

@code {
    [Parameter] public string Code { get; set; } = "";
    private QueueTicketTrackingDto? ticket;
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? hub;
    private readonly CancellationTokenSource refreshCancellation = new();
    private string? error;
    private bool busy, interactiveReady;
    private string? subscribedCode;
    private long loadGeneration;

    /// <summary>
    /// Cuántos había delante la primera vez que se miró. Es el punto contra el que se mide el
    /// avance: la API entrega la posición actual pero no de dónde se venía, y sin referencia una
    /// barra de progreso no puede decir nada honesto.
    /// </summary>
    private int Referencia;

    /// <summary>
    /// En qué punto del recorrido está esto ahora. El dominio distingue seis estados de turno, pero
    /// para quien espera sólo hay cinco situaciones distintas, y una de ellas —"eres el siguiente"—
    /// no es un estado del dominio sino un <c>Waiting</c> sin nadie delante. Esta es la única
    /// traducción de las dos cosas a una, y de aquí la leen la superficie, el peso del titular y
    /// con cuánta fuerza se anuncia el cambio.
    /// </summary>
    private string Etapa => ticket!.Status switch
    {
        "Waiting" when ticket.PeopleAhead == 0 => "siguiente",
        "Waiting" => "espera",
        "Called" => "llamado",
        "InService" => "atencion",
        _ => "cerrado"
    };

    /// <summary>
    /// Interrumpir sólo cuando hay que moverse ya. Una espera larga cambia de cifra muchas veces y
    /// anunciarlas todas de forma asertiva convierte el lector de pantalla en una alarma.
    /// </summary>
    private string Vivacidad => Etapa == "llamado" ? "assertive" : "polite";

    /// <summary>Lo que hay que hacer, no sólo dónde se está.</summary>
    private string Titular => ticket!.Status switch
    {
        "Waiting" when ticket.PeopleAhead == 0 => "Eres el siguiente",
        "Waiting" when ticket.PeopleAhead == 1 => "Falta 1 turno",
        "Waiting" => $"Faltan {ticket.PeopleAhead} turnos",
        "Called" => "¡Es tu turno!",
        "InService" => "Te están atendiendo",
        _ => ticket.StatusLabel
    };

    private string? Subtitulo => ticket!.Status switch
    {
        "Waiting" when ticket.PeopleAhead == 0 => "Acércate al local y espera a que te llamen.",
        "Waiting" when ticket.ApproximateWaitMinutes <= 10 => "Ve saliendo, ya falta poco.",
        "Waiting" => "Te avisamos cuando falte poco. No hace falta que esperes en el local.",
        "Called" => "Pasa al mostrador, te están llamando.",
        _ => null
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        await Load();
        // El circuito prerenderiza y luego vuelve a fijar parámetros. Suscribirse en cada
        // pasada abría un hub adicional y dejaba corriendo el sondeo anterior sin cancelar.
        if (subscribedCode == Code) return;
        subscribedCode = Code;
        if (hub is not null) await hub.DisposeAsync();
        hub = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/queue")).WithAutomaticReconnect().Build();
        // QueueChanged incluye tanto el turno propio como los anteriores, que cambian PeopleAhead.
        hub.On("QueueChanged", () => InvokeAsync(async () => { await Load(); StateHasChanged(); }));
        hub.Reconnected += async _ =>
        {
            await hub.InvokeAsync("SubscribeTicket", Code);
            await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        };
        try { await hub.StartAsync(); await hub.InvokeAsync("SubscribeTicket", Code); await Load(); } catch { }
        _ = RefreshLoop();
    }
    private async Task Load()
    {
        var generation = ++loadGeneration;
        error = null;
        try
        {
            var current = await Api.GetQueueTicketAsync(Code);
            if (generation != loadGeneration) return;
            ticket = current;
            if (ticket is null) { error = "No encontramos el turno."; return; }
            // La referencia se fija con la primera lectura y sólo puede crecer: si alguien se cuela
            // por delante, la barra retrocedería y parecería un error del sistema en vez de lo que
            // es, un cambio en la fila.
            if (ticket.PeopleAhead > Referencia) Referencia = ticket.PeopleAhead;
        }
        catch (ApiException ex) { if (generation == loadGeneration) error = ex.Message; }
    }
    private async Task Cancel()
    {
        if (ticket is null) return;
        busy = true;
        try { await Api.CancelQueueTicketAsync(Code, ticket.Version); await Load(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task RefreshLoop()
    {
        // Red de seguridad, no el mecanismo principal: el hub empuja "QueueChanged" al
        // instante. Sondear cada dos segundos consultaba la base treinta veces por minuto
        // y por visitante, y la base está en otra región.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
            {
                await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        refreshCancellation.Cancel();
        refreshCancellation.Dispose();
        if (hub is not null) await hub.DisposeAsync();
    }
}
