@page "/municipios/{Municipio}"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api

<PageTitle>@Titulo | UrabáConecta</PageTitle>

@if (Destino is null)
{
    <section class="empty discovery-empty">
        <h1>Municipio no disponible</h1>
        <p class="meta">Explora Apartadó, Carepa, Chigorodó o Turbo.</p>
        <a class="button-link" href="/">Volver al inicio</a>
    </section>
}
else
{
    var look = MunicipalityLook.For(Destino.Slug);
    <div class="municipality-screen" data-place="@look.Tone">
        <a class="screen-back" href="/"><Icon Name="atras" Size="18" /> Urabá</a>

        <header class="municipality-hero">
            <span class="municipality-hero-mark" aria-hidden="true">@look.Monogram</span>
            <span class="municipality-hero-icon"><Icon Name="@look.Icon" Size="34" /></span>
            <div>
                <p>@look.Cue</p>
                <h1>@Destino.Name</h1>
            </div>
        </header>

        <section class="municipality-choice" aria-labelledby="municipality-choice-title">
            <header class="screen-heading">
                <h2 id="municipality-choice-title">¿Qué quieres encontrar?</h2>
                <a href="@($"/categorias?municipio={Destino.Slug}")">Ver todas</a>
            </header>

            @if (cargando)
            {
                <div class="destination-category-grid" aria-hidden="true">
                    @for (var i = 0; i < 3; i++) { <span class="skeleton destination-category"></span> }
                </div>
            }
            else if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
            else if (AvailableCategories.Count == 0)
            {
                <div class="empty compact-empty">
                    <h2>Estamos sumando opciones</h2>
                    <p class="meta">Puedes explorar las categorías disponibles en todo Urabá.</p>
                    <a class="button-link" href="/categorias">Ver categorías</a>
                </div>
            }
            else
            {
                <div class="destination-category-grid">
                    @foreach (var category in AvailableCategories)
                    {
                        <a class="destination-category" data-tono="@CategoryLook.Tone(category.Slug)"
                           href="@($"/categorias/{category.Slug}?municipio={Destino.Slug}")">
                            <span class="destination-category-art"><Icon Name="@CategoryLook.Icon(category.Slug)" Size="48" /></span>
                            <span><strong>@ShortName(category.Slug, category.Name)</strong><small>@Count(category.BusinessCount)</small></span>
                            <Icon Name="flecha" Size="19" Class="destination-category-arrow" />
                        </a>
                    }
                </div>
            }
        </section>

        @if (!cargando && Featured is { } featured && PromotionCatalog.For(featured.Slug) is { } promotion)
        {
            <section class="municipality-featured" aria-labelledby="municipality-featured-title">
                <header class="screen-heading">
                    <h2 id="municipality-featured-title">Destacado en @Destino.Name</h2>
                </header>
                <CommercialBanner Business="featured" Promotion="promotion" Compact="true" />
            </section>
        }
    </div>
}

@code {
    [Parameter] public string? Municipio { get; set; }

    private DiscoveryCatalog.Municipality? Destino;
    private string? error;
    private bool cargando = true;
    private IReadOnlyList<BusinessCardDto> negocios = [];
    private IReadOnlyList<CategoryCardDto> categorias = [];

    private string Titulo => Destino?.Name ?? "Municipio";
    private IReadOnlyList<DiscoveryCatalog.CategoryEntry> AvailableCategories => DiscoveryCatalog.WithCounts(categorias)
        .Where(x => x.IsAvailable).ToArray();
    private IReadOnlyList<BusinessCardDto> OrderedBusinesses => PromotionCatalog.Order(negocios);
    private BusinessCardDto? Featured => OrderedBusinesses.FirstOrDefault(PromotionCatalog.IsFeatured);

    protected override async Task OnParametersSetAsync()
    {
        Destino = DiscoveryCatalog.MunicipalityBySlug(Municipio);
        if (Destino is null) { cargando = false; return; }
        cargando = true; error = null;
        try
        {
            categorias = await Api.GetCategoriesAsync(Destino.Slug);
            negocios = await Api.GetBusinessesAsync(municipality: Destino.Slug);
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    private static string ShortName(string slug, string fallback) => slug switch
    {
        "belleza-cuidado-personal" => "Belleza",
        "maquillaje-y-cosmeticos" => "Maquillaje",
        "salud-bienestar" => "Bienestar",
        "servicios-profesionales" => "Servicios",
        _ => fallback,
    };

    private static string Count(int count) => count == 1 ? "1 negocio" : $"{count} negocios";
}
