@page "/seguimiento/pedidos/{Code}"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api

<PageTitle>Seguimiento del pedido | UrabáConecta</PageTitle>
<a class="back-link" href="/">← Negocios de Urabá</a>
@if (error is not null) { <div class="error" role="alert">@error</div> }
else if (order is null) { <p class="notice">Consultando pedido…</p> }
else
{
    @* La tarjeta era verde de "éxito" pasara lo que pasara: un pedido rechazado se anunciaba
       con el mismo color que uno listo para recoger. El estado lo dice la etiqueta. *@
    <section class="narrow" data-testid="order-tracking">
        <p class="eyebrow">@order.BusinessName</p><h1>Pedido #@order.OrderNumber</h1>
        <span class="status @order.Status.ToLowerInvariant()">@order.StatusLabel</span>
        <p class="lead">Recoges el @Local(order.PickupStart)</p>
        <p class="meta">Celular: @order.PhoneMasked</p>
        @foreach (var line in order.Lines) { <p>@line.Quantity × @line.ProductName <strong>@line.LineTotal.ToString("C0", Colombia)</strong></p> }
        <p class="total-pedido"><span>Total a pagar en el local</span><strong>@order.Total.ToString("C0", Colombia)</strong></p>
        <PushPrompt RegistrationPath="@($"/api/v1/public/orders/{Uri.EscapeDataString(Code)}/push-subscriptions")"
                    Title="Te avisamos cuando esté listo"
                    Description="Activa los avisos para no tener que revisar esta pantalla."
                    ButtonLabel="Avisarme en este dispositivo" />
        @if (order.CanCancel)
        {
            <button class="danger" disabled="@(!interactiveReady || busy)" @onclick="Cancel">
                @(busy ? "Cancelando…" : "Cancelar pedido")
            </button>
            @if (!interactiveReady) { <p class="notice" role="status">Preparando la cancelación…</p> }
        }
    </section>
}
@code {
    [Parameter] public string Code { get; set; } = "";
    private PickupOrderTrackingDto? order; private string? error; private bool busy, interactiveReady;
    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");
    protected override async Task OnParametersSetAsync() => await Load();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    private async Task Load()
    {
        try { order = await Api.GetPickupOrderAsync(Code); if (order is null) error = "No encontramos el pedido."; }
        catch (ApiException ex) { error = ex.Message; }
    }
    private async Task Cancel()
    {
        busy = true;
        try { await Api.CancelPickupOrderAsync(Code, order!.Version); await Load(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private static string Local(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota")).ToString("f");
}
