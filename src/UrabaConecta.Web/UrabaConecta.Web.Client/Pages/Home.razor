@page "/"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api
@inject NavigationManager Nav

<PageTitle>Negocios de Urabá | UrabáConecta</PageTitle>

<section class="home-index" aria-labelledby="home-title">
    <div class="home-intro">
        <p class="eyebrow">Tu guía local en Urabá</p>
        <h1 id="home-title">Encuentra lo que necesitas, cerca de ti</h1>
        <p>Reserva, toma un turno o pide para recoger desde el celular.</p>
    </div>

    <form class="buscador-hero" @onsubmit="Buscar" @formname="buscar-home">
        <label class="visually-hidden" for="q-home">Qué buscas</label>
        <Icon Name="explorar" Size="20" />
        <input id="q-home" @bind-value="termino" @bind-value:event="oninput" disabled="@(!listo)"
               placeholder="Barbería, uñas, maquillaje, lifting…" autocomplete="off" />
        <button type="submit" class="primary" disabled="@(!listo)">Buscar</button>
    </form>

    <section class="index-block" aria-labelledby="titulo-municipios">
        <div class="index-heading">
            <div>
                <p class="index-step">1 · Elige dónde</p>
                <h2 id="titulo-municipios">Municipios</h2>
            </div>
            <span>Los cuatro, siempre visibles</span>
        </div>
        <div class="municipality-grid">
            @foreach (var municipio in DiscoveryCatalog.Municipalities)
            {
                <a class="municipality-card" href="@($"/municipios/{municipio.Slug}")">
                    <span class="municipality-icon"><Icon Name="ubicacion" Size="20" /></span>
                    <span>
                        <strong>@municipio.Name</strong>
                        <small>@ConteoMunicipio(municipio.Slug)</small>
                    </span>
                    <span class="destination-arrow" aria-hidden="true">›</span>
                </a>
            }
        </div>
    </section>

    <section class="index-block" aria-labelledby="titulo-categorias">
        <div class="index-heading">
            <div>
                <p class="index-step">2 · Elige qué</p>
                <h2 id="titulo-categorias">Categorías</h2>
            </div>
            <a href="/categorias">Ver todas</a>
        </div>
        @if (cargando)
        {
            <div class="discovery-category-grid" aria-hidden="true">
                @for (var i = 0; i < 7; i++) { <span class="skeleton discovery-category-tile"></span> }
            </div>
        }
        else
        {
            <div class="discovery-category-grid home-category-grid">
                @foreach (var item in MapaCategorias)
                {
                    @if (item.IsAvailable)
                    {
                        <a class="discovery-category-tile" data-tono="@CategoryLook.Tone(item.Slug)"
                           href="@($"/categorias/{item.Slug}")">
                            <span class="marca-icono"><Icon Name="@CategoryLook.Icon(item.Slug)" Size="22" /></span>
                            <span><strong>@item.Name</strong><small>@Conteo(item.BusinessCount)</small></span>
                        </a>
                    }
                    else
                    {
                        <div class="discovery-category-tile proximamente" data-tono="@CategoryLook.Tone(item.Slug)"
                             aria-label="@item.Name, próximamente">
                            <span class="marca-icono"><Icon Name="@CategoryLook.Icon(item.Slug)" Size="22" /></span>
                            <span><strong>@item.Name</strong><small>Próximamente</small></span>
                        </div>
                    }
                }
            </div>
        }
    </section>
</section>

@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}
else
{
    <section class="seccion home-businesses" aria-labelledby="titulo-destacados">
        <div class="seccion-head">
            <div>
                <p class="index-step">3 · Elige un negocio</p>
                <h2 id="titulo-destacados">Opciones para ti</h2>
                <p>@(cargando ? "Buscando negocios…" : Resumen)</p>
            </div>
            @if (!cargando && negocios.Count > 0) { <a href="/explorar">Explorar todo</a> }
        </div>

        @if (cargando)
        {
            <div class="card-grid" aria-hidden="true">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton skeleton-media"></div>
                        <div class="skeleton skeleton-linea"></div>
                        <div class="skeleton skeleton-linea corta"></div>
                    </div>
                }
            </div>
        }
        else if (negocios.Count == 0)
        {
            <div class="empty">
                <h3>Todavía no hay negocios publicados</h3>
                <p class="meta">En cuanto se publiquen aparecerán aquí.</p>
            </div>
        }
        else
        {
            <div class="card-grid">
                @foreach (var (negocio, indice) in negocios.Take(6).Select((x, i) => (x, i)))
                {
                    <BusinessCard Business="negocio" Priority="indice == 0" />
                }
            </div>
        }
    </section>
}

@code {
    private string termino = "";
    private string? error;
    private bool cargando = true, listo;
    private IReadOnlyList<BusinessCardDto> negocios = [];
    private IReadOnlyList<CategoryCardDto> categorias = [];

    private IReadOnlyList<DiscoveryCatalog.CategoryEntry> MapaCategorias => DiscoveryCatalog.WithCounts(categorias);
    private string Resumen => negocios.Count == 1 ? "1 negocio publicado" : $"{negocios.Count} negocios publicados";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            negocios = await Api.GetBusinessesAsync();
            categorias = await Api.GetCategoriesAsync();
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        listo = true;
        StateHasChanged();
    }

    private string ConteoMunicipio(string slug)
    {
        var count = negocios.Count(x => x.Municipality.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase));
        return count == 0 ? "Explorar" : Conteo(count);
    }

    private static string Conteo(int count) => count == 1 ? "1 negocio" : $"{count} negocios";

    private void Buscar() => Nav.NavigateTo(string.IsNullOrWhiteSpace(termino)
        ? "/explorar" : $"/explorar?q={Uri.EscapeDataString(termino.Trim())}");
}
