@page "/"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api

<PageTitle>Descubre Urabá | UrabáConecta</PageTitle>

<div class="portal-home" aria-labelledby="portal-title">
    <h1 id="portal-title" class="visually-hidden">Elige dónde o qué quieres encontrar en Urabá</h1>

    @if (cargando)
    {
        <div class="skeleton portal-promo" aria-hidden="true"></div>
    }
    else if (Featured is { } featured && PromotionCatalog.For(featured.Slug) is { } promotion)
    {
        <CommercialBanner Business="featured" Promotion="promotion" Priority="true" Compact="true" />
    }

    <section class="portal-decision" aria-labelledby="where-title">
        <header class="portal-heading">
            <h2 id="where-title">¿Dónde buscas?</h2>
            <span>Urabá</span>
        </header>
        <div class="portal-municipalities">
            @foreach (var municipio in DiscoveryCatalog.Municipalities)
            {
                var look = MunicipalityLook.For(municipio.Slug);
                <a class="portal-municipality" data-place="@look.Tone" href="@($"/municipios/{municipio.Slug}")">
                    <span class="place-monogram" aria-hidden="true">@look.Monogram</span>
                    <span class="place-icon"><Icon Name="@look.Icon" Size="28" /></span>
                    <span class="place-copy"><strong>@municipio.Name</strong><small>@look.Cue</small></span>
                </a>
            }
        </div>
    </section>

    <section class="portal-decision portal-categories" aria-labelledby="what-title">
        <header class="portal-heading">
            <h2 id="what-title">¿Qué quieres encontrar?</h2>
            <a href="/categorias">Ver todas</a>
        </header>
        @if (cargando)
        {
            <div class="portal-category-grid" aria-hidden="true">
                @for (var i = 0; i < 3; i++) { <span class="skeleton portal-category"></span> }
            </div>
        }
        else
        {
            <div class="portal-category-grid">
                @foreach (var category in HomeCategories)
                {
                    <a class="portal-category" data-tono="@CategoryLook.Tone(category.Slug)"
                       href="@($"/categorias/{category.Slug}")">
                        <span class="portal-category-art"><Icon Name="@CategoryLook.Icon(category.Slug)" Size="39" /></span>
                        <strong>@ShortName(category.Slug, category.Name)</strong>
                        <Icon Name="flecha" Size="16" Class="portal-category-arrow" />
                    </a>
                }
            </div>
        }
    </section>

    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (!cargando && PreviewBusinesses.Count > 0)
    {
        <section class="portal-preview" aria-labelledby="preview-title">
            <header class="portal-heading">
                <h2 id="preview-title">Para descubrir</h2>
                <a href="/explorar">Explorar</a>
            </header>
            <div class="portal-preview-grid">
                @foreach (var negocio in PreviewBusinesses)
                {
                    <a class="portal-business" data-tono="@CategoryLook.Tone(negocio.Category.Slug)"
                       href="@($"/negocios/{negocio.Slug}")">
                        <span class="portal-business-media">
                            @if (negocio.CoverUrl is { Length: > 0 } cover)
                            {
                                <img src="@cover" alt="@(negocio.CoverAltText ?? $"Portada de {negocio.Name}")"
                                     width="420" height="300" loading="lazy" />
                            }
                            else
                            {
                                <Icon Name="@CategoryLook.Icon(negocio.Category.Slug)" Size="40" />
                            }
                        </span>
                        <span><strong>@CleanName(negocio.Name)</strong><small>@negocio.Category.Name · @negocio.Municipality.Name</small></span>
                    </a>
                }
            </div>
        </section>
    }
</div>

@code {
    private string? error;
    private bool cargando = true;
    private IReadOnlyList<BusinessCardDto> negocios = [];
    private IReadOnlyList<CategoryCardDto> categorias = [];

    private IReadOnlyList<BusinessCardDto> OrderedBusinesses => PromotionCatalog.Order(negocios);
    private BusinessCardDto? Featured => OrderedBusinesses.FirstOrDefault(PromotionCatalog.IsFeatured);
    private IReadOnlyList<DiscoveryCatalog.CategoryEntry> HomeCategories => DiscoveryCatalog.WithCounts(categorias)
        .Where(x => x.IsAvailable).Take(6).ToArray();
    private IReadOnlyList<BusinessCardDto> PreviewBusinesses => OrderedBusinesses
        .Where(x => Featured is null || !x.Slug.Equals(Featured.Slug, StringComparison.OrdinalIgnoreCase))
        .Take(2).ToArray();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            negocios = await Api.GetBusinessesAsync();
            categorias = await Api.GetCategoriesAsync();
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    private static string ShortName(string slug, string fallback) => slug switch
    {
        "belleza-cuidado-personal" => "Belleza",
        "maquillaje-y-cosmeticos" => "Maquillaje",
        "salud-bienestar" => "Bienestar",
        "servicios-profesionales" => "Servicios",
        _ => fallback,
    };

    private static string CleanName(string name) => name.Replace(" · DEMO", "", StringComparison.OrdinalIgnoreCase);
}
