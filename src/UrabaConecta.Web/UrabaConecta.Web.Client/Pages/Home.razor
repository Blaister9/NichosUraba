        bool IsPrimary)
    {
        public string BusinessLine => Detail;
        public string VisualStatus => State;
        public static FeedPiece Capture() => new(FeedKind.Capture, "", "", null, "", "tienda",
            "", "", "", "", "", "", false, false, false, false);
    }
