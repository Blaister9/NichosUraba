@page "/"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api

<PageTitle>Directorio | UrabáConecta</PageTitle>
<section class="hero">
    <p class="eyebrow">Directorio local demostrativo</p>
    <h1>Encuentre servicios cerca de usted</h1>
    <p>Agende una cita, tome un turno o haga un pedido para recoger sin crear cuenta.</p>
</section>
<section class="capability-grid" aria-label="Formas de atención disponibles">
    <div><strong>Agendar</strong><span>Reserve una hora disponible.</span></div>
    <div><strong>Tomar turno</strong><span>Entre a una fila virtual.</span></div>
    <div><strong>Pedir para recoger</strong><span>Elija productos y una franja.</span></div>
</section>
<section class="search-panel" aria-label="Filtros del directorio">
    <label>Buscar por nombre<InputText @bind-Value="search" placeholder="Ej. Bella" /></label>
    <label>Municipio<InputSelect @bind-Value="municipality">
        <option value="">Todos</option><option value="apartado">Apartadó</option><option value="carepa">Carepa</option><option value="turbo">Turbo</option><option value="chigorodo">Chigorodó</option>
    </InputSelect></label>
    <label>Categoría<InputSelect @bind-Value="category">
        <option value="">Todas</option><option value="belleza-cuidado-personal">Belleza y cuidado personal</option><option value="barberia">Barbería</option><option value="restaurante">Restaurante</option>
    </InputSelect></label>
    <button class="primary" @onclick="Load">Buscar</button>
</section>
@if (loading) { <p class="notice">Cargando establecimientos…</p> }
else if (error is not null) { <p class="error" role="alert">@error</p> }
else if (businesses.Count == 0)
{
    <div class="empty"><h2>No encontramos resultados</h2><p>Pruebe otro nombre, municipio o categoría.</p></div>
}
else
{
    <section class="card-grid" aria-live="polite">
        @foreach (var business in businesses)
        {
            <article class="business-card">
                @if (business.CoverUrl is { Length: > 0 } cover)
                {
                    @* Dimensiones fijas para reservar el espacio y evitar saltos al cargar. *@
                    <img class="card-cover" src="@cover" alt="@(business.CoverAltText ?? $"Portada de {business.Name}")"
                         width="640" height="360" loading="lazy" />
                }
                <div class="card-identity">
                    @if (business.LogoUrl is { Length: > 0 } logo)
                    {
                        <img class="card-logo" src="@logo" alt="@(business.LogoAltText ?? $"Logo de {business.Name}")"
                             width="64" height="64" loading="lazy" />
                    }
                    <span class="tag">@business.Category.Name</span>
                </div>
                <h2>@business.Name</h2>
                <p>@(string.IsNullOrWhiteSpace(business.ShortDescription) ? business.Description : business.ShortDescription)</p>
                <p><strong>@business.Municipality.Name</strong> · @business.Address</p>
                @if (business.HasScheduling) { <span class="operation-badge">Citas disponibles</span> }
                @if (business.HasVirtualQueue) { <span class="operation-badge">Turnos virtuales activos</span> }
                @if (business.HasPickupOrdering) { <span class="operation-badge">Pedidos activos</span> }
                <a class="button-link" href="@ActionUrl(business)">@ActionLabel(business)</a>
            </article>
        }
    </section>
}
@code {
    private string search = "", municipality = "", category = "";
    private string? error;
    private bool loading = true;
    private IReadOnlyList<BusinessCardDto> businesses = [];
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        loading = true; error = null;
        try { businesses = await Api.GetBusinessesAsync(search, municipality, category); }
        catch (ApiException ex) { error = ex.Message; }
        finally { loading = false; }
    }
    private static string ActionUrl(BusinessCardDto business) => business.HasPickupOrdering
        ? $"/negocios/{business.Slug}/pedidos" : business.HasVirtualQueue
        ? $"/negocios/{business.Slug}/turnos" : business.HasScheduling
        ? $"/negocios/{business.Slug}/citas" : $"/negocios/{business.Slug}";
    private static string ActionLabel(BusinessCardDto business) => business.HasPickupOrdering
        ? "Ver menú" : business.HasVirtualQueue ? "Solicitar turno"
        : business.HasScheduling ? "Ver citas disponibles" : "Ver establecimiento";
}
