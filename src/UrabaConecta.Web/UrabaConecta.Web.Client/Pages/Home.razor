@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IUrabaConectaApi Api
@inject IJSRuntime JS

<PageTitle>Ahora en Urabá | UrabáConecta</PageTitle>

<div class="ahora-home" data-testid="ahora-home">
    <header class="ahora-context">
        <button type="button" class="location-trigger" disabled="@(!interactiveReady)" @onclick="() => locationOpen = true"
                aria-haspopup="dialog" aria-expanded="@locationOpen" data-testid="location-trigger">
            <Icon Name="ubicacion" Size="16" />
            <span><small>Ahora en</small><strong>@ActiveMunicipalityName</strong></span>
            <Icon Name="chevron" Size="16" />
        </button>
        <a class="ahora-search" href="/explorar" data-enhance-nav="false">
            <Icon Name="explorar" Size="22" /><span>Buscar</span>
        </a>
    </header>

    <nav class="feed-filters" aria-label="Filtrar lo que pasa ahora" data-testid="feed-filters">
        @foreach (var filter in Filters)
        {
            <button type="button" class="@(activeVertical == filter.Key ? "active" : null)"
                    disabled="@(!interactiveReady)" aria-pressed="@(activeVertical == filter.Key)"
                    @onclick="() => SelectFilter(filter.Key)">
                @filter.Label
            </button>
        }
    </nav>

    @if (loading)
    {
        <main class="feed-column" aria-busy="true">
            <article class="feed-piece feed-primary skeleton-feed"><span class="skeleton"></span></article>
        </main>
    }
    else if (error is not null)
    {
        <p class="error ahora-error" role="alert">@error</p>
    }
    else
    {
        <div class="ahora-layout">
            @* La clave compuesta es lo que produce el crossfade del Design Spec: al cambiar de
               municipio o de filtro, Blazor descarta la columna y monta otra, así que la animación
               de entrada vuelve a correr sin que nadie la dispare a mano. El modelo de navegación
               no se toca: sigue siendo la misma pantalla. *@
            <main class="feed-column" aria-label="Qué puedes hacer ahora" data-testid="live-feed"
                  @key="@($"{activeMunicipality}|{activeVertical}")" data-swap="@lastSwap">
                @if (VisiblePieces.Count == 0)
                {
                    <section class="quiet-feed">
                        <Icon Name="reloj" Size="30" />
                        <h1>¿Buscas algo en @ActiveMunicipalityName?</h1>
                        <p>No hay novedades útiles con este filtro ahora mismo. Prueba otra categoría o todo Urabá.</p>
                        <button type="button" class="secondary" @onclick="ClearFilters">Ver todo Urabá</button>
                    </section>
                }
                else
                {
                    @foreach (var piece in VisiblePieces)
                    {
                        if (piece.Kind == FeedKind.Capture)
                        {
                            <article class="capture-piece feed-entry" data-testid="business-capture">
                                <span class="capture-mark"><Icon Name="tienda" Size="28" /></span>
                                <div><p class="eyebrow">Para negocios</p><h2>¿Tienes un negocio en Urabá?</h2>
                                <p>Así podría verse aquí: con fotos, estado y una acción clara.</p></div>
                                <a class="button-link secondary" href="/para-negocios">Quiero aparecer</a>
                            </article>
                        }
                        else
                        {
                            <article class="feed-piece feed-entry @(piece.IsPrimary ? "feed-primary" : null)"
                                     data-vertical="@piece.Vertical" data-testid="feed-piece">
                                <a class="feed-media feed-business-link @(piece.ImageUrl is null ? "feed-art" : null)"
                                   href="@piece.Url" aria-label="@piece.CtaLabel" data-enhance-nav="false">
                                    @if (piece.ImageUrl is { Length: > 0 } image)
                                    {
                                        <img src="@image" alt="@piece.ImageAlt" width="760" height="620"
                                             loading="@(piece.IsPrimary ? "eager" : "lazy")"
                                             fetchpriority="@(piece.IsPrimary ? "high" : "auto")" />
                                    }
                                    else
                                    {
                                        <span class="feed-art-icon"><Icon Name="@piece.Icon" Size="72" /></span>
                                    }
                                    <span class="feed-shade" aria-hidden="true"></span>
                                    @* Tres distintivos y no hay un cuarto. "Promoción" decía qué
                                       era la pieza, no qué le pasa a quien la mira: lo que importa
                                       de una promoción es que se puede aprovechar hoy. *@
                                    <span class="feed-badges">
                                        @if (piece.IsLive) { <span class="live-badge"><i></i> EN VIVO</span> }
                                        @if (piece.IsSponsored) { <span class="sponsored-badge">Patrocinado</span> }
                                        @if (piece.IsPromotion) { <span class="promotion-badge">Hoy</span> }
                                    </span>
                                    <span class="feed-overlay-copy">
                                        <small>@piece.BusinessLine</small>
                                        <strong>@piece.VisualStatus</strong>
                                    </span>
                                </a>
                                <div class="feed-copy">
                                    <p class="feed-question">@piece.Question</p>
                                    <h1>@piece.Headline</h1>
                                    <p class="feed-state @(piece.IsLive ? "is-live" : null)">@piece.State</p>
                                    @if (!string.IsNullOrWhiteSpace(piece.Detail)) { <p class="feed-detail">@piece.Detail</p> }
                                    <a class="feed-action feed-business-link" href="@piece.Url" data-enhance-nav="false">
                                        @piece.CtaLabel <Icon Name="flecha" Size="16" />
                                    </a>
                                </div>
                            </article>
                        }
                    }
                    @if (!showAll && FilteredPieces.Count > InitialCount)
                    {
                        <button type="button" class="feed-more" @onclick="() => showAll = true">Ver más de Urabá</button>
                    }
                }
            </main>

            <aside class="ahora-rail" aria-label="Contexto local">
                <section><p class="eyebrow">En vivo</p><strong>@LiveCount</strong><span>@(LiveCount == 1 ? "estado activo" : "estados activos")</span></section>
                <section><p class="eyebrow">Hoy</p><strong>@ActionableCount</strong><span>opciones con acción directa</span></section>
                @* El nombre del municipio no es un dato operativo, así que no se pinta de ámbar:
                   el ámbar es para el número que se verifica. *@
                <section><p class="eyebrow">Tu lugar</p><strong class="rail-place">@ActiveMunicipalityName</strong><button type="button" class="inline-button" @onclick="() => locationOpen = true">Cambiar</button></section>
                <a class="rail-activity" href="/seguimiento"><Icon Name="actividad" Size="22" /><span><strong>Mi actividad</strong><small>Turnos, citas y pedidos</small></span></a>
            </aside>
        </div>
    }
</div>

@if (locationOpen)
{
    <div class="location-backdrop" @onclick="() => locationOpen = false" aria-hidden="true"></div>
    <section class="location-sheet" role="dialog" aria-modal="true" aria-labelledby="location-title" data-testid="location-sheet">
        <header><div><p class="eyebrow">Tu zona</p><h2 id="location-title">¿Dónde estás buscando?</h2></div>
            <button type="button" class="sheet-close" aria-label="Cerrar" @onclick="() => locationOpen = false">×</button></header>
        <button type="button" class="use-location" disabled="@locating" @onclick="UseLocation">
            <Icon Name="ubicacion" Size="22" /><span><strong>@(locating ? "Ubicándote…" : "Usar mi ubicación")</strong><small>Sólo preguntaremos al tocar aquí</small></span>
        </button>
        @if (locationMessage is not null) { <p class="meta" role="status">@locationMessage</p> }
        <div class="location-options">
            @foreach (var municipality in Municipalities)
            {
                <button type="button" class="@(activeMunicipality == municipality.Slug ? "active" : null)"
                        @onclick="() => SelectMunicipality(municipality.Slug, municipality.Name)">
                    <Icon Name="@municipality.Icon" Size="22" /><span>@municipality.Name</span>
                    @if (activeMunicipality == municipality.Slug) { <Icon Name="check" Size="16" /> }
                </button>
            }
            <button type="button" class="@(activeMunicipality.Length == 0 ? "active" : null)"
                    @onclick="SelectAllMunicipalities">
                <Icon Name="ubicacion" Size="22" /><span>Todo Urabá</span>
                @if (activeMunicipality.Length == 0) { <Icon Name="check" Size="16" /> }
            </button>
        </div>
    </section>
}

@code {
    private const int InitialCount = 8;
    /// <summary>Jornadas que se miran buscando el próximo horario libre. Eran cuatro y siguen siendo cuatro.</summary>
    private const int AvailabilityDays = 4;
    private static readonly TimeZoneInfo Colombia = TimeZoneInfo.FindSystemTimeZoneById("America/Bogota");
    private static readonly FilterOption[] Filters =
    [
        new("ahora", "Ahora"), new("barberia", "Barbería"), new("belleza", "Belleza"),
        new("tienda", "Tienda")
    ];
    private static readonly MunicipalityOption[] Municipalities =
    [
        new("apartado", "Apartadó", "palmera", 7.8828, -76.6259),
        new("carepa", "Carepa", "hoja", 7.7585, -76.6525),
        new("chigorodo", "Chigorodó", "montana", 7.6664, -76.6811),
        new("turbo", "Turbo", "ola", 8.0926, -76.7282)
    ];

    private readonly List<FeedPiece> pieces = [];
    private IJSObjectReference? module;
    private string activeMunicipality = "";
    private string activeMunicipalityName = "Todo Urabá";
    private string activeVertical = "ahora";
    private string? error, locationMessage;
    /// <summary>
    /// Qué provocó el último cambio del feed. El municipio entra desde abajo y el filtro se funde:
    /// son dos gestos distintos y el Design Spec les da dos entradas distintas.
    /// </summary>
    private string lastSwap = "filter";
    private bool loading = true, locationOpen, locating, showAll, interactiveReady;

    private string ActiveMunicipalityName => activeMunicipality.Length == 0 ? "Todo Urabá" : activeMunicipalityName;
    private IReadOnlyList<FeedPiece> FilteredPieces => pieces.Where(piece =>
            (piece.Kind == FeedKind.Capture || activeMunicipality.Length == 0 ||
                piece.MunicipalitySlug.Equals(activeMunicipality, StringComparison.OrdinalIgnoreCase)) &&
            (activeVertical == "ahora" || piece.Vertical == activeVertical) &&
            (!piece.IsSponsored || activeVertical == "ahora" && activeMunicipality.Length == 0))
        .ToArray();
    private IReadOnlyList<FeedPiece> VisiblePieces => FilteredPieces.Take(showAll ? 10 : InitialCount).ToArray();
    private int LiveCount => FilteredPieces.Count(x => x.IsLive);
    private int ActionableCount => FilteredPieces.Count(x => x.Kind == FeedKind.Business);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var businesses = await Api.GetBusinessesAsync();
            var promotions = await Api.GetPublicPromotionsAsync();
            // La ficha completa sólo se pide donde de verdad se leen sus servicios. Una tienda no
            // aporta ninguna pieza a partir de su lista de servicios —sus piezas salen de la carta—
            // así que traerse su ficha era una lectura entera para no mirarla.
            var profiles = new Dictionary<string, BusinessProfileDto>(StringComparer.OrdinalIgnoreCase);
            foreach (var business in businesses.Where(x => !x.HasPickupOrdering))
                if (await Api.GetBusinessAsync(business.Slug) is { } profile) profiles[business.Slug] = profile;

            await BuildPrimaryPieces(businesses, profiles);
            BuildEditorialPieces(businesses, profiles);
            BuildPromotionPieces(promotions);
            InsertCaptureAndSponsored(businesses);
        }
        catch (ApiException ex) { error = ex.Message; }
        catch (Exception) { error = "No pudimos cargar lo que está pasando en Urabá. Intenta nuevamente."; }
        finally { loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Home.razor.js");
            var preferred = await module.InvokeAsync<HomePreference?>("initialize");
            if (!string.IsNullOrWhiteSpace(preferred?.Municipality) &&
                Municipalities.FirstOrDefault(x => x.Slug == preferred.Municipality) is { } place)
            {
                activeMunicipality = place.Slug; activeMunicipalityName = place.Name; StateHasChanged();
            }
            if (preferred?.Vertical is { Length: > 0 } vertical && Filters.Any(x => x.Key == vertical))
                activeVertical = vertical;
        }
        catch (JSException) { }
        finally
        {
            interactiveReady = true;
            StateHasChanged();
        }
    }

    private async Task BuildPrimaryPieces(IReadOnlyList<BusinessCardDto> businesses,
        IReadOnlyDictionary<string, BusinessProfileDto> profiles)
    {
        var primaryPieces = new List<FeedPiece>();
        foreach (var business in businesses.Where(x => x.HasVirtualQueue).OrderBy(ShowcasePriority))
        {
            QueuePublicStatusDto? queue = null;
            try { queue = await Api.GetPublicQueueAsync(business.Slug); } catch (ApiException) { }
            var live = queue?.SessionStatus == "Open";
            var waiting = queue?.WaitingCount ?? 0;
            var wait = queue?.ApproximateWaitMinutes ?? 0;
            primaryPieces.Add(new FeedPiece(FeedKind.Business, "barberia", business.Municipality.Slug,
                business.CoverUrl, business.CoverAltText ?? $"Interior de {business.Name}", "tijeras",
                "¿Necesitas un corte hoy?", live ? $"{CleanName(business.Name)} tiene la fila abierta" :
                    $"¿A qué hora abre {CleanName(business.Name)}?",
                live ? $"{waiting} esperando · {(wait == 0 ? "pasa ahora" : $"~{wait} min")}" : CalmState(business),
                $"Barbería · {business.Municipality.Name}", "Tomar turno", $"/negocios/{business.Slug}/turnos",
                live, false, false, true));
        }

        foreach (var business in businesses.Where(x => x.HasScheduling && !x.HasVirtualQueue)
                     .OrderBy(ShowcasePriority))
        {
            if (!profiles.TryGetValue(business.Slug, out var profile) || profile.Services.Count == 0) continue;
            var service = profile.Services.OrderBy(x => x.DisplayOrder).First();
            var availability = await FindAvailability(business.Slug, service.Id);
            primaryPieces.Add(new FeedPiece(FeedKind.Business, "belleza", business.Municipality.Slug,
                service.ImageUrl ?? business.CoverUrl, service.ImageAltText ?? business.CoverAltText ?? service.Name,
                "rostro", "¿Te quieres consentir?", availability.Count > 0
                    ? $"{CleanName(business.Name)} tiene horarios disponibles"
                    : $"Descubre el trabajo de {CleanName(business.Name)}",
                availability.Count > 0 ? $"{availability.Count} horarios {availability.When}" : CalmState(business),
                $"{service.Name} · {Money(service.ReferencePrice)} · {Duration(service.DurationMinutes)}",
                "Ver horarios", $"/negocios/{business.Slug}/citas?serviceId={service.Id}", false, false, false, false));
        }

        foreach (var business in businesses.Where(x => x.HasPickupOrdering).OrderBy(ShowcasePriority))
        {
            PickupMenuDto? menu = null; PickupSlotListDto? slots = null;
            try { menu = await Api.GetPickupMenuAsync(business.Slug); slots = await Api.GetPickupSlotsAsync(business.Slug); }
            catch (ApiException) { }
            var product = menu?.Products.FirstOrDefault(x => x.IsAvailable) ?? menu?.Products.FirstOrDefault();
            if (product is null) continue;
            var pickup = PickupText(slots?.Slots.FirstOrDefault()?.Start);
            primaryPieces.Add(ProductPiece(business, product, pickup, primary: false));
        }
        pieces.AddRange(primaryPieces.OrderBy(PrimaryPiecePriority));
    }

    private void BuildEditorialPieces(IReadOnlyList<BusinessCardDto> businesses,
        IReadOnlyDictionary<string, BusinessProfileDto> profiles)
    {
        foreach (var business in businesses.OrderBy(ShowcasePriority))
        {
            if (!profiles.TryGetValue(business.Slug, out var profile)) continue;
            var vertical = business.HasPickupOrdering ? "tienda" : business.HasVirtualQueue ? "barberia" : "belleza";
            if (!business.HasPickupOrdering)
            {
                foreach (var service in profile.Services.OrderBy(x => x.DisplayOrder).Take(3))
                    pieces.Add(new FeedPiece(FeedKind.Business, vertical, business.Municipality.Slug,
                        service.ImageUrl ?? business.CoverUrl, service.ImageAltText ?? business.CoverAltText ?? service.Name,
                        CategoryLook.Icon(business.Category.Slug), $"¿Qué te provoca hacerte?", service.Name,
                        $"{Money(service.ReferencePrice)} · {Duration(service.DurationMinutes)}",
                        $"{business.Category.Name} · {business.Municipality.Name}",
                        business.HasVirtualQueue ? "Tomar turno" : "Reservar",
                        business.HasVirtualQueue ? $"/negocios/{business.Slug}/turnos" :
                            $"/negocios/{business.Slug}/citas?serviceId={service.Id}", false, false, false, false));
            }
        }
    }

    private void BuildPromotionPieces(IReadOnlyList<BusinessPromotionDto> promotions)
    {
        var position = 4;
        foreach (var promotion in promotions.Take(2))
        {
            var vertical = Vertical(promotion.Category.Slug);
            var piece = new FeedPiece(FeedKind.Business, vertical, promotion.Municipality.Slug,
                promotion.ImageUrl, $"Promoción de {promotion.BusinessName}", CategoryLook.Icon(promotion.Category.Slug),
                "¿Aprovechas esta novedad?", promotion.Headline,
                promotion.Body, $"{promotion.BusinessName} · {promotion.Municipality.Name}", promotion.CtaLabel,
                promotion.DeepLink, false, false, true, false);
            pieces.Insert(Math.Min(position, pieces.Count), piece);
            position += 4;
        }
    }

    private void InsertCaptureAndSponsored(IReadOnlyList<BusinessCardDto> businesses)
    {
        pieces.Insert(Math.Min(3, pieces.Count), FeedPiece.Capture());
        var sponsoredBusiness = businesses.Where(x => x.HasPickupOrdering &&
                !x.Slug.Equals("lumina-coral-beauty-demo", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()
            ?? businesses.Where(x => x.HasPickupOrdering).OrderBy(ShowcasePriority).FirstOrDefault()
            ?? businesses.OrderByDescending(ShowcasePriority).FirstOrDefault();
        if (sponsoredBusiness is null) return;
        var sponsored = new FeedPiece(FeedKind.Business, Vertical(sponsoredBusiness.Category.Slug),
            sponsoredBusiness.Municipality.Slug, sponsoredBusiness.CoverUrl,
            sponsoredBusiness.CoverAltText ?? sponsoredBusiness.Name, CategoryLook.Icon(sponsoredBusiness.Category.Slug),
            "¿Quieres descubrir algo nuevo?", CleanName(sponsoredBusiness.Name),
            sponsoredBusiness.PriceFrom is { } price ? $"Desde {Money(price)}" : CalmState(sponsoredBusiness),
            $"{sponsoredBusiness.Category.Name} · {sponsoredBusiness.Municipality.Name}",
            sponsoredBusiness.HasPickupOrdering ? "Ver tienda" : "Ver negocio",
            sponsoredBusiness.HasPickupOrdering ? $"/negocios/{sponsoredBusiness.Slug}/pedidos" :
                $"/negocios/{sponsoredBusiness.Slug}", false, true, false, false);
        pieces.Insert(Math.Min(6, pieces.Count), sponsored);
    }

    private FeedPiece ProductPiece(BusinessCardDto business, ProductDto product, string pickup, bool primary)
        => new(FeedKind.Business, "tienda", business.Municipality.Slug, product.ImageUrl ?? business.CoverUrl,
            product.ImageAltText ?? business.CoverAltText ?? product.Name, "bolsa", "¿Buscas algo para hoy?",
            product.Name, product.IsAvailable ? $"{Money(product.ReferencePrice)} · {pickup}" :
                $"{Money(product.ReferencePrice)} · agotado por ahora",
            $"{CleanName(business.Name)} · {business.Municipality.Name}",
            product.IsAvailable ? "Pedir" : "Avísame cuando vuelva",
            $"/negocios/{business.Slug}/pedidos#producto-{product.Id}", false, false, false, primary);

    /// <summary>
    /// El día más cercano con horarios, dentro de los próximos cuatro. Antes se preguntaba jornada
    /// por jornada hasta encontrar una con hueco: cuatro esperas encadenadas, y cada una repetía
    /// las mismas cinco lecturas de negocio, servicio, personal y horario. Ahora es una pregunta.
    /// El resultado es el mismo, incluida la fecha elegida y el número de horarios.
    /// </summary>
    private async Task<AvailabilitySignal> FindAvailability(string slug, Guid serviceId)
    {
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Colombia).DateTime);
        try
        {
            if (await Api.FindNextAvailabilityAsync(slug, serviceId, today, AvailabilityDays) is { } found)
            {
                var offset = found.Date.DayNumber - today.DayNumber;
                return new(found.Slots.Count, offset == 0 ? "hoy" : offset == 1 ? "mañana" :
                    $"el {found.Date:dddd}");
            }
        }
        catch (ApiException) { }
        return new(0, "próximamente");
    }

    private async Task SelectFilter(string key)
    {
        activeVertical = key; showAll = false; lastSwap = "filter";
        if (module is not null)
            try { await module.InvokeVoidAsync("rememberVertical", key); } catch (JSException) { }
    }
    private async Task SelectMunicipality(string slug, string name)
    {
        activeMunicipality = slug; activeMunicipalityName = name; locationOpen = false; showAll = false;
        lastSwap = "place";
        if (module is not null) try { await module.InvokeVoidAsync("rememberMunicipality", slug); } catch (JSException) { }
    }
    private async Task UseLocation()
    {
        if (module is null) return;
        locating = true; locationMessage = null;
        try
        {
            var point = await module.InvokeAsync<LocationPoint?>("requestLocation");
            if (point is null) { locationMessage = "No pudimos usar tu ubicación. Puedes elegir un municipio."; return; }
            var nearest = Municipalities.OrderBy(x => Distance(point.Latitude, point.Longitude, x.Latitude, x.Longitude)).First();
            await SelectMunicipality(nearest.Slug, nearest.Name);
        }
        catch (JSException) { locationMessage = "La ubicación no fue autorizada. Elige un municipio para continuar."; }
        finally { locating = false; }
    }
    private async Task ClearFilters()
    {
        activeMunicipality = ""; activeMunicipalityName = "Todo Urabá"; activeVertical = "ahora"; showAll = false;
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("rememberMunicipality", "");
            await module.InvokeVoidAsync("rememberVertical", "ahora");
        }
        catch (JSException) { }
    }
    private Task SelectAllMunicipalities() => SelectMunicipality("", "Todo Urabá");

    private static double Distance(double lat1, double lon1, double lat2, double lon2)
        => Math.Pow(lat1 - lat2, 2) + Math.Pow(lon1 - lon2, 2);
    private static string Vertical(string category) => category == "barberia" ? "barberia"
        : category == "maquillaje-y-cosmeticos" ? "tienda" : "belleza";
    private static string Money(decimal value) => value.ToString("C0", new System.Globalization.CultureInfo("es-CO"));
    private static string Duration(int minutes) => minutes < 60 ? $"{minutes} min" : $"{minutes / 60} h";
    private static string PickupText(DateTimeOffset? start) => start is null ? "consulta disponibilidad"
        : TimeZoneInfo.ConvertTime(start.Value, Colombia).Date == TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Colombia).Date
            ? $"recoges hoy {TimeZoneInfo.ConvertTime(start.Value, Colombia):h:mm tt}"
            : $"recoges {TimeZoneInfo.ConvertTime(start.Value, Colombia):ddd h:mm tt}";
    private static string CalmState(BusinessCardDto business) => business.OpenStatus is { Length: > 0 } state
        ? state : "Consulta el horario de hoy";
    private static string CleanName(string name) => name.Replace(" · DEMO", "", StringComparison.OrdinalIgnoreCase);
    private static int ShowcasePriority(BusinessCardDto business)
    {
        if (business.Slug.Equals("brio-nativo-barberia-demo", StringComparison.OrdinalIgnoreCase)) return 0;
        if (business.Name.Contains("Studio Laura", StringComparison.OrdinalIgnoreCase)) return 1;
        if (business.Slug.Equals("lumina-coral-beauty-demo", StringComparison.OrdinalIgnoreCase)) return 2;
        return 10;
    }
    private static int PrimaryPiecePriority(FeedPiece piece)
    {
        if (piece.Url.Contains("brio-nativo-barberia-demo", StringComparison.OrdinalIgnoreCase)) return 0;
        if (piece.Headline.Contains("Studio Laura", StringComparison.OrdinalIgnoreCase)) return 1;
        if (piece.Url.Contains("lumina-coral-beauty-demo", StringComparison.OrdinalIgnoreCase)) return 2;
        return piece.Vertical switch { "barberia" => 10, "belleza" => 11, "tienda" => 12, _ => 20 };
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.DisposeAsync(); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    private enum FeedKind { Business, Capture }
    private sealed record FilterOption(string Key, string Label);
    private sealed record MunicipalityOption(string Slug, string Name, string Icon, double Latitude, double Longitude);
    private sealed record AvailabilitySignal(int Count, string When);
    private sealed class LocationPoint { public double Latitude { get; set; } public double Longitude { get; set; } }
    private sealed class HomePreference
    {
        public string Municipality { get; set; } = "";
        public string Vertical { get; set; } = "ahora";
    }
    private sealed record FeedPiece(FeedKind Kind, string Vertical, string MunicipalitySlug,
        string? ImageUrl, string ImageAlt, string Icon, string Question, string Headline, string State,
        string Detail, string CtaLabel, string Url, bool IsLive, bool IsSponsored, bool IsPromotion,
        bool IsPrimary)
    {
        public string BusinessLine => Detail;
        public string VisualStatus => State;
        public static FeedPiece Capture() => new(FeedKind.Capture, "ahora", "", null, "", "tienda",
            "", "", "", "", "", "", false, false, false, false);
    }
}
