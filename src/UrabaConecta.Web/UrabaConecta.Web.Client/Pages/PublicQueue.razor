@page "/negocios/{Slug}/turnos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IUrabaConectaApi Api
@inject NavigationManager Navigation

@* La fila virtual es el diferenciador de barbería, así que se ve distinta al resto del producto:
   fondo oscuro, cifras enormes y una señal que late. No es decoración —es la única pantalla de
   UrabáConecta cuyo contenido cambia solo mientras alguien la mira— y verlo moverse es lo que
   convence de que no hay que esperar de pie en el local. *@
<PageTitle>Fila virtual | UrabáConecta</PageTitle>
<a class="back-link" href="/negocios/@Slug">← Volver al negocio</a>
@if (status is null && error is null) { <p class="notice">Consultando la fila…</p> }
else if (error is not null) { <div class="error" role="alert">@error</div> }
else if (status is not null)
{
    @* El tablero cambia solo mientras alguien lo mira. Cada cifra dice hacia dónde se movió y la
       casilla que se movió se distingue de las otras dos: entre tres números grandes, un cambio
       silencioso no se ve. Se anuncia en cortesía —esto se mira de reojo desde la calle, no es una
       alarma— y el estado de la jornada se reemplaza como frase, no como número. *@
    <section class="fila-tablero" data-live-state="fila"
             data-live-etapa="@status.SessionStatus.ToLowerInvariant()">
        <header>
            <p class="eyebrow">@status.BusinessName</p>
            <h1>@status.QueueName</h1>
            <span class="fila-estado" data-live-text aria-live="polite" data-estado="@status.SessionStatus.ToLowerInvariant()">
                @SessionLabel(status.SessionStatus)
            </span>
        </header>

        <div class="fila-cifras" aria-live="polite">
            <div class="destacada" aria-atomic="true">
                <span>Atendiendo ahora</span>
                <strong data-live-value>@(status.CurrentNumber?.ToString() ?? "—")</strong>
            </div>
            <div aria-atomic="true">
                <span>@(status.WaitingCount == 1 ? "Persona esperando" : "Personas esperando")</span>
                <strong data-live-value>@status.WaitingCount</strong>
            </div>
            <div aria-atomic="true">
                <span>Espera aproximada</span>
                @* El "min" queda fuera del valor: lo que viaja es la cifra, y arrastrar la unidad
                   con ella convertiría una unidad fija en algo que también parece cambiar. *@
                <strong><span data-live-value>@status.ApproximateWaitMinutes</span><small> min</small></strong>
            </div>
        </div>

        @* Una fila de puntos por quien espera: el número dice cuántos, los puntos lo hacen sentir.
           Se acota a doce para que a partir de ahí crezca el resumen y no la tira. *@
            <p class="fila-puntos" aria-hidden="true">
                @for (var i = 0; i < Math.Min(status.WaitingCount, 12); i++) { <span></span> }
                @if (status.WaitingCount > 12) { <em>+@(status.WaitingCount - 12)</em> }
            </p>

        @if (!string.IsNullOrWhiteSpace(status.PublicMessage)) { <p class="fila-mensaje">@status.PublicMessage</p> }
    </section>
    @* EL MISMO SITIO CON OTRO PROPÓSITO. Pedir el turno y tenerlo son el mismo momento del
       recorrido ocupando el mismo hueco de la pantalla: tomar → tu número → seguirlo. Es un
       contenedor que cambia de contenido, no un formulario que se esfuma y una tarjeta que aparece
       en otro sitio, y por eso el relevo se anima una sola vez sobre el contenedor. *@
    <div data-live-state="union" data-live-swap data-live-clave="@(created is null ? "tomar" : "confirmado")">
    @if (created is null)
    {
        <EditForm Model="request" OnValidSubmit="Join" FormName="join-queue" class="config-form narrow">
            <fieldset disabled="@(!interactiveReady)">
            <DataAnnotationsValidator /><ValidationSummary />
            <h2>Tomar un turno</h2>
            <label>Alias corto (opcional) <InputText @bind-Value="request.Alias" maxlength="40" /></label>
            <p class="meta">No pedimos nombre completo, teléfono ni documento.</p>
            <label class="check">
                <InputCheckbox @bind-Value="request.ConsentAccepted" />
                Acepto que este alias se use para gestionar mi turno y anunciar el llamado.
            </label>
            <p class="meta">
                Consulta la <a href="/legal/politica-de-datos" target="_blank">política de tratamiento de datos</a>
                y el <a href="/legal/aviso-de-privacidad" target="_blank">aviso de privacidad</a>.
                Guardamos la fecha de tu aceptación y la versión vigente de la política.
            </p>
            <button class="primary btn-grande" disabled="@(!interactiveReady || !status.CanJoin || busy)">Tomar turno</button>
            </fieldset>
        </EditForm>
    }
    else
    {
        @* Lo primero que quiere ver quien acaba de entrar a la fila es su número, grande. *@
        <section class="fila-tablero confirmado narrow" data-testid="queue-created">
            <p class="eyebrow">@status.BusinessName</p>
            <h2>Estás en la fila</h2>
            <span class="ticket-number">@created.Number</span>
            <p class="lead">
                @if (created.PeopleAhead == 0) { <text>Eres el siguiente.</text> }
                else
                {
                    <text>Hay @created.PeopleAhead @(created.PeopleAhead == 1 ? "persona" : "personas") antes que tú,
                    unos @created.ApproximateWaitMinutes minutos de espera.</text>
                }
            </p>
            <p class="fila-mensaje">Sigue tu turno desde el celular. Te avisamos cuando falte poco;
                no tienes que esperar en el local.</p>
            <a class="button-link btn-grande" href="/seguimiento/turnos/@created.TrackingCode">Seguir mi turno</a>
        </section>
    }
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private QueuePublicStatusDto? status;
    private QueueTicketCreatedDto? created;
    private CreateQueueTicketRequest request = new();
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? hub;
    private string? error;
    private bool busy, interactiveReady;
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        // El formulario declara la versión que mostró; el servidor rechaza cualquier otra.
        try { request.ConsentNoticeVersion = (await Api.GetLegalInfoAsync()).PolicyVersion; }
        catch (ApiException) { }
        await Load();
        if (hub is not null) await hub.DisposeAsync();
        hub = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/queue")).WithAutomaticReconnect().Build();
        // The event for our own Join can arrive before JoinAsync returns on a remote database.
        // Join already refreshes after its write completes; avoid a redundant read while it is busy.
        hub.On("QueueChanged", () => InvokeAsync(async () =>
        {
            if (busy) return;
            await Load();
            StateHasChanged();
        }));
        hub.Reconnected += async _ =>
        {
            await hub.InvokeAsync("SubscribePublic", Slug);
            await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        };
        try { await hub.StartAsync(); await hub.InvokeAsync("SubscribePublic", Slug); await Load(); } catch { /* HTTP remains source of truth. */ }
    }
    private async Task Load()
    {
        error = null;
        try { status = await Api.GetPublicQueueAsync(Slug); if (status is null) error = "La fila virtual no está disponible."; }
        catch (ApiException ex) { error = ex.Message; }
    }
    private async Task Join()
    {
        busy = true; error = null;
        try { created = await Api.JoinQueueAsync(Slug, request); await Load(); }
        catch (ApiException ex) { error = ex.Message; await Load(); }
        finally { busy = false; }
    }
    private static string SessionLabel(string value) => value switch
    { "Open" => "Abierta", "Paused" => "Pausada", _ => "Cerrada" };
    public async ValueTask DisposeAsync() { if (hub is not null) await hub.DisposeAsync(); }
}
