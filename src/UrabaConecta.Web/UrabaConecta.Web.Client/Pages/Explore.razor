@page "/explorar"
@page "/categorias/{Categoria}"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api
@inject NavigationManager Nav

@* El directorio completo, con los tres filtros trabajando juntos.

   Una misma pantalla sirve /explorar y /categorias/{slug}: llegar por una categoría es exactamente
   explorar con un filtro ya puesto, y mantener dos pantallas gemelas garantizaba que una de las dos
   se quedara atrás.

   El estado vive en la dirección, no en el componente. Así una búsqueda se puede compartir por
   WhatsApp, el botón atrás deshace un filtro en vez de salir del sitio, y recargar no borra lo que
   la persona había elegido. *@
<PageTitle>@Titulo | UrabáConecta</PageTitle>

<section class="explorar-head">
    <h1>@Titulo</h1>
    <p class="hero-sub">@Bajada</p>
</section>

<fieldset class="search-panel directory-search" aria-label="Buscar y filtrar por municipio" disabled="@(!listo)">
    <label>Qué buscas
        <input @bind-value="termino" @bind-value:event="oninput" @onkeydown="AlTeclear"
               placeholder="Nombre del negocio…" autocomplete="off" />
    </label>
    <label>Municipio
        <select @bind="municipio" @bind:after="Aplicar">
            <option value="">Todos</option>
            @foreach (var (slug, nombre) in Municipios) { <option value="@slug">@nombre</option> }
        </select>
    </label>
    <button class="primary" @onclick="Aplicar" disabled="@(!listo || cargando)">
        @(cargando ? "Buscando…" : "Buscar")
    </button>
</fieldset>

@* La categoría se elige viendo su identidad, no leyendo un select. La tira conserva el municipio
   y la búsqueda actuales, así los tres filtros siguen componiéndose en una sola dirección. *@
@if (categorias.Count > 0)
{
    <div class="category-filter" role="group" aria-label="Filtrar por categoría">
        <span class="filter-label">Categoría</span>
        <div class="chip-row">
            <button type="button" class="categoria-chip category-all" aria-pressed="@(categoria == "")"
                    disabled="@(!listo || cargando)" @onclick='() => AplicarCategoria("")'>
                <span class="marca-icono"><Icon Name="explorar" Size="17" /></span> Todas
            </button>
            @foreach (var opcion in categorias)
            {
                <button type="button" class="categoria-chip" data-tono="@CategoryLook.Tone(opcion.Slug)"
                        aria-pressed="@(categoria == opcion.Slug)" disabled="@(!listo || cargando)"
                        @onclick="() => AplicarCategoria(opcion.Slug)">
                    <span class="marca-icono"><Icon Name="@CategoryLook.Icon(opcion.Slug)" Size="17" /></span>
                    @opcion.Name
                </button>
            }
        </div>
    </div>
}

@* Los filtros puestos, visibles y reversibles de un toque. Sin esto, quien llegaba por una
   categoría no tenía cómo saber por qué faltaban negocios que sí existen. *@
@if (Activos.Count > 0)
{
    <div class="filtros-activos" role="group" aria-label="Filtros aplicados">
        @foreach (var filtro in Activos)
        {
            <button type="button" class="filtro-quitar" @onclick="() => Quitar(filtro.Clave)">
                @filtro.Etiqueta <span aria-hidden="true">×</span>
                <span class="visually-hidden">Quitar filtro</span>
            </button>
        }
        <button type="button" class="tertiary" @onclick="LimpiarTodo">Limpiar todo</button>
    </div>
}

@if (cargando)
{
    <div class="card-grid" aria-hidden="true">
        @for (var i = 0; i < 6; i++)
        {
            <div class="skeleton-card">
                <div class="skeleton skeleton-media"></div>
                <div class="skeleton skeleton-linea"></div>
                <div class="skeleton skeleton-linea corta"></div>
            </div>
        }
    </div>
    <p class="visually-hidden" role="status">Buscando negocios…</p>
}
else if (error is not null)
{
    <p class="error" role="alert">@error</p>
}
else if (negocios.Count == 0)
{
    <div class="empty">
        <h2>No encontramos negocios con esa búsqueda</h2>
        <p class="meta">Prueba con otro nombre, cambia de municipio o mira todo Urabá.</p>
        <button type="button" class="secondary" @onclick="LimpiarTodo">Ver todos los negocios</button>
    </div>
}
else
{
    <div class="resultados-head">
        <h2 aria-live="polite">@negocios.Count @(negocios.Count == 1 ? "negocio" : "negocios") @Ambito</h2>
    </div>
    <div class="card-grid">
        @foreach (var (negocio, indice) in negocios.Select((x, i) => (x, i)))
        {
            <BusinessCard Business="negocio" Priority="indice == 0" />
        }
    </div>
}

@code {
    /// <summary>Llega por la ruta /categorias/{slug}; en /explorar es nulo.</summary>
    [Parameter] public string? Categoria { get; set; }

    [SupplyParameterFromQuery(Name = "q")] public string? BusquedaUrl { get; set; }
    [SupplyParameterFromQuery(Name = "municipio")] public string? MunicipioUrl { get; set; }
    [SupplyParameterFromQuery(Name = "categoria")] public string? CategoriaUrl { get; set; }

    private string termino = "", municipio = "", categoria = "";
    private string? error;
    private bool cargando = true, listo;
    private IReadOnlyList<BusinessCardDto> negocios = [];
    private IReadOnlyList<CategoryCardDto> categorias = [];

    private static readonly (string Slug, string Nombre)[] Municipios =
    [
        ("apartado", "Apartadó"), ("carepa", "Carepa"), ("chigorodo", "Chigorodó"), ("turbo", "Turbo"),
    ];

    private string NombreCategoria
        => categorias.FirstOrDefault(x => x.Slug == categoria)?.Name ?? "";

    private string Titulo => categoria is { Length: > 0 } && NombreCategoria is { Length: > 0 } nombre
        ? nombre : "Explorar negocios";

    private string Bajada => categoria is { Length: > 0 } && NombreCategoria is { Length: > 0 }
        ? "Filtra por municipio o busca por nombre."
        : "Busca por nombre, filtra por municipio y por categoría.";

    private string Ambito => Municipios.FirstOrDefault(x => x.Slug == municipio) is { Nombre: { } nombre }
        ? $"en {nombre}" : "en Urabá";

    private sealed record FiltroActivo(string Clave, string Etiqueta);

    private List<FiltroActivo> Activos
    {
        get
        {
            var lista = new List<FiltroActivo>();
            if (!string.IsNullOrWhiteSpace(termino)) lista.Add(new("q", $"“{termino.Trim()}”"));
            if (Municipios.FirstOrDefault(x => x.Slug == municipio) is { Nombre: { } m })
                lista.Add(new("municipio", m));
            if (categoria is { Length: > 0 } && NombreCategoria is { Length: > 0 } c)
                lista.Add(new("categoria", c));
            return lista;
        }
    }

    /// <summary>
    /// Se ejecuta también al cambiar de dirección sin recargar, que es lo que ocurre al tocar una
    /// categoría desde la Home estando ya aquí: sin esto la pantalla conservaba el filtro anterior.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var nuevoTermino = BusquedaUrl?.Trim() ?? "";
        var nuevoMunicipio = MunicipioUrl ?? "";
        // La categoría de la ruta manda sobre la del parámetro: /categorias/barberia es explícito.
        var nuevaCategoria = Categoria ?? CategoriaUrl ?? "";
        if (categorias.Count > 0 && nuevoTermino == termino && nuevoMunicipio == municipio
            && nuevaCategoria == categoria) return;
        (termino, municipio, categoria) = (nuevoTermino, nuevoMunicipio, nuevaCategoria);
        await Cargar();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Sólo corre en el circuito: es la señal fiable de que los controles ya responden. Un filtro
        // que parece funcionar antes de conectar descarta el clic sin avisar.
        if (!firstRender) return;
        listo = true;
        StateHasChanged();
    }

    private async Task Cargar()
    {
        cargando = true; error = null;
        try
        {
            // Secuencial a propósito: con InteractiveServer ambas lecturas comparten el
            // AppDbContext del circuito y lanzarlas en paralelo lo rompe.
            if (categorias.Count == 0) categorias = await Api.GetCategoriesAsync();
            negocios = await Api.GetBusinessesAsync(termino, municipio, categoria);
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    private async Task AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Aplicar();
    }

    /// <summary>
    /// Aplicar no consulta: reescribe la dirección, y es el cambio de dirección el que dispara la
    /// carga. Con una sola fuente de verdad, el botón atrás y el estado de la pantalla no pueden
    /// contradecirse.
    /// </summary>
    private Task Aplicar()
    {
        Nav.NavigateTo(Direccion(termino, municipio, categoria));
        return Task.CompletedTask;
    }

    private void AplicarCategoria(string slug)
    {
        categoria = slug;
        Nav.NavigateTo(Direccion(termino, municipio, categoria));
    }

    private void Quitar(string clave) => Nav.NavigateTo(Direccion(
        clave == "q" ? "" : termino,
        clave == "municipio" ? "" : municipio,
        clave == "categoria" ? "" : categoria));

    private void LimpiarTodo() => Nav.NavigateTo("/explorar");

    /// <summary>
    /// Con categoría se usa su ruta propia, que es la que se puede compartir y la que describe la
    /// pantalla; el resto viaja como parámetros.
    /// </summary>
    private static string Direccion(string q, string municipio, string categoria)
    {
        var parametros = new List<string>();
        if (!string.IsNullOrWhiteSpace(q)) parametros.Add($"q={Uri.EscapeDataString(q.Trim())}");
        if (!string.IsNullOrWhiteSpace(municipio)) parametros.Add($"municipio={Uri.EscapeDataString(municipio)}");
        var baseRuta = string.IsNullOrWhiteSpace(categoria)
            ? "/explorar" : $"/categorias/{Uri.EscapeDataString(categoria)}";
        return parametros.Count == 0 ? baseRuta : $"{baseRuta}?{string.Join('&', parametros)}";
    }
}
