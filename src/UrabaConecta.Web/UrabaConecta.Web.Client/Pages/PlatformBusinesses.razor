@page "/admin/negocios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PlatformAdmin,PartnerOperator")]
@inject IUrabaConectaApi Api

<PageTitle>Negocios Fundadores | UrabáConecta</PageTitle>
<div class="title-actions panel-header">
    <div>
        <p class="eyebrow">Cohorte fundadora</p>
        <h1>Negocios Fundadores</h1>
        <p class="meta">Alta, preparación y publicación de cada negocio.</p>
    </div>
    <a class="button-link primary" href="/admin/negocios/nuevo">Crear negocio</a>
</div>
<fieldset class="filters" disabled="@(!interactiveReady)">
    <label>Buscar<input @bind="search" /></label>
    @* El desplegable ofrecía los valores internos —Draft, PendingConfiguration— tal cual salían
       del modelo. La socia no habla ese idioma. *@
    <label>Estado<select @bind="status">
        <option value="">Todos</option>
        <option value="Draft">Borrador</option>
        <option value="PendingConfiguration">Configuración pendiente</option>
        <option value="Active">Activo</option>
        <option value="Suspended">Suspendido</option>
        <option value="Archived">Archivado</option>
    </select></label>
    <label>Función<select @bind="module"><option value="">Todas</option><option value="Appointments">Citas</option><option value="VirtualQueues">Turnos</option><option value="PickupOrders">Pedidos</option></select></label>
    <button class="secondary" @onclick="Load" disabled="@(!interactiveReady || loading)">
        @(loading ? "Filtrando…" : "Filtrar")
    </button>
    @if (!interactiveReady) { <p class="notice" role="status">Preparando los filtros…</p> }
</fieldset>
@if (data is null) { <p class="notice">Cargando…</p> }
else if (data.Items.Count == 0) { <div class="empty">No hay negocios con estos filtros.</div> }
else
{
    <div class="card-grid">
        @foreach (var item in data.Items)
        {
            <article class="business-card">
                <div class="card-encabezado">
                    <BusinessMark Name="@item.Name" />
                    <div>
                        <h2>@item.Name</h2>
                        <p class="meta">@item.Municipality · @item.Category</p>
                    </div>
                    <span class="status @BusinessStatusText.CssModifier(item.Status)">@State(item.Status)</span>
                </div>
                <p class="meta">Responsable: @(item.OwnerName ?? "Sin asignar")</p>
                <p class="meta">@string.Join(" · ", item.Modules.Select(Module))</p>
                <p class="@(item.IsReady ? "success" : "notice")">
                    @(item.IsReady ? "Listo para publicarse." : "Todavía le falta configuración.")</p>
                <a class="button-link secondary" href="/admin/negocios/@item.Id">Revisar</a>
            </article>
        }
    </div>
}
@code {
    private PlatformBusinessListDto? data;
    private string? search, status, module;
    private bool loading, interactiveReady;
    protected override Task OnInitializedAsync() => Load();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    private async Task Load()
    {
        loading = true;
        try { data = await Api.GetPlatformBusinessesAsync(search, null, status, module); }
        finally { loading = false; }
    }
    private static string State(string value) => value switch
    {
        "Draft" => "Borrador", "PendingConfiguration" => "Configuración pendiente", "Active" => "Activo",
        "Suspended" => "Suspendido", "Archived" => "Archivado", _ => value
    };
    private static string Module(string value) => value switch
    { "Appointments" => "Citas", "VirtualQueues" => "Turnos", "PickupOrders" => "Pedidos", _ => value };
}
