@page "/panel/{BusinessId:guid}/configuracion"
@rendermode InteractiveServer
@attribute [Authorize]
@inject BusinessAccess Access

<PageTitle>Configuración del negocio | UrabáConecta</PageTitle>
<a class="back-link" href="/panel">← Mis negocios</a>
<div class="panel-header">
    <p class="eyebrow">Panel del negocio</p>
    <h1>Configuración del negocio</h1>
    <p class="meta">Lo que configuras aquí es lo que ven tus clientes en la ficha pública.</p>
</div>

@if (loading)
{
    <p class="notice" aria-live="polite">Cargando configuración…</p>
}
else if (error is not null)
{
    <p class="error" role="alert">@error</p>
}
else if (business is not null)
{
    <div class="config-business"><span class="tag">Negocio</span><strong>@business.Name</strong></div>
    <ConfigurationNav BusinessId="BusinessId" ShowOwnerSections="business.IsOwner" />
    @* Las tarjetas salen de las capacidades del negocio, no de la categoría ni de una lista fija.
       Antes esta rejilla ofrecía Servicios, Personal, Horarios y Excepciones a todo el mundo: una
       droguería que sólo despacha pedidos veía cuatro pantallas que no le sirven, y el número de
       orden mentía sobre cuántos pasos le faltaban de verdad. *@
    <div class="config-grid">
        @{ var paso = 0; }
        @foreach (var card in Cards(business))
        {
            paso++;
            <a class="config-card" href="@card.Href" data-testid="@card.TestId">
                <span>@paso.ToString("00")</span><h2>@card.Title</h2><p>@card.Description</p>
            </a>
        }
    </div>
    @if (!business.Capabilities.HasAnyOperation)
    {
        <div class="empty" data-testid="config-sin-capacidades">
            <h2>Este negocio todavía no tiene funciones activas</h2>
            <p>Citas, turnos y pedidos se habilitan desde la administración de la plataforma.</p>
            <p class="meta">Escribe a quien te dio de alta para que active lo que necesitas.</p>
        </div>
    }
}

@code {
    [Parameter] public Guid BusinessId { get; set; }
    private MyBusinessDto? business;
    private bool loading = true;
    private string? error;

    private sealed record ConfigCard(string Href, string Title, string Description, string TestId);

    /// <summary>
    /// Una sección aparece cuando el negocio tiene la capacidad Y la persona el permiso. El orden es
    /// el del recorrido real: primero lo que ve el cliente, después lo que sostiene la operación.
    /// </summary>
    private IEnumerable<ConfigCard> Cards(MyBusinessDto b)
    {
        if (b.IsOwner)
        {
            yield return new($"/panel/{BusinessId}/configuracion/perfil", "Perfil",
                "Descripciones, contacto y ubicación que ven tus clientes.", "config-perfil");
            yield return new($"/panel/{BusinessId}/configuracion/imagenes", "Imágenes",
                "Logo, portada y galería de tu ficha pública.", "config-imagenes");
        }
        if (b.ShowServices)
            yield return new($"/panel/{BusinessId}/configuracion/servicios", "Servicios",
                "Oferta, duración, precio y publicación.", "config-servicios");
        if (b.ShowProducts)
            yield return new($"/panel/{BusinessId}/configuracion/pedidos", "Catálogo y pedidos",
                "Productos, precios, franjas y capacidad.", "config-pedidos");
        if (b.ShowStaff)
            yield return new($"/panel/{BusinessId}/configuracion/personal", "Personal",
                "Perfiles operativos y servicios que prestan.", "config-personal");
        if (b.ShowSchedule)
        {
            yield return new($"/panel/{BusinessId}/configuracion/horarios", "Horarios",
                "Apertura habitual por día, hora de Colombia.", "config-horarios");
            yield return new($"/panel/{BusinessId}/configuracion/excepciones", "Excepciones",
                "Cierres y aperturas para fechas concretas.", "config-excepciones");
        }
        if (b.ShowQueues)
            yield return new($"/panel/{BusinessId}/configuracion/turnos", "Turnos",
                "Nombre, capacidad, duración y publicación de la fila.", "config-turnos");
        yield return new($"/panel/{BusinessId}/avisos", "Avisos",
            "Lo que pasó en tu negocio, aunque el aviso del teléfono no llegara.", "config-avisos");
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = null;
        try
        {
            business = await Access.ForAsync(BusinessId);
            if (business is null) error = "No tiene acceso a este establecimiento.";
            else if (!business.CanManageConfiguration) error = "No tiene permiso para cambiar la configuración.";
        }
        catch (ApiException ex) { error = Friendly(ex); }
        finally { loading = false; }
    }

    private static string Friendly(ApiException ex) => ex.StatusCode is 401 or 403 or 404
        ? "No tiene acceso a este establecimiento." : ex.Message;
}
