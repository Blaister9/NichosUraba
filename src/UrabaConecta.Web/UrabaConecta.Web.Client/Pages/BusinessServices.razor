@page "/panel/{BusinessId:guid}/configuracion/servicios"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IUrabaConectaApi Api

<PageTitle>Servicios | Configuración UrabáConecta</PageTitle>
<a class="back-link" href="/panel/@BusinessId/configuracion">← Configuración</a>
<p class="eyebrow">Configuración del negocio</p><h1>Servicios</h1>
<ConfigurationNav BusinessId="BusinessId" />

@if (loading) { <p class="notice" aria-live="polite">Cargando servicios…</p> }
else if (error is not null) { <p class="error" role="alert">@error <button class="inline-button" @onclick="Load">Recargar</button></p> }
else
{
    @if (message is not null) { <p class="success" role="status">@message</p> }
    <section class="config-form">
        <h2>@(editingId.HasValue ? "Editar servicio" : "Nuevo servicio")</h2>
        <EditForm Model="form" OnValidSubmit="Save" FormName="service-configuration">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label>Nombre<InputText @bind-Value="form.Name" maxlength="120" data-testid="service-name" /><ValidationMessage For="() => form.Name" /></label>
                <label>Descripción corta<InputText @bind-Value="form.Description" maxlength="500" /></label>
                <label>Duración en minutos<InputNumber @bind-Value="form.DurationMinutes" min="5" max="480" /></label>
                <label>Precio de referencia (COP)<InputNumber @bind-Value="form.ReferencePrice" min="0" step="1000" /></label>
                <label>Orden de visualización<InputNumber @bind-Value="form.DisplayOrder" min="0" /></label>
                @if (editingId.HasValue)
                {
                    <label class="switch-row"><InputCheckbox @bind-Value="form.IsActive" /> Disponible para nuevas citas</label>
                }
            </div>
            <fieldset class="deposit-fields">
                <legend>Adelanto</legend>
                <p class="meta">
                    UrabáConecta no cobra ni recibe dinero. Calcula el adelanto, se lo muestra al cliente y
                    genera un enlace de WhatsApp para que le envíe el comprobante a usted.
                </p>
                <label class="switch-row">
                    <InputCheckbox @bind-Value="form.RequiresDeposit" data-testid="requires-deposit" />
                    Este servicio exige adelanto
                </label>
                @if (form.RequiresDeposit)
                {
                    <div class="form-grid">
                        <label>Tipo de adelanto<InputSelect @bind-Value="form.DepositType" data-testid="deposit-type">
                            <option value="FixedAmount">Valor fijo en pesos</option>
                            <option value="Percentage">Porcentaje del precio</option>
                        </InputSelect></label>
                        <label>@(form.DepositType == "Percentage" ? "Porcentaje (1 a 100)" : "Valor del adelanto (COP)")
                            <InputNumber @bind-Value="form.DepositValue" min="1" data-testid="deposit-value" /></label>
                        <label>WhatsApp que recibe los comprobantes
                            <InputText @bind-Value="form.DepositWhatsAppNumber" inputmode="tel" placeholder="573001234567" data-testid="deposit-whatsapp" />
                            <span class="meta">Con código de país y sin signos.</span></label>
                        <label>Instrucciones para el cliente
                            <InputTextArea @bind-Value="form.DepositInstructions" maxlength="400" data-testid="deposit-instructions" /></label>
                    </div>
                    <p class="notice" role="status" data-testid="deposit-preview">@Preview()</p>
                }
            </fieldset>
            <div class="actions">
                <button class="primary" type="submit" disabled="@(!interactiveReady || saving)" data-testid="save-service">
                    @(saving ? "Guardando…" : "Guardar servicio")
                </button>
                @if (editingId.HasValue) { <button type="button" class="secondary" @onclick="Reset">Cancelar edición</button> }
            </div>
        </EditForm>
    </section>

    @if (services.Count == 0) { <div class="empty"><h2>Aún no hay servicios</h2><p>Cree el primero con el formulario anterior.</p></div> }
    else
    {
        <div class="config-list">
            @foreach (var service in services)
            {
                <article class="config-row" data-testid="service-row">
                    <div><div class="row-title"><h2>@service.Name</h2><span class="status @(service.IsActive ? "confirmed" : "cancelled")">@(service.IsActive ? "Activo" : "Inactivo")</span></div>
                        @if (!string.IsNullOrWhiteSpace(service.Description)) { <p>@service.Description</p> }
                        <p class="meta">@service.DurationMinutes min · @service.ReferencePrice.ToString("C0", Colombia) · orden @service.DisplayOrder · @service.FutureAppointmentCount cita(s) futura(s)</p>
                        @* Sin alguien que lo preste, un servicio activo no produce ni una hora, y
                           el cliente sólo ve "No hay horas disponibles". El aviso vive aquí porque
                           es aquí donde se cree haber terminado de publicar el servicio. *@
                        @if (service.IsActive && !TienePersonal(service.Id))
                        {
                            <p class="error" role="status" data-testid="service-sin-personal">
                                Nadie tiene asignado este servicio, así que no ofrece horas para reservar.
                                Asígnelo en <a href="/panel/@BusinessId/configuracion/personal">Personal</a>.
                            </p>
                        }
                        <p class="meta" data-testid="service-deposit">
                            @if (service.RequiresDeposit)
                            {
                                <text>Adelanto @service.DepositAmount.ToString("C0", Colombia)
                                    (@(service.DepositType == "Percentage" ? $"{service.DepositValue:0.##} %" : "valor fijo"))
                                    · WhatsApp @service.DepositWhatsAppNumber</text>
                            }
                            else { <text>Sin adelanto</text> }
                        </p>
                        @if (canManageImages)
                        {
                            <CatalogImageEditor BusinessId="BusinessId" TargetId="service.Id" Kind="Service"
                                Label="@service.Name" CurrentImage="@ServiceImage(service.Id)"
                                OnChanged="LoadImages" />
                        }
                    </div>
                    <div class="actions">
                        <button class="secondary" type="button" @onclick="() => Edit(service)" disabled="@(!interactiveReady || saving)">Editar</button>
                        <button class="@(service.IsActive ? "danger" : "primary")" type="button" @onclick="() => Toggle(service)" disabled="@(!interactiveReady || saving)">
                            @(service.IsActive ? "Desactivar" : "Activar")
                        </button>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");
    [Parameter] public Guid BusinessId { get; set; }
    private IReadOnlyList<ServiceDto> services = [];
    private IReadOnlyList<StaffMemberDto> staff = [];
    private IReadOnlyList<BusinessImageDto> images = [];
    private bool canManageImages;
    private ServiceForm form = new();
    private Guid? editingId;
    private bool loading = true, saving, interactiveReady;
    private string? error, message;

    protected override async Task OnParametersSetAsync() => await Load();
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactiveReady = true; StateHasChanged(); } }

    private async Task Load()
    {
        loading = true; error = null;
        try
        {
            // Secuencial: con InteractiveServer las dos llamadas comparten el AppDbContext del
            // circuito y en paralelo lanzarían InvalidOperationException.
            services = await Api.GetServicesAsync(BusinessId);
            staff = await Api.GetStaffAsync(BusinessId);
            await LoadImages();
        }
        catch (ApiException ex) { error = Friendly(ex); }
        finally { loading = false; }
    }

    private async Task LoadImages()
    {
        try { images = await Api.GetOwnerCatalogImagesAsync(BusinessId); canManageImages = true; }
        catch (ApiException ex) when (ex.StatusCode == 403) { images = []; canManageImages = false; }
    }

    private BusinessImageDto? ServiceImage(Guid serviceId)
        => images.FirstOrDefault(x => x.Kind == "Service" && x.ServiceId == serviceId);

    /// <summary>
    /// Si alguien activo y que participa en la agenda presta el servicio. Es la misma condición que
    /// exige el motor de disponibilidad, así que responde lo que el cliente verá.
    /// </summary>
    private bool TienePersonal(Guid serviceId) => staff.Any(x =>
        x.IsActive && x.ParticipatesInAvailability && x.ServiceIds.Contains(serviceId));
    private void Edit(ServiceDto service)
    {
        editingId = service.Id;
        form = new() { Name = service.Name, Description = service.Description, DurationMinutes = service.DurationMinutes,
            ReferencePrice = service.ReferencePrice, DisplayOrder = service.DisplayOrder,
            IsActive = service.IsActive, Version = service.Version,
            RequiresDeposit = service.RequiresDeposit,
            DepositType = service.DepositType == "None" ? "FixedAmount" : service.DepositType,
            DepositValue = service.DepositValue, DepositInstructions = service.DepositInstructions,
            DepositWhatsAppNumber = service.DepositWhatsAppNumber };
        message = null;
    }

    /// <summary>Adelanto calculado mientras se escribe, con las mismas reglas que aplicará el servidor.</summary>
    private string Preview()
    {
        if (form.DepositValue <= 0) return "Calculando adelanto… indique un valor mayor que cero.";
        if (form.DepositType == "Percentage")
        {
            if (form.DepositValue > 100) return "El porcentaje debe estar entre 1 y 100.";
            var amount = Math.Round(form.ReferencePrice * form.DepositValue / 100m, 0, MidpointRounding.AwayFromZero);
            return $"Sobre {form.ReferencePrice.ToString("C0", Colombia)} el cliente adelantará {amount.ToString("C0", Colombia)}.";
        }
        if (form.DepositValue > form.ReferencePrice) return "El adelanto no puede superar el precio del servicio.";
        return $"El cliente adelantará {Math.Round(form.DepositValue, 0, MidpointRounding.AwayFromZero).ToString("C0", Colombia)} " +
               $"de {form.ReferencePrice.ToString("C0", Colombia)}.";
    }
    private void Reset() { editingId = null; form = new(); }
    private async Task Save()
    {
        saving = true; error = message = null;
        try
        {
            if (editingId.HasValue)
                await Api.UpdateServiceAsync(BusinessId, editingId.Value, form.ToUpdate());
            else
                await Api.CreateServiceAsync(BusinessId, form.ToCreate());
            message = editingId.HasValue ? "Servicio actualizado." : "Servicio creado.";
            Reset(); await Load();
        }
        catch (ApiException ex) { error = ex.Code == "CONCURRENCY_CONFLICT" ? $"{ex.Message} Use Recargar." : ex.Message; }
        finally { saving = false; }
    }
    private async Task Toggle(ServiceDto service)
    {
        saving = true; error = message = null;
        try
        {
            // Activar o desactivar no toca el adelanto: se reenvía tal cual está configurado.
            await Api.UpdateServiceAsync(BusinessId, service.Id, new()
            {
                Name = service.Name, Description = service.Description, DurationMinutes = service.DurationMinutes,
                ReferencePrice = service.ReferencePrice, DisplayOrder = service.DisplayOrder,
                IsActive = !service.IsActive, Version = service.Version,
                RequiresDeposit = service.RequiresDeposit, DepositType = service.DepositType,
                DepositValue = service.DepositValue, DepositInstructions = service.DepositInstructions,
                DepositWhatsAppNumber = service.DepositWhatsAppNumber
            });
            message = service.IsActive
                ? "Servicio desactivado. Las citas existentes se conservan."
                : "Servicio activado para nuevas citas.";
            await Load();
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { saving = false; }
    }
    /// <summary>
    /// "No tiene acceso" y "este negocio no hace eso" son cosas distintas, y confundirlas manda a la
    /// persona a pedir permisos que ya tiene. Un 403 por capacidad se dice tal cual.
    /// </summary>
    private static string Friendly(ApiException ex) => ex.Code == "CAPABILITY_DISABLED"
        ? "Este establecimiento no tiene esa función habilitada."
        : ex.StatusCode is 401 or 403 or 404
            ? "No tiene acceso a este establecimiento." : ex.Message;

    private sealed class ServiceForm
    {
        [Required(ErrorMessage = "El nombre es obligatorio."), StringLength(120, MinimumLength = 2)] public string Name { get; set; } = "";
        [StringLength(500)] public string? Description { get; set; }
        [Range(5, 480, ErrorMessage = "Use entre 5 y 480 minutos.")] public int DurationMinutes { get; set; } = 30;
        [Range(0, 100000000, ErrorMessage = "El precio no puede ser negativo.")] public decimal ReferencePrice { get; set; }
        [Range(0, 10000)] public int DisplayOrder { get; set; }
        public bool IsActive { get; set; } = true;
        public long Version { get; set; }
        public bool RequiresDeposit { get; set; }
        public string DepositType { get; set; } = "FixedAmount";
        [Range(0, 100000000)] public decimal DepositValue { get; set; }
        [StringLength(400)] public string? DepositInstructions { get; set; }
        [StringLength(30)] public string? DepositWhatsAppNumber { get; set; }
        public CreateServiceRequest ToCreate() => Fill(new CreateServiceRequest { Name = Name,
            Description = Description, DurationMinutes = DurationMinutes, ReferencePrice = ReferencePrice,
            DisplayOrder = DisplayOrder });
        public UpdateServiceRequest ToUpdate() => Fill(new UpdateServiceRequest { Name = Name,
            Description = Description, DurationMinutes = DurationMinutes, ReferencePrice = ReferencePrice,
            DisplayOrder = DisplayOrder, IsActive = IsActive, Version = Version });
        private T Fill<T>(T request) where T : ServiceDepositFields
        {
            request.RequiresDeposit = RequiresDeposit;
            request.DepositType = RequiresDeposit ? DepositType : "None";
            request.DepositValue = RequiresDeposit ? DepositValue : 0;
            request.DepositInstructions = DepositInstructions;
            request.DepositWhatsAppNumber = DepositWhatsAppNumber;
            return request;
        }
    }
}
