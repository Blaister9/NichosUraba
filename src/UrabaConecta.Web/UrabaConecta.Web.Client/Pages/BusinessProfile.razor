@page "/negocios/{Slug}"
@rendermode InteractiveAuto
@inject IUrabaConectaApi Api

<PageTitle>@(business?.Name ?? "Establecimiento") | UrabáConecta</PageTitle>
@if (loading) { <p class="notice">Cargando perfil…</p> }
else if (business is null)
{
    <div class="empty"><h1>No encontramos el establecimiento</h1><a href="/">Volver al directorio</a></div>
}
else
{
    <a class="back-link" href="/">← Directorio</a>
    <BusinessProfileView Profile="business" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private BusinessProfileDto? business;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    { loading = true; business = await Api.GetBusinessAsync(Slug); loading = false; }
}
