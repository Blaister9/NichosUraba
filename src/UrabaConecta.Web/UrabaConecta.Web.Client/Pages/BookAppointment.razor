@page "/negocios/{Slug}/citas"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api
@inject NavigationManager Navigation

<PageTitle>Reservar cita | UrabáConecta</PageTitle>
<a class="back-link" href="/negocios/@Slug">← Volver al negocio</a>
@* Quien llega por un enlace directo tiene que ver de qué negocio es esta agenda antes de escribir
   su teléfono. Antes el título no lo decía en ninguna parte. *@
<div class="panel-header">
    @if (business is not null) { <p class="eyebrow">@business.Name</p> }
    <h1>Solicitar una cita</h1>
    <p class="meta">Elige el servicio y la hora. El negocio te confirma; no se paga en línea.</p>
</div>
@if (business is null) { <p class="notice">Cargando servicios…</p> }
else
{
    <EditForm Model="request" OnValidSubmit="Submit" FormName="appointment-request" class="appointment-form">
        <fieldset disabled="@(!interactiveReady)">
        <DataAnnotationsValidator /><ValidationSummary />
        <fieldset><legend>1. Servicio y horario</legend>
            <label>Servicio<InputSelect @bind-Value="request.ServiceId">
                <option value="@Guid.Empty">Seleccione</option>
                @foreach (var service in business.Services) { <option value="@service.Id">@service.Name · @service.DurationMinutes min</option> }
            </InputSelect></label>

            @* Lo elegido, con cara. Antes el servicio era una línea de texto dentro de un
               desplegable y el precio vivía tres bloques más abajo, así que en el momento de decidir
               la hora no se veía ni qué se estaba reservando ni cuánto costaba. *@
            @if (Selected is { } elegido)
            {
                <article class="catalogo-item elegido" data-tono="@CategoryLook.Tone(business.Category.Slug)"
                         data-testid="deposit-summary">
                    @if (elegido.ImageUrl is { Length: > 0 } foto)
                    {
                        <img class="catalogo-foto" src="@foto" width="184" height="184"
                             alt="@(elegido.ImageAltText ?? elegido.Name)" />
                    }
                    else
                    {
                        <span class="catalogo-foto sin-foto"><Icon Name="@CategoryLook.Icon(business.Category.Slug)" Size="28" /></span>
                    }
                    <div class="catalogo-cuerpo">
                        <h3>@elegido.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(elegido.Description)) { <p>@elegido.Description</p> }
                        <p class="catalogo-datos">
                            <span class="duracion"><Icon Name="reloj" Size="14" /> @Duracion(elegido.DurationMinutes)</span>
                            @if (elegido.RequiresDeposit)
                            {
                                <span>Adelanto <strong data-testid="deposit-amount">@elegido.DepositAmount.ToString("C0", Colombia)</strong></span>
                            }
                            else { <span>Pagas todo en el establecimiento</span> }
                        </p>
                    </div>
                    <div class="catalogo-accion">
                        <span class="precio">@elegido.ReferencePrice.ToString("C0", Colombia)</span>
                    </div>
                </article>
                @if (elegido.RequiresDeposit)
                {
                    <p class="notice">
                        Este servicio pide un adelanto de
                        @(elegido.DepositType == "Percentage" ? $"{elegido.DepositValue:0.##} % del valor" : "un valor fijo").
                        @elegido.DepositInstructions
                        El pago se hace <strong>directamente al negocio</strong>: UrabáConecta no recibe dinero
                        ni procesa pagos. Al terminar te damos un enlace de WhatsApp para enviar el comprobante.
                    </p>
                }
            }

            <label>Fecha<input type="date" value="@dateText" @oninput="e => dateText = e.Value?.ToString() ?? string.Empty" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /></label>
            <button type="button" class="secondary" @onclick="LoadSlots" disabled="@(!interactiveReady || loadingSlots)">@(loadingSlots ? "Consultando…" : "Ver horas disponibles")</button>
            @if (slots is not null && slots.Count == 0) { <p class="notice">No hay horas disponibles para esa fecha. Prueba otro día.</p> }
            else if (slots is not null)
            {
                @* Cuarenta botones seguidos no se leen. Partidos en mañana, tarde y noche, el
                   cliente encuentra su franja de un vistazo. *@
                @foreach (var (titulo, horas) in Franjas(slots))
                {
                    <div>
                        <p class="franja">@titulo</p>
                        <div class="slot-grid" role="radiogroup" aria-label="Horas disponibles en la @titulo.ToLowerInvariant()">
                            @foreach (var slot in horas)
                            { <button type="button" class="slot @(request.Start == slot.Start ? "selected" : "")" @onclick="() => request.Start = slot.Start">@LocalTime(slot.Start)</button> }
                        </div>
                    </div>
                }
            }
        </fieldset>
        <fieldset><legend>2. Sus datos</legend>
            <label>Nombre o alias<InputText @bind-Value="request.CustomerAlias" autocomplete="name" /></label>
            <label>Teléfono<InputText @bind-Value="request.Phone" inputmode="tel" autocomplete="tel" /></label>
            <label>Observación corta (opcional)<InputTextArea @bind-Value="request.Notes" maxlength="300" /></label>
        </fieldset>
        <fieldset class="consent"><legend>3. Autorización</legend>
            <label class="check"><InputCheckbox @bind-Value="request.ConsentAccepted" /> Acepto que estos datos se usen para gestionar esta cita y contactarme sobre ella.</label>
            <p class="meta">
                Consulta la <a href="/legal/politica-de-datos" target="_blank">política de tratamiento de datos</a>
                y el <a href="/legal/aviso-de-privacidad" target="_blank">aviso de privacidad</a>.
                Guardamos la fecha de tu aceptación y la versión vigente de la política.
            </p>
        </fieldset>
        @if (error is not null) { <p class="error" role="alert">@error</p> }

        @* Antes de enviar, lo que se está reservando en una línea. La confirmación no debería ser el
           primer sitio donde alguien lee el día y la hora que eligió. *@
        @if (Selected is { } resumen && request.Start != default)
        {
            <p class="reserva-resumen">
                <strong>@resumen.Name</strong>
                <span>@LocalFecha(request.Start) · @LocalTime(request.Start)</span>
                <span class="precio">@resumen.ReferencePrice.ToString("C0", Colombia)</span>
            </p>
        }
        <button class="primary btn-grande" disabled="@(!interactiveReady || loadingSlots || submitting)">@(submitting ? "Creando cita…" : "Enviar solicitud")</button>
        </fieldset>
    </EditForm>
}
@code {
    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");
    /// <summary>El servicio elegido, para mostrar precio y adelanto antes de confirmar.</summary>
    private ServiceDto? Selected => business?.Services.FirstOrDefault(x => x.Id == request.ServiceId);
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery] public Guid? ServiceId { get; set; }
    private BusinessProfileDto? business;
    private List<SlotDto>? slots;
    private string dateText = NextBusinessDay().ToString("yyyy-MM-dd");
    [SupplyParameterFromForm(FormName = "appointment-request")]
    private CreateAppointmentRequest request { get; set; } = default!;
    private bool loadingSlots, submitting, interactiveReady;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        request ??= new();
        // El formulario declara la versión que mostró; el servidor rechaza cualquier otra.
        try { request.ConsentNoticeVersion = (await Api.GetLegalInfoAsync()).PolicyVersion; }
        catch (ApiException) { }
        business = await Api.GetBusinessAsync(Slug);
        if (request.ServiceId == Guid.Empty)
            request.ServiceId = ServiceId ?? business?.Services.FirstOrDefault()?.Id ?? Guid.Empty;
        if (request.ServiceId != Guid.Empty) await LoadSlots();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactiveReady = true; StateHasChanged(); }
    }
    private async Task LoadSlots()
    {
        error = null;
        if (request.ServiceId == Guid.Empty) { error = "Seleccione un servicio."; return; }
        if (!DateOnly.TryParseExact(dateText, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date))
        { error = "Seleccione una fecha válida."; return; }
        loadingSlots = true;
        request.Start = default;
        slots = null;
        try { slots = (await Api.GetSlotsAsync(Slug, request.ServiceId, date)).Slots.ToList(); }
        catch (ApiException ex) { error = ex.Message; slots = []; }
        finally { loadingSlots = false; }
    }
    private async Task Submit()
    {
        error = null;
        if (request.Start == default) { error = "Seleccione una hora disponible."; return; }
        submitting = true;
        try
        {
            var created = await Api.CreateAppointmentAsync(Slug, request);
            Navigation.NavigateTo($"/seguimiento/citas/{Uri.EscapeDataString(created.TrackingCode)}?new=true");
        }
        catch (ApiException ex) { error = ex.Message; if (ex.Code == "SLOT_UNAVAILABLE") await LoadSlots(); }
        finally { submitting = false; }
    }
    private static DateOnly NextBusinessDay()
    {
        var value = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        while (value.DayOfWeek == DayOfWeek.Sunday) value = value.AddDays(1);
        return value;
    }
    private static string LocalTime(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota")).ToString("hh:mm tt");

    private static string LocalFecha(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"))
            .ToString("dddd d 'de' MMMM", Colombia);

    /// <summary>"1 h 30 min" se lee de un vistazo; "90 minutos" hay que convertirlo.</summary>
    private static string Duracion(int minutos) => minutos < 60
        ? $"{minutos} min"
        : minutos % 60 == 0 ? $"{minutos / 60} h" : $"{minutos / 60} h {minutos % 60} min";

    /// <summary>
    /// Agrupa las horas disponibles por momento del día. Sólo cambia cómo se presentan: las horas y
    /// su orden son exactamente las que devolvió el servidor.
    /// </summary>
    private static IEnumerable<(string Titulo, List<SlotDto> Horas)> Franjas(List<SlotDto> disponibles)
    {
        static int HoraLocal(DateTimeOffset value) =>
            TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota")).Hour;
        var manana = disponibles.Where(x => HoraLocal(x.Start) < 12).ToList();
        var tarde = disponibles.Where(x => HoraLocal(x.Start) is >= 12 and < 18).ToList();
        var noche = disponibles.Where(x => HoraLocal(x.Start) >= 18).ToList();
        if (manana.Count > 0) yield return ("Mañana", manana);
        if (tarde.Count > 0) yield return ("Tarde", tarde);
        if (noche.Count > 0) yield return ("Noche", noche);
    }
}
