@page "/seguimiento/citas/{Code}"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api

<PageTitle>Estado de la cita | UrabáConecta</PageTitle>
<section class="narrow">
    @if (IsNew)
    {
        <div class="success">
            <strong>Solicitud enviada.</strong>
            <p>El negocio la revisa y te confirma. Guarda este enlace o el código
                <code data-testid="tracking-code">@Code</code> para consultar el estado cuando quieras.</p>
        </div>
    }
    @if (loading) { <p class="notice">Consultando estado…</p> }
    else if (appointment is null) { <div class="empty"><h1>Código no encontrado</h1><a href="/seguimiento/citas">Intentar otro código</a></div> }
    else
    {
        <p class="eyebrow">@appointment.BusinessName</p>
        <h1>Su cita está <span class="status @appointment.Status.ToLowerInvariant()">@appointment.StatusLabel</span></h1>
        <dl class="details">
            <dt>Servicio</dt><dd>@appointment.ServiceName</dd><dt>Fecha y hora</dt><dd>@LocalDate(appointment.Start)</dd>
            @* Antes esta línea mostraba la hora en UTC, que no es la hora de nadie en Urabá. *@
            <dt>Teléfono</dt><dd>@appointment.PhoneMasked</dd>
            <dt>Última actualización</dt><dd>@LocalDate(appointment.UpdatedAt)</dd>
        </dl>
        <PushPrompt RegistrationPath="@($"/api/v1/public/appointments/{Uri.EscapeDataString(Code)}/push-subscriptions")"
                    Title="Recibe novedades de esta cita"
                    Description="Te avisamos en este dispositivo cuando el negocio confirme o cambie la cita."
                    ButtonLabel="Avisarme sobre esta cita" />
        @if (appointment.RequiresDeposit)
        {
            <section class="deposit-block" data-testid="deposit-block">
                <h2>Adelanto <span class="status @appointment.DepositStatus.ToLowerInvariant()" data-testid="deposit-status">@appointment.DepositStatusLabel</span></h2>
                <dl class="details">
                    <dt>Precio total</dt><dd>@appointment.ServicePrice.ToString("C0", Colombia)</dd>
                    <dt>Adelanto requerido</dt>
                    <dd>@(appointment.DepositType == "Percentage" ? "Porcentaje del precio" : "Valor fijo")</dd>
                    <dt>Valor del adelanto</dt><dd data-testid="deposit-amount">@appointment.DepositAmount.ToString("C0", Colombia)</dd>
                    <dt>Cómo pagarlo</dt><dd>@appointment.DepositInstructions</dd>
                </dl>
                @if (appointment.DepositStatus == "Verified")
                {
                    <p class="success" role="status">El negocio verificó su adelanto. No tiene que enviar nada más.</p>
                }
                else if (appointment.DepositStatus == "Reported")
                {
                    <p class="notice" role="status">Su comprobante quedó reportado. El negocio lo revisará.</p>
                }
                @if (!string.IsNullOrWhiteSpace(appointment.DepositRejectionReason))
                {
                    <p class="error" role="alert">El negocio rechazó el comprobante: @appointment.DepositRejectionReason</p>
                }
                @if (appointment.DepositWhatsAppUrl is not null)
                {
                    <p class="notice">
                        El pago se hace directamente al negocio. UrabáConecta no recibe dinero: sólo abre
                        la conversación de WhatsApp con los datos de su cita.
                    </p>
                    @* La clase era "primary button", que no existe: el enlace se pintaba como texto
                       suelto justo donde el cliente tiene que enviar su comprobante. *@
                    <a class="button-link primary" href="@appointment.DepositWhatsAppUrl" target="_blank" rel="noopener"
                       data-testid="whatsapp-link" @onclick="() => openingWhatsApp = true">
                        Enviar comprobante por WhatsApp
                    </a>
                    @if (openingWhatsApp) { <p class="notice" role="status">Abriendo WhatsApp…</p> }
                    <button class="secondary" @onclick="ReportDeposit" disabled="@(!interactiveReady || working)"
                            data-testid="report-deposit">
                        @(reporting ? "Guardando estado…" : "Ya envié el comprobante")
                    </button>
                }
            </section>
        }
        @if (appointment.CanCancel)
        {
            <button class="danger" @onclick="Cancel" disabled="@(!interactiveReady || working)">
                @(working ? "Cancelando…" : "Cancelar cita")
            </button>
            @if (!interactiveReady) { <p class="notice" role="status">Preparando la cancelación…</p> }
        }
        @if (error is not null) { <p class="error">@error</p> }
    }
</section>
@code {
    [Parameter] public string Code { get; set; } = "";
    [SupplyParameterFromQuery(Name = "new")] public bool IsNew { get; set; }
    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");
    private AppointmentTrackingDto? appointment;
    private bool loading = true, working, interactiveReady, reporting, openingWhatsApp;
    private string? error;
    protected override async Task OnParametersSetAsync() => await Load();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    private async Task Load() { loading = true; appointment = await Api.GetAppointmentTrackingAsync(Code); loading = false; }
    /// <summary>
    /// El botón se deshabilita durante el envío, así que un segundo clic no dispara un segundo
    /// reporte. Si aun así llegara, el servidor rechaza la transición repetida.
    /// </summary>
    private async Task ReportDeposit()
    {
        if (working) return;
        working = reporting = true; error = null;
        try { appointment = await Api.ReportAppointmentDepositAsync(Code); }
        catch (ApiException ex) { error = ex.Message; await Load(); }
        finally { working = reporting = false; }
    }
    private async Task Cancel()
    {
        working = true; error = null;
        try { await Api.CancelAppointmentAsync(Code); await Load(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { working = false; }
    }
    private static string LocalDate(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"))
            .ToString("dddd d 'de' MMMM, h:mm tt", new System.Globalization.CultureInfo("es-CO"));
}
