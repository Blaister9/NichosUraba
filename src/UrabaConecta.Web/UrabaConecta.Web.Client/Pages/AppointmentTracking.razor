@page "/seguimiento/citas/{Code}"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api

<PageTitle>Estado de la cita | UrabáConecta</PageTitle>
<section class="narrow">
    @if (IsNew) { <div class="success"><strong>Solicitud enviada.</strong><p>Guarde este código: <code data-testid="tracking-code">@Code</code></p></div> }
    @if (loading) { <p class="notice">Consultando estado…</p> }
    else if (appointment is null) { <div class="empty"><h1>Código no encontrado</h1><a href="/seguimiento/citas">Intentar otro código</a></div> }
    else
    {
        <p class="eyebrow">@appointment.BusinessName</p>
        <h1>Su cita está <span class="status @appointment.Status.ToLowerInvariant()">@appointment.StatusLabel</span></h1>
        <dl class="details">
            <dt>Servicio</dt><dd>@appointment.ServiceName</dd><dt>Fecha y hora</dt><dd>@LocalDate(appointment.Start)</dd>
            <dt>Teléfono</dt><dd>@appointment.PhoneMasked</dd><dt>Última actualización</dt><dd>@appointment.UpdatedAt.ToString("dd/MM/yyyy HH:mm") UTC</dd>
        </dl>
        @if (appointment.CanCancel)
        {
            <button class="danger" @onclick="Cancel" disabled="@(!interactiveReady || working)">
                @(working ? "Cancelando…" : "Cancelar cita")
            </button>
            @if (!interactiveReady) { <p class="notice" role="status">Preparando la cancelación…</p> }
        }
        @if (error is not null) { <p class="error">@error</p> }
    }
</section>
@code {
    [Parameter] public string Code { get; set; } = "";
    [SupplyParameterFromQuery(Name = "new")] public bool IsNew { get; set; }
    private AppointmentTrackingDto? appointment;
    private bool loading = true, working, interactiveReady;
    private string? error;
    protected override async Task OnParametersSetAsync() => await Load();
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    private async Task Load() { loading = true; appointment = await Api.GetAppointmentTrackingAsync(Code); loading = false; }
    private async Task Cancel()
    {
        working = true; error = null;
        try { await Api.CancelAppointmentAsync(Code); await Load(); }
        catch (ApiException ex) { error = ex.Message; }
        finally { working = false; }
    }
    private static string LocalDate(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"))
            .ToString("dddd d 'de' MMMM, h:mm tt", new System.Globalization.CultureInfo("es-CO"));
}
