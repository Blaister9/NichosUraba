@page "/seguimiento"
@page "/seguimiento/citas"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IUrabaConectaApi Api
@inject IJSRuntime JS

@* "Mi actividad": la puerta única a los tres seguimientos.

   Antes había una consulta por operación y ninguna estaba enlazada desde la navegación, así que
   volver a una reserva exigía guardar la dirección exacta. Ahora la barra inferior lleva aquí y
   aquí se elige qué se está consultando; /seguimiento/citas se conserva porque es la dirección que
   ya circula en los mensajes de confirmación enviados. *@
<PageTitle>Mi actividad | UrabáConecta</PageTitle>

<section class="explorar-head">
    <h1>Mi actividad</h1>
    <p class="hero-sub">Consulta tu reserva, tu turno o tu pedido con el código que recibiste.</p>
</section>

<section class="narrow">
    @if (!recuperacionCargada)
    {
        <p class="notice" role="status">Buscando tu último pedido…</p>
    }
    else if (ultimoPedido is not null && ultimoCodigo is not null)
    {
        <section class="config-form" data-testid="last-order">
            <h2>Tu último pedido</h2>
            <p><strong>@ultimoPedido.BusinessName · Pedido #@ultimoPedido.OrderNumber</strong></p>
            <p>Estado actual: <span class="status @ultimoPedido.Status.ToLowerInvariant()">@ultimoPedido.StatusLabel</span></p>
            <a class="button-link btn-grande"
               href="/seguimiento/pedidos/@Uri.EscapeDataString(ultimoCodigo)">Ver seguimiento</a>
        </section>
    }

    <div class="segmentado" role="group" aria-label="Qué quieres consultar">
        @foreach (var opcion in Opciones)
        {
            <button type="button" class="@(tipo == opcion.Clave ? "activo" : null)"
                    aria-pressed="@(tipo == opcion.Clave)" @onclick="() => tipo = opcion.Clave">
                <Icon Name="@opcion.Icono" Size="16" /> @opcion.Etiqueta
            </button>
        }
    </div>

    <label>Código de seguimiento
        <input @bind-value="codigo" @bind-value:event="oninput" @onkeydown="AlTeclear"
               autocomplete="off" spellcheck="false" placeholder="Pega aquí tu código" />
        <span class="field-hint">Te lo mostramos al confirmar. @Pista</span>
    </label>

    <button class="primary btn-grande" @onclick="Abrir" disabled="@(!listo || !CodigoValido)">Consultar</button>

    @if (!listo) { <p class="notice" role="status">Preparando la consulta…</p> }
    else if (intentado && !CodigoValido) { <p class="error" role="alert">Ese código está incompleto.</p> }

    @* Quien llega aquí ya sabe que vuelve: es el sitio donde tiene sentido decirle que puede
       dejarse la aplicación puesta y que sepa, sin abrir los ajustes del navegador, si los avisos
       están activos o bloqueados. *@
    <AppStatusCard />
</section>

@code {
    private string tipo = "citas", codigo = "";
    private string? ultimoCodigo;
    private PickupOrderTrackingDto? ultimoPedido;
    private bool listo, intentado, recuperacionCargada;

    private sealed record Opcion(string Clave, string Etiqueta, string Icono);

    private static readonly Opcion[] Opciones =
    [
        new("citas", "Cita", "actividad"),
        new("turnos", "Turno", "reloj"),
        new("pedidos", "Pedido", "bolsa"),
    ];

    private string Pista => tipo switch
    {
        "turnos" => "Es el código del turno que tomaste.",
        "pedidos" => "Es el código que acompaña al número de tu pedido.",
        _ => "Es el código que acompaña a tu reserva."
    };

    // Los tres códigos los emite el mismo servicio, así que comparten longitud mínima.
    private bool CodigoValido => codigo.Trim().Length >= 20;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        listo = true;
        await CargarUltimoPedido();
        StateHasChanged();
    }

    private async Task CargarUltimoPedido()
    {
        try
        {
            ultimoCodigo = await JS.InvokeAsync<string?>("urabaOrderRecovery.load");
            if (ultimoCodigo is not null)
            {
                ultimoPedido = await Api.GetPickupOrderAsync(ultimoCodigo);
                if (ultimoPedido is null)
                {
                    ultimoCodigo = null;
                    await JS.InvokeVoidAsync("urabaOrderRecovery.clear");
                }
            }
        }
        // Un 404 llega como null y sí invalida la referencia. Ante una falla transitoria de la
        // API conservamos el único token local para que una recarga posterior pueda recuperarlo.
        catch (ApiException) { ultimoPedido = null; }
        catch (JSException) { ultimoCodigo = null; }
        finally { recuperacionCargada = true; }
    }

    private void AlTeclear(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Abrir();
    }

    private void Abrir()
    {
        intentado = true;
        if (!CodigoValido) return;
        Navigation.NavigateTo($"/seguimiento/{tipo}/{Uri.EscapeDataString(codigo.Trim())}");
    }
}
