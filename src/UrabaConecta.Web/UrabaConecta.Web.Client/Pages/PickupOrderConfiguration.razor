@page "/panel/{BusinessId:guid}/configuracion/pedidos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IUrabaConectaApi Api

<PageTitle>Configurar pedidos | UrabáConecta</PageTitle>
<a class="back-link" href="/panel/@BusinessId/configuracion">← Configuración</a>
<p class="eyebrow">Configuración</p><h1>Pedidos y catálogo</h1>
@if (error is not null) { <div class="error" role="alert">@error</div> }
@if (settings is not null)
{
    <EditForm Model="settingsForm" OnValidSubmit="SaveSettings" FormName="order-settings" class="config-form">
        <DataAnnotationsValidator /><h2>Recepción de pedidos</h2>
        <label class="check-option"><InputCheckbox @bind-Value="settingsForm.IsEnabled" /> Módulo público activo</label>
        <label>Mensaje <InputText @bind-Value="settingsForm.PublicMessage" /></label>
        <label>Preparación mínima (min) <InputNumber @bind-Value="settingsForm.MinimumPreparationMinutes" /></label>
        <label>Intervalo de franja (min) <InputNumber @bind-Value="settingsForm.SlotIntervalMinutes" /></label>
        <label>Capacidad activa por franja <InputNumber @bind-Value="settingsForm.MaximumActivePerSlot" /></label>
        <label>Desde <InputText @bind-Value="fromText" /></label><label>Hasta <InputText @bind-Value="untilText" /></label>
        <button class="primary">Guardar configuración</button>
    </EditForm>
}
<section class="config-form">
    <h2>Categorías</h2>
    @foreach (var category in categories) { <p><strong>@category.Name</strong> · orden @category.DisplayOrder · @(category.IsActive ? "Activa" : "Inactiva")</p> }
    <EditForm Model="categoryForm" OnValidSubmit="AddCategory" FormName="add-category">
        <DataAnnotationsValidator /><label>Nueva categoría <InputText @bind-Value="categoryForm.Name" /></label>
        <label>Orden <InputNumber @bind-Value="categoryForm.DisplayOrder" /></label><button class="secondary">Agregar</button>
    </EditForm>
</section>
<section class="config-form">
    <h2>Productos</h2>
    <div class="config-list">
    @foreach (var product in products)
    {
        var editor = productEditors[product.Id];
        <article class="config-row product-editor" data-product-id="@product.Id">
            <div>
                <label>Nombre <input @bind="editor.Name" /></label>
                <label>Descripción <input @bind="editor.Description" /></label>
                <div class="form-grid">
                    <label>Precio <input type="number" min="0" step="100" @bind="editor.Price" /></label>
                    <label>Orden <input type="number" min="0" @bind="editor.Order" /></label>
                </div>
                <label>Categoría <select @bind="editor.CategoryId">
                    @foreach (var category in categories) { <option value="@category.Id">@category.Name</option> }
                </select></label>
                <label class="check-option"><input type="checkbox" @bind="editor.Active" /> Visible en el menú</label>
                @if (canManageImages)
                {
                    <CatalogImageEditor BusinessId="BusinessId" TargetId="product.Id" Kind="Product"
                        Label="@product.Name" CurrentImage="@ProductImage(product.Id)" OnChanged="LoadImages" />
                }
            </div>
            <div class="actions"><button type="button" class="secondary" disabled="@(!interactiveReady || busy)"
                @onclick="() => SaveExistingProduct(product)">Guardar producto</button></div>
        </article>
    }
    </div>
    <EditForm Model="productForm" OnValidSubmit="AddProduct" FormName="add-product">
        <DataAnnotationsValidator /><label>Categoría <InputSelect @bind-Value="productForm.CategoryId">
            <option value="@Guid.Empty">Selecciona</option>@foreach (var category in categories.Where(x => x.IsActive)) { <option value="@category.Id">@category.Name</option> }
        </InputSelect></label>
        <label>Nombre <InputText @bind-Value="productForm.Name" /></label>
        <label>Descripción <InputText @bind-Value="productForm.Description" /></label>
        <label>Precio <InputNumber @bind-Value="productForm.ReferencePrice" /></label>
        <label>Orden <InputNumber @bind-Value="productForm.DisplayOrder" /></label><button class="secondary">Agregar</button>
    </EditForm>
</section>
@code {
    [Parameter] public Guid BusinessId { get; set; }
    private PickupOrderSettingsDto? settings; private SavePickupOrderSettingsRequest settingsForm = new();
    private IReadOnlyList<ProductCategoryDto> categories = []; private IReadOnlyList<ProductDto> products = [];
    private SaveProductCategoryRequest categoryForm = new(); private SaveProductRequest productForm = new();
    private readonly Dictionary<Guid, ProductEditor> productEditors = [];
    private IReadOnlyList<BusinessImageDto> images = [];
    private bool canManageImages;
    private string fromText = "11:00", untilText = "20:30"; private string? error; private bool busy;
    private bool interactiveReady;
    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            settings = await Api.GetPickupOrderSettingsAsync(BusinessId);
            settingsForm = new() { IsEnabled = settings.IsEnabled, PublicMessage = settings.PublicMessage,
                MinimumPreparationMinutes = settings.MinimumPreparationMinutes, SlotIntervalMinutes = settings.SlotIntervalMinutes,
                MaximumActivePerSlot = settings.MaximumActivePerSlot, ReceivesFrom = settings.ReceivesFrom,
                ReceivesUntil = settings.ReceivesUntil, Version = settings.Version };
            fromText = settings.ReceivesFrom.ToString("HH:mm"); untilText = settings.ReceivesUntil.ToString("HH:mm");
            categories = await Api.GetProductCategoriesAsync(BusinessId);
            // Products and their mutable editors are one render state. Publishing products before
            // creating the dictionary leaves a hydration window where the renderer indexes a key
            // that does not exist and closes the whole Owner circuit.
            var loadedProducts = await Api.GetProductsAsync(BusinessId);
            products = loadedProducts;
            RefreshEditors();
            await LoadImages();
        } catch (ApiException ex) { error = ex.Message; }
    }
    private async Task LoadImages()
    {
        try { images = await Api.GetOwnerCatalogImagesAsync(BusinessId); canManageImages = true; }
        catch (ApiException ex) when (ex.StatusCode == 403) { images = []; canManageImages = false; }
    }
    private BusinessImageDto? ProductImage(Guid productId)
        => images.FirstOrDefault(x => x.Kind == "Product" && x.ProductId == productId);
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    private async Task SaveSettings()
    {
        if (!TimeOnly.TryParse(fromText, out var from) || !TimeOnly.TryParse(untilText, out var until)) { error = "Use horas HH:mm."; return; }
        settingsForm.ReceivesFrom = from; settingsForm.ReceivesUntil = until;
        try { settings = await Api.SavePickupOrderSettingsAsync(BusinessId, settingsForm); settingsForm.Version = settings.Version; error = null; }
        catch (ApiException ex) { error = ex.Message; }
    }
    private async Task AddCategory()
    {
        try { await Api.SaveProductCategoryAsync(BusinessId, null, categoryForm); categories = await Api.GetProductCategoriesAsync(BusinessId); categoryForm = new(); }
        catch (ApiException ex) { error = ex.Message; }
    }
    private async Task AddProduct()
    {
        try { await Api.SaveProductAsync(BusinessId, null, productForm); products = await Api.GetProductsAsync(BusinessId); RefreshEditors(); productForm = new(); }
        catch (ApiException ex) { error = ex.Message; }
    }
    private async Task SaveExistingProduct(ProductDto product)
    {
        busy = true; error = null;
        var editor = productEditors[product.Id];
        try
        {
            await Api.SaveProductAsync(BusinessId, product.Id, new SaveProductRequest
            {
                CategoryId = editor.CategoryId, Name = editor.Name, Description = editor.Description,
                ReferencePrice = editor.Price, DisplayOrder = editor.Order, IsActive = editor.Active,
                Version = product.Version
            });
            products = await Api.GetProductsAsync(BusinessId); RefreshEditors();
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
    private void RefreshEditors()
    {
        productEditors.Clear();
        foreach (var product in products)
            productEditors[product.Id] = new(product.CategoryId, product.Name, product.Description,
                product.ReferencePrice, product.DisplayOrder, product.IsActive);
    }
    private sealed class ProductEditor(Guid categoryId, string name, string description,
        decimal price, int order, bool active)
    {
        public Guid CategoryId { get; set; } = categoryId;
        public string Name { get; set; } = name;
        public string Description { get; set; } = description;
        public decimal Price { get; set; } = price;
        public int Order { get; set; } = order;
        public bool Active { get; set; } = active;
    }
}
