@page "/negocios/{Slug}/pedidos"
@rendermode InteractiveServer
@inject IUrabaConectaApi Api
@inject NavigationManager Navigation

<PageTitle>Pedidos para recoger | UrabáConecta</PageTitle>
<a class="back-link" href="/negocios/@Slug">← Volver al negocio</a>
@if (error is not null) { <div class="error" role="alert">@error</div> }
@if (menu is null && error is null) { <p class="notice">Cargando menú…</p> }
else if (menu is not null && created is null)
{
    <div class="panel-header">
        <p class="eyebrow">@menu.BusinessName</p><h1>Pedido para recoger</h1>
        <p class="meta">@menu.PublicMessage</p>
    </div>
    @* Atajos a cada parte de la carta. Con tres categorías sobra desplazarse a ciegas; con ocho es
       la diferencia entre elegir y rendirse. *@
    @if (menu.Categories.Count > 1)
    {
        <div class="chip-row" role="group" aria-label="Ir a una parte del menú">
            @foreach (var category in menu.Categories)
            {
                <a class="chip" href="@Ancla($"categoria-{category.Id}")">@category.Name</a>
            }
        </div>
    }

    @foreach (var category in menu.Categories)
    {
        <section class="bloque" id="categoria-@category.Id">
            <h2>@category.Name</h2>
            <div class="catalogo">
                @foreach (var product in menu.Products.Where(x => x.CategoryId == category.Id))
                {
                    <article class="catalogo-item tienda-producto @(Quantity(product.Id) > 0 ? "en-carrito" : null) @(!product.IsAvailable ? "agotado" : null)"
                             id="producto-@product.Id" data-testid="product-card" data-tono="producto">
                        @if (product.ImageUrl is { Length: > 0 } foto)
                        {
                            <img class="catalogo-foto" src="@foto" width="184" height="184" loading="lazy"
                                 alt="@(product.ImageAltText ?? product.Name)" />
                        }
                        else
                        {
                            <span class="catalogo-foto sin-foto"><Icon Name="bolsa" Size="28" /></span>
                        }
                        <div class="catalogo-cuerpo">
                            <h3>@product.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(product.Description)) { <p>@product.Description</p> }
                        </div>
                        <div class="catalogo-accion">
                            <span class="precio">@product.ReferencePrice.ToString("C0", Colombia)</span>
                            @if (!product.IsAvailable)
                            {
                                <span class="stock-status">No disponible</span>
                                <PushPrompt
                                    RegistrationPath="@($"/api/v1/public/businesses/{Slug}/products/{product.Id}/push-subscriptions")"
                                    Title="¿Quieres este producto?"
                                    Description="Te avisamos una sola vez cuando vuelva a estar disponible."
                                    ActiveDescription="Te avisaremos cuando vuelva. Puedes cancelar cuando quieras."
                                    ButtonLabel="Avísame cuando vuelva" Compact="true" />
                            }
                            else
                            {
                            @* Un control de una sola línea. Antes los dos botones ocupaban el ancho
                               de la tarjeta y la cantidad quedaba suelta entre ellos: tres pisos
                               para sumar una hamburguesa. *@
                            <div class="stepper">
                                <button class="secondary" type="button" aria-label="Quitar uno de @product.Name"
                                        disabled="@(!Ready || Quantity(product.Id) == 0)" @onclick="() => Change(product.Id, -1)">−</button>
                                <span class="cantidad" data-testid="quantity">@Quantity(product.Id)</span>
                                <button class="secondary" type="button" aria-label="Agregar uno de @product.Name"
                                        disabled="@(!Ready)" @onclick="() => Change(product.Id, 1)">+</button>
                            </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @* El carrito viaja con quien pide. Sin esto había que bajar hasta el final para saber cuánto
       llevaba sumado, y volver a subir si quería cambiar algo. *@
    @if (CartCount > 0)
    {
        <div class="carrito-flotante">
            <div>
                <strong>@CartCount @(CartCount == 1 ? "unidad" : "unidades")</strong>
                <span>@CartTotal.ToString("C0", Colombia)</span>
            </div>
            <a class="button-link" href="@Ancla("tu-pedido")">Continuar</a>
        </div>
    }
    <section class="config-form" id="tu-pedido">
        <h2>Tu pedido</h2>
        @* El detalle antes del total: quien va a dar su celular quiere confirmar primero que lo que
           lleva es lo que quería. Un total suelto obliga a subir a revisar. *@
        @if (CartCount > 0)
        {
            <ul class="resumen-lineas">
                @foreach (var linea in Lineas)
                {
                    <li>
                        <span class="unidades">@linea.Cantidad ×</span>
                        <span class="nombre">@linea.Nombre</span>
                        <span class="importe">@linea.Total.ToString("C0", Colombia)</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="summary-empty">Todavía no has agregado nada. Elige algo del menú de arriba.</p>
        }
        <p class="total-pedido"><span>@CartCount @(CartCount == 1 ? "unidad" : "unidades")</span><strong>@CartTotal.ToString("C0", Colombia)</strong></p>
        @* Al hidratar, el circuito crea una instancia nueva y vuelve a pedir menú y franjas: la
           lista prerenderizada desaparece durante ese segundo. Antes el formulario ya estaba
           habilitado en esa ventana, así que quien llegaba rápido encontraba el selector de hora
           vacío y parecía que el pedido no funcionaba. Ahora se espera a tener los datos. *@
        @if (loadingData) { <p class="notice" role="status">Cargando horarios disponibles…</p> }
        <EditForm Model="request" OnValidSubmit="Submit" FormName="pickup-order">
            <fieldset disabled="@(!Ready)">
            <DataAnnotationsValidator /><ValidationSummary />
            <label>Hora para recoger
                <InputSelect @bind-Value="selectedSlot">
                    <option value="">Selecciona una franja</option>
                    @foreach (var slot in slots) { <option value="@slot.Start.ToString("O")">@Local(slot.Start)</option> }
                </InputSelect>
            </label>
            <label>Nombre o alias <InputText @bind-Value="request.CustomerAlias" /></label>
            <label>Celular <InputText @bind-Value="request.Phone" /></label>
            <label>Nota general (opcional) <InputTextArea @bind-Value="request.Notes" /></label>
            <label class="check-option"><InputCheckbox @bind-Value="request.ConsentAccepted" />
                Acepto el uso de estos datos para preparar el pedido y contactarme.</label>
            <p class="meta">
                Consulta la <a href="/legal/politica-de-datos" target="_blank">política de tratamiento de datos</a>
                y el <a href="/legal/aviso-de-privacidad" target="_blank">aviso de privacidad</a>.
                Guardamos la fecha de tu aceptación y la versión vigente de la política.
            </p>
            <p class="meta">El pago se realiza directamente en el establecimiento. UrabáConecta no procesa pagos.</p>
            @if (!Ready) { <p class="notice" role="status">Preparando el formulario…</p> }
            <button class="primary btn-grande" disabled="@(!Ready || busy || CartCount == 0 || string.IsNullOrEmpty(selectedSlot))">@(busy ? "Enviando pedido…" : "Confirmar pedido")</button>
            </fieldset>
        </EditForm>
    </section>
}
else if (created is not null)
{
    @* Una confirmación tiene que decir qué pasó, cuánto es y qué sigue. "Operación exitosa" no
       le sirve a nadie que esté esperando su comida. *@
    <section class="narrow" data-testid="order-created">
        <p class="eyebrow">@menu?.BusinessName</p>
        <h1>Recibimos tu pedido #@created.OrderNumber</h1>
        <p class="lead">Total a pagar: @created.Total.ToString("C0", Colombia). Pagas al recogerlo en el
            establecimiento.</p>
        <p>El negocio lo confirma y prepara. Guarda este enlace: con él sigues el estado sin crear cuenta.</p>
        <a class="button-link btn-grande" href="/seguimiento/pedidos/@created.TrackingCode">Seguir mi pedido</a>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private PickupMenuDto? menu; private IReadOnlyList<PickupSlotDto> slots = [];
    private readonly Dictionary<Guid, int> quantities = [];
    private CreatePickupOrderRequest request = new();
    private PickupOrderCreatedDto? created; private string selectedSlot = ""; private string? error; private bool busy;
    private bool interactiveReady, loadingData = true;
    /// <summary>El formulario sólo acepta interacción con el circuito vivo y los datos ya cargados.</summary>
    private bool Ready => interactiveReady && !loadingData;
    private static readonly System.Globalization.CultureInfo Colombia = new("es-CO");
    protected override async Task OnParametersSetAsync()
    {
        // El formulario declara la versión que mostró; el servidor rechaza cualquier otra.
        try { request.ConsentNoticeVersion = (await Api.GetLegalInfoAsync()).PolicyVersion; }
        catch (ApiException) { }
        // Secuencial a propósito: con InteractiveServer ambas llamadas comparten el AppDbContext
        // del circuito y lanzarlas en paralelo lo rompería.
        loadingData = true;
        try { menu = await Api.GetPickupMenuAsync(Slug); slots = (await Api.GetPickupSlotsAsync(Slug)).Slots; }
        catch (ApiException ex) { error = ex.Message; }
        catch (Exception) { error = "No pudimos cargar el menú. Recargue la página."; }
        finally { loadingData = false; }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }
    @* El documento declara <base href="/">, así que un href que sólo lleva fragmento se resuelve
       contra la raíz del sitio: "#tu-pedido" apuntaba a la Home. Blazor comparaba rutas, veía dos
       páginas distintas y navegaba de verdad, así que "Continuar" echaba a la Home y el carrito
       —que vive en el circuito— se perdía. Colgando el fragmento de la ruta actual, Blazor
       reconoce el salto dentro de la misma página y sólo desplaza. *@
    private string Ancla(string fragmento) => $"{new Uri(Navigation.Uri).PathAndQuery}#{fragmento}";
    private int Quantity(Guid id) => quantities.GetValueOrDefault(id);
    private void Change(Guid id, int delta) => quantities[id] = Math.Clamp(Quantity(id) + delta, 0, 20);
    private int CartCount => quantities.Values.Sum();
    private decimal CartTotal => menu?.Products.Sum(x => x.ReferencePrice * Quantity(x.Id)) ?? 0;

    private sealed record Linea(string Nombre, int Cantidad, decimal Total);

    /// <summary>Lo que lleva el carrito, en el orden en que aparece en la carta.</summary>
    private IEnumerable<Linea> Lineas => menu is null
        ? []
        : menu.Products.Where(x => Quantity(x.Id) > 0)
            .Select(x => new Linea(x.Name, Quantity(x.Id), x.ReferencePrice * Quantity(x.Id)));
    private async Task Submit()
    {
        // Guarda de doble envío: sin ella un segundo clic creaba un pedido duplicado.
        if (busy) return;
        if (!DateTimeOffset.TryParse(selectedSlot, out var pickup)) { error = "Selecciona una franja."; return; }
        request.PickupStart = pickup;
        request.Lines = quantities.Where(x => x.Value > 0)
            .Select(x => new CreatePickupOrderLineRequest { ProductId = x.Key, Quantity = x.Value }).ToList();
        busy = true; error = null;
        try { created = await Api.CreatePickupOrderAsync(Slug, request); }
        catch (ApiException ex)
        {
            // Si la franja se llenó mientras el cliente escribía, se recargan las disponibles
            // para que pueda elegir otra sin perder el carrito.
            error = ex.Message;
            try { slots = (await Api.GetPickupSlotsAsync(Slug)).Slots; } catch (ApiException) { }
        }
        catch (Exception) { error = "No pudimos crear el pedido. Intente de nuevo."; }
        finally { busy = false; }
    }
    private static string Local(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"))
            .ToString("ddd d MMM, h:mm tt", Colombia);
}
