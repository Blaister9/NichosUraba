@page "/Account/ChangeTemporaryPassword"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using UrabaConecta.Domain
@using UrabaConecta.Infrastructure.Identity
@using UrabaConecta.Infrastructure.Persistence
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AppDbContext Db
@inject TimeProvider TimeProvider
@inject IdentityRedirectManager RedirectManager

<PageTitle>Cambiar contraseña temporal | UrabáConecta</PageTitle>
<section class="narrow">
    <p class="eyebrow">Primer ingreso</p>
    <h1>Crea tu contraseña</h1>
    <p>Por seguridad, debes reemplazar la contraseña temporal antes de entrar al panel.</p>
    <StatusMessage Message="@message" />
    <EditForm Model="Input" FormName="temporary-password-change" OnValidSubmit="Submit" method="post"
              class="appointment-form">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Contraseña temporal
            <InputText type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
        </label>
        <label>Nueva contraseña
            <InputText type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
        </label>
        <label>Confirma la nueva contraseña
            <InputText type="password" @bind-Value="Input.Confirmation" autocomplete="new-password" />
        </label>
        <button class="primary" type="submit">Guardar y continuar</button>
    </EditForm>
</section>

@code {
    private string? message;
    private ApplicationUser? user;
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) RedirectManager.RedirectTo("/Account/Login");
        if (user?.MustChangePassword == false) RedirectManager.RedirectTo("/panel");
    }

    private async Task Submit()
    {
        if (user is null) return;
        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            message = $"Error: {string.Join(" ", result.Errors.Select(x => x.Description))}";
            return;
        }
        user.MustChangePassword = false;
        var update = await UserManager.UpdateAsync(user);
        if (!update.Succeeded)
        {
            message = "Error: no fue posible completar el cambio.";
            return;
        }
        var now = TimeProvider.GetUtcNow();
        var businesses = await Db.BusinessMemberships.AsNoTracking()
            .Where(x => x.UserId == user.Id && x.IsActive && x.Role == MembershipRole.Owner)
            .Select(x => x.BusinessId).ToListAsync();
        Db.PlatformAuditEntries.AddRange(businesses.Select(businessId =>
            new PlatformAuditEntry(Guid.NewGuid(), businessId, user.Id,
                PlatformAuditAction.TemporaryPasswordChanged, "{}", "{}", now)));
        await Db.SaveChangesAsync();
        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectTo("/panel");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "La contraseña temporal es obligatoria.")]
        public string CurrentPassword { get; set; } = "";
        [Required(ErrorMessage = "La nueva contraseña es obligatoria.")]
        [StringLength(100, MinimumLength = 10, ErrorMessage = "Debe tener al menos 10 caracteres.")]
        public string NewPassword { get; set; } = "";
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string Confirmation { get; set; } = "";
    }
}
