@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using UrabaConecta.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Mis datos personales | UrabáConecta</PageTitle>

<StatusMessage />
<h2>Mis datos personales</h2>

<p>Tu cuenta guarda los datos que nos entregaste al crearla. Puedes descargarlos cuando quieras.</p>
<p class="warning-text">Eliminarlos borra tu cuenta de forma definitiva y no se puede deshacer.</p>
<form action="Account/Manage/DownloadPersonalData" method="post">
    <AntiforgeryToken />
    <button class="secondary" type="submit">Descargar mis datos</button>
</form>
<p><a href="Account/Manage/DeletePersonalData" class="button-link danger">Eliminar mi cuenta</a></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
