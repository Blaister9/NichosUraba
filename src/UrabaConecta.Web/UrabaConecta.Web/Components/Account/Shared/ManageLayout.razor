@inherits LayoutComponentBase
@layout UrabaConecta.Web.Client.Layout.MainLayout

@* "Cuenta" es un enlace del encabezado, así que un demo llega aquí en un clic. Estaba tal como lo
   dejó el andamiaje de Identity: en inglés y con clases de Bootstrap que este producto no carga. *@
<a class="back-link" href="/panel">← Mis negocios</a>
<div class="panel-header">
    <p class="eyebrow">Tu acceso</p>
    <h1>Mi cuenta</h1>
    <p class="meta">Tus datos de ingreso. No son los datos públicos del negocio: ésos viven en su
        configuración.</p>
</div>

<ManageNavMenu />
<div class="config-form">@Body</div>

<form class="logout-form" action="/Account/Logout" method="post">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="" />
    <button type="submit" class="secondary">Cerrar sesión</button>
</form>
