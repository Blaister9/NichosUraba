<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["UrabaConecta.Web.styles.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body data-ambiente="@Environment.EnvironmentName">
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@inject IWebHostEnvironment Environment

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Los formularios operativos no deben exponer un DOM prerenderizado mientras
    // WebAssembly descarga e hidrata. InteractiveServer entrega interactividad
    // inmediatamente después de conectar el circuito y evita descartar entradas.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
