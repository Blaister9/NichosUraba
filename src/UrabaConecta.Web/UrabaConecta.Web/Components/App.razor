<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* El color de la barra del navegador. Aquí queda el del tema claro y theme.js lo reescribe
       según la preferencia real antes de la primera pintura. Antes era un verde de una marca
       anterior que ya no existe en la paleta. *@
    <meta name="theme-color" content="#FFFDF9" />
    <meta name="application-name" content="@(EsDev ? "UrabáConecta DEV" : "UrabáConecta")" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="@(EsDev ? "/manifest.dev.webmanifest" : "/manifest.webmanifest")" />
    <link rel="icon" href="/icons/icon-192.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    @* Síncrono y en el <head> a propósito: si el tema se aplicara después de la primera
       pintura, cada carga en oscuro empezaría con un fogonazo blanco. *@
    <script src="@Assets["theme.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["UrabaConecta.Web.styles.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

@* La marca del piloto es una bandera sin nombre. Antes viajaba el nombre del ambiente y quedaba
   escrito en el HTML de cualquier ficha pública; el CSS sólo necesita saber si es piloto o no. *@
<body data-piloto="@(EsPiloto ? "1" : null)">
    @if (EsDev)
    {
        <div class="dev-environment-badge" role="status" aria-label="Entorno de pruebas DEV">
            DEV · Entorno de pruebas
        </div>
    }
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="/site-motion.js" defer></script>
    <script src="/pwa.js" defer></script>
    <script src="/push-notifications.js" defer></script>
    <script src="/order-recovery.js" defer></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Los formularios operativos no deben exponer un DOM prerenderizado mientras
    // WebAssembly descarga e hidrata. InteractiveServer entrega interactividad
    // inmediatamente después de conectar el circuito y evita descartar entradas.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    /// <summary>Los ambientes que no son la operación real de los negocios.</summary>
    private bool EsPiloto => Environment.IsEnvironment("Demo") || Environment.IsDevelopment();

    /// <summary>Marca explícita del DEV público; al faltar la variable, Production no cambia.</summary>
    private bool EsDev => Configuration.GetValue<bool>("EnvironmentMarker:Dev");
}
