# Solo desarrollo local. Copie como .env y cambie los valores. Nunca confirme .env en Git.
POSTGRES_DB=urabaconecta
POSTGRES_USER=urabaconecta
POSTGRES_PASSWORD=uraba_dev_only
POSTGRES_PORT=5433
APP_PORT=8088
ASPNETCORE_ENVIRONMENT=Demo
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=urabaconecta;Username=urabaconecta;Password=uraba_dev_only

# Use una clave aleatoria de 32 bytes o más. Nunca la confirme en Git.
URABACONECTA_TRACKING_HMAC_KEY=reemplazar-con-clave-aleatoria-de-desarrollo-de-32-bytes
# Clave independiente para los enlaces de invitación. Si falta, se reutiliza la anterior.
URABACONECTA_INVITATION_HMAC_KEY=

# Demo exige dos secretos distintos. Déjelos fuera de Git.
DEMO_SEED_ENABLED=true
DEMO_SEED_ADMIN_PASSWORD=
DEMO_SEED_BUSINESS_PASSWORD=

# Almacenamiento de imágenes. "Local" para desarrollo y Demo; "S3" para Cloudflare R2 en Production.
ObjectStorage__Provider=Local
ObjectStorage__LocalRootPath=/app/media
ObjectStorage__ServiceUrl=
ObjectStorage__Bucket=
ObjectStorage__AccessKey=
ObjectStorage__SecretKey=
ObjectStorage__PublicBaseUrl=
ObjectStorage__Region=auto

# Datos jurídicos reales del responsable del tratamiento. Obligatorios en Production:
# sin ellos la aplicación no arranca. No se inventan aquí.
Legal__ResponsibleName=
Legal__Identification=
Legal__Address=
Legal__PrivacyEmail=
Legal__SupportEmail=
Legal__PolicyVersion=
Legal__PolicyEffectiveDate=

# Persistencia de las llaves de Data Protection.
DataProtection__KeysPath=/app/keys
# Opcional: cifrado de las llaves en reposo con un certificado X.509 entregado en base64.
DataProtection__CertificateBase64=
DataProtection__CertificatePassword=

# Trazabilidad del despliegue, visible en la pantalla administrativa de salud.
Deployment__Commit=
Deployment__DeployedAtUtc=

# Migración de arranque. Por omisión true. Apagarlo no permite servir con el esquema atrasado:
# la readiness sigue exigiendo que no queden migraciones pendientes.
Database__MigrateOnStartup=true

# Alta de la única cuenta administrativa de Production. Sólo funciona con
# ASPNETCORE_ENVIRONMENT=Production, se ejecuta una sola vez y no crea socias.
# Retire las tres variables tras el primer inicio de sesión. Nunca las confirme en Git.
ProductionBootstrap__Enabled=false
ProductionBootstrap__AdminEmail=
ProductionBootstrap__AdminPassword=
