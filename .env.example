# Solo desarrollo local. Copie como .env y cambie los valores.
POSTGRES_DB=urabaconecta
POSTGRES_USER=urabaconecta
POSTGRES_PASSWORD=uraba_dev_only
POSTGRES_PORT=5433
APP_PORT=8088
ASPNETCORE_ENVIRONMENT=Demo
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=urabaconecta;Username=urabaconecta;Password=uraba_dev_only
# Use una clave aleatoria de 32 bytes o más. Nunca la confirme en Git.
URABACONECTA_TRACKING_HMAC_KEY=reemplazar-con-clave-aleatoria-de-desarrollo-de-32-bytes
# Demo exige dos secretos distintos. Déjelos fuera de Git.
DEMO_SEED_ENABLED=true
DEMO_SEED_ADMIN_PASSWORD=
DEMO_SEED_BUSINESS_PASSWORD=
